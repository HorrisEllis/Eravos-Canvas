# build output — regenerated from source, never committed (desktop/build.mjs, packaging/windows/make-exe.ps1)
dist/
node_modules
tests/out/
# null-render baselines (tests/null-render.mjs --record): recorded on your machine from the code before a refactor
tests/null-baseline/
# the desktop app run from this repo (electron desktop/) keeps your folders here, as the exe does beside ERAVOS.exe
/projects/
/exports/
/drop/
/packs/
/.appdata/

# her recordings (build/voice-bundle.mjs → voice/voice.js) — kept beside ERAVOS, never committed
/voice/

# ERAVOS host (host/): COS state + snapshots, the Glass ledger — your machine only
/.eravos/
