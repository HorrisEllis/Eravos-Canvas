# spec_id: eravos.organism.coach · version 1.0.0 · phase P8.5 (low priority) · status canonical
# source: v10 LEARN page + per-mode lessons
identity:
  id: eravos.coach ; label: Coach ; icon: 🧭 ; accent: "#ffffff"
  comp_intent: Short step-by-step lessons that happen ON the canvas — "make your first beat", "add Raven's voice to the drop" — checking each step really happened.
  novelty: Only organism that observes the bus to verify user progress; lessons are data, steps complete on real events.
engine:
  lesson: {id, title, steps:[{text, spawn?: recipe step, done_when: {topic, match}}]}
  verification: subscribes to declared topics only (kernel:organism-mounted, kernel:wire-registered, note:trigger, transport:play, ui:config_change:*) ; step complete when predicate matches
  can mount recipes (eravos.genomes-v10) on request ; never mutates organisms itself beyond spawning (K-3)
lessons (data/lessons.json): First Beat · Bassline in Key · Chop Raven's Voice · Build and Drop · Mix It Loud Enough · Export Your Song
config: lesson ; step ; showHints bool
hooks: observe_in (in ; event_bus ; topics above) ; spawn_out (out ; recipe:run {recipe_id})
ui: card with current step text, progress dots, 'show me' (highlights the target window via canvas focus), next/back
tests: 'First Beat' completes only after pads mounted + sequencer target set + transport:play observed ; lesson state serializes

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo]   # ui expansion when added: Audio engine · Transport · Tempo
  services:
    - audio: Audio engine — shares the audio clock
    - clock: Master clock & tempo — locks to the beat
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
  inputs:
    - coach.hook.observe_in (kernel:organism-mounted|kernel:wire-registered|note:trigger|transport:play|ui:config_change:*|asset:ready|edm:drop-fired|transport:bounce|master:loudness|ui:starter_load:*|ui:track_edit:*|ui:load:*|ui:record:*)
  outputs:
    - coach.hook.spawn_out (recipe:run|canvas:focus-request)
  permissions: [bus_publish, bus_subscribe, registry_read]
  works_with: []
