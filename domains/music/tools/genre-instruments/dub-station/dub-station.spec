# spec_id: eravos.organism.dub-station · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.dub-station ; label: Dub Station ; icon: 📢 ; accent: "#00c853" ; category: Genre instruments
  comp_intent: Reggae / dub / dancehall sound-system: offbeat skank, dub siren, air horn, spring, big-knob filter, dub echo, PULL UP rewind.
  engine_notes: |
    A sound-system in one window — reggae, dub, dancehall ("bun dem" energy):
    SKANK   offbeat chord chops locked to the transport (one-drop chop · organ bubble · dancehall stab) following a
    progression in the song key
    SIREN   the dub siren — hold to wail; rate, depth, shape, rising sweep
    HORN    synthesized air horn blasts
    DUB FX  wire any tool in: the BIG KNOB (resonant high-pass over the whole riddim), a SPRING tank (dispersive
    all-pass chirp + feedback combs), a DUB ECHO whose feedback runs through a sweepable resonant band-pass
    PULL UP the rewind: grabs the last seconds of the master, spins it backwards accelerating, stops the riddim and
    (optionally) drops it back in from bar 1 — the selector's "wheel up".
config:
  skankOn: boolean def false   # SKANK · Skank
  skankStyle: enum ["one-drop chop", "organ bubble", "dancehall stab"] def "one-drop chop"   # SKANK · Style
  prog: enum ["i–iv", "i–VII", "i–VI–VII", "I–IV–V", "i–v (minor dub)", "one chord"] def "i–iv"   # SKANK · Chords
  skankTone: number 400..8000 Hz def 2400   # SKANK · Tone
  skankLevel: number 0..1 def 0.5   # SKANK · Level
  sirenPitch: number 120..2000 Hz def 620   # SIREN · Pitch
  sirenRate: number 0.1..16 Hz def 3.2   # SIREN · Rate
  sirenDepth: number 0..24 st def 7   # SIREN · Depth
  sirenShape: enum ["sine", "square", "saw up", "saw down"] def "square"   # SIREN · Shape
  sirenRise: number -12..24 st def 5   # SIREN · Rise
  sirenLevel: number 0..1 def 0.35   # SIREN · Level
  hornLevel: number 0..1 def 0.45   # SIREN · Horn
  bigKnob: number 20..3000 Hz def 20   # DUB · Big knob
  spring: number 0..1 def 0.25   # DUB · Spring
  echo: number 0..1 def 0.3   # DUB · Echo send
  echoDiv: enum ["1/4", "1/8.", "3/16", "1/2", "1/8"] def "1/8."   # DUB · Echo time
  echoFeedback: number 0..1.08 def 0.62   # DUB · Feedback
  echoSweep: number 150..6000 Hz def 1400   # DUB · Sweep
  rewindLen: number 1..8 s def 3   # PULL UP · Rewind
  rewindRestart: boolean def true   # PULL UP · From the top
  level: number 0..1.5 def 0.8   # OUT · Level
presets: ["Bun Dem (dancehall)", "Roots One Drop", "Organ Bubble", "Tubby Echo Chamber", "Sound System Siren", "Steppers Dub"]
ui_hooks: [siren, horn, rewind, throw] + standard
tests: standard_tests + see tests/p14.test.js

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo, music.key, music.meter]   # ui expansion when added: Audio engine · Transport · Tempo · Song key · Master meter
  services:
    - audio: Audio engine — processes sound
    - clock: Master clock & tempo — locks to the beat
    - key: Song key & scale — plays in key
    - mod: 2 modulation inputs — LFO / XY / Macro can move them
  inputs:
    - dub.hook.audio_in (audio · port in)
    - dub.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
    - dub.hook.theory_in (theory:key-change) — ambient broadcast
    - dub.hook.mod_knob (modulation · port mod.bigKnob)
    - dub.hook.mod_sweep (modulation · port mod.echoSweep)
  outputs:
    - dub.hook.audio_out (audio · port out)
    - dub.hook.transport_out (ui:transport-stop|ui:transport-play|ui:transport-seek)
  permissions: [audio_out, audio_in, bus_publish, bus_subscribe]
  works_with: [eravos.drum-forge, eravos.sub-engine, eravos.pads, eravos.sequencer]
  notes:
    - Wire your riddim (drums, bass) into its input for the big knob, spring and echo.
    - Pull Up grabs the last seconds of everything you hear.
