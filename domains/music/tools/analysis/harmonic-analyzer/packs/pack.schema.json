{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.harmonic-analyzer/packs/pack.schema.json",
  "title": "Packs for Harmonic Analyzer — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.harmonic-analyzer",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.harmonic-analyzer": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "fft": {
                        "enum": [
                          4096,
                          8192,
                          16384,
                          32768
                        ]
                      },
                      "floor": {
                        "type": "number",
                        "minimum": -120,
                        "maximum": -20
                      },
                      "range": {
                        "type": "number",
                        "minimum": 20,
                        "maximum": 100
                      },
                      "maxPeaks": {
                        "type": "integer",
                        "minimum": 4,
                        "maximum": 48
                      },
                      "maxDen": {
                        "type": "integer",
                        "minimum": 4,
                        "maximum": 128
                      },
                      "smoothing": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.95
                      },
                      "layers": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4
                      },
                      "f0Mode": {
                        "enum": [
                          "auto",
                          "manual"
                        ]
                      },
                      "f0Manual": {
                        "type": "number",
                        "minimum": 16,
                        "maximum": 4000
                      },
                      "hold": {
                        "type": "boolean"
                      },
                      "source": {
                        "enum": [
                          "live",
                          "file"
                        ]
                      },
                      "sendTo": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
