{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.timeline/packs/pack.schema.json",
  "title": "Packs for Timeline — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.timeline",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.timeline": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "pxPerBar": {
                        "type": "number",
                        "minimum": 8,
                        "maximum": 400
                      },
                      "snap": {
                        "enum": [
                          "none",
                          "bar",
                          "beat",
                          "1/8",
                          "1/16"
                        ]
                      },
                      "loopOn": {
                        "type": "boolean"
                      },
                      "loopStartBar": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 512
                      },
                      "loopEndBar": {
                        "type": "number",
                        "minimum": 2,
                        "maximum": 513
                      },
                      "follow": {
                        "type": "boolean"
                      },
                      "laneH": {
                        "type": "integer",
                        "minimum": 28,
                        "maximum": 160
                      },
                      "songBars": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 512
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
