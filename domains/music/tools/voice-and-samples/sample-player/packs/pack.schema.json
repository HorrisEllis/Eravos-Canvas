{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.sample-player/packs/pack.schema.json",
  "title": "Packs for Sample — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.sample-player",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.sample-player": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "enum": [
                          "oneshot",
                          "gate",
                          "loop",
                          "chromatic",
                          "slice"
                        ]
                      },
                      "gain": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2
                      },
                      "pitch": {
                        "type": "number",
                        "minimum": -24,
                        "maximum": 24
                      },
                      "root": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 127
                      },
                      "reverse": {
                        "type": "boolean"
                      },
                      "start": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "end": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "loopStart": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "loopEnd": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "slices": {
                        "enum": [
                          "auto",
                          4,
                          8,
                          16,
                          "manual"
                        ]
                      },
                      "sensitivity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "attack": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2
                      },
                      "release": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 4
                      },
                      "xfade": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 200
                      },
                      "padLink": {
                        "enum": [
                          "off",
                          "bank A",
                          "bank B",
                          "bank C"
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
