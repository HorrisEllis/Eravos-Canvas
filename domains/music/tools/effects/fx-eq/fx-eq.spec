# spec_id: eravos.organism.fx-eq · version 1.0.0 · phase P8.1 · status canonical
# source: v10 plugins/eq.json (shell, F-19) · inherits STD.fx (mix fixed 1)
identity:
  id: eravos.fx-eq ; label: EQ ; icon: ⌒ ; accent: "#ffdd00"
  comp_intent: Surgical and tone EQ with a spectrum you can grab — fix mud, add air.
  novelty: Only organism with a draggable node EQ over a live spectrum and 'listen' (band solo) mode.
engine:
  bands: HPF (6/12/24/48 dB), low shelf, 3 × peaking, high shelf, LPF (6/12/24/48) — 7 nodes, each enable toggle
  listen: alt-drag on a band → temporary BP at that freq/Q, solo'd
  analyser: pre and post (fftSize 4096), displayed log-f 20 Hz–20 kHz
  auto-gain: optional output compensation = −(mean dB change over 100 Hz–10 kHz)
config: per band {on, freq, gain −18..18, Q 0.1..18, slope} ; autoGain bool ; outGain
presets: Vocal Clarity, Kick Tighten, Bass Mud Cut, Air Lift, Telephone
hooks: STD.fx (no mix) ; mod_band<n>_freq STD.mod_in (peaking bands)
ui: hero = spectrum (pre faint, post bright) + composite curve ; numbered draggable nodes (x freq, y gain, wheel Q) ; band table
tests: STD.fx ; peak +6 dB @1 kHz Q 1 → +6 ± 0.1 dB measured ; HPF 48 dB @100 Hz → −48 ± 3 dB @50 Hz ; listen mode restores on release

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.meter]   # ui expansion when added: Audio engine · Master meter
  services:
    - audio: Audio engine — processes sound
    - mod: 4 modulation inputs — LFO / XY / Macro can move them
  inputs:
    - fx.hook.audio_in (audio · port in)
    - fx.hook.mod_mix (modulation · port mod.mix)
    - eq.hook.mod_band1_freq (modulation · port mod.p1Freq)
    - eq.hook.mod_band2_freq (modulation · port mod.p2Freq)
    - eq.hook.mod_band3_freq (modulation · port mod.p3Freq)
  outputs:
    - fx.hook.audio_out (audio · port out)
  permissions: [audio_out, audio_in, bus_publish, bus_subscribe]
  works_with: []
