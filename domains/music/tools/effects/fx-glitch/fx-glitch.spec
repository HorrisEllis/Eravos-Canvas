# spec_id: eravos.organism.fx-glitch · version 1.0.0 · phase P8.1 · status canonical
# source: v10 plugins/glitch.json "SIGNAL TERRORIST" (shell, F-19) · inherits STD.fx
identity:
  id: eravos.fx-glitch ; label: Glitch ; icon: ⌗ ; accent: "#ff0044"
  comp_intent: Beat-repeat, stutter, reverse and tape-stop that land on the grid — drops that break physics.
  novelty: Only FX that captures audio into a rolling buffer and re-plays slices scheduled to transport ticks.
engine:
  capture: AudioWorklet ring buffer (4 bars at current BPM, max 16 s) tagged with AC frame index
  events (each quantized to next tick): repeat(div, count) · reverse(div) · tapeStop(length) · halfSpeed(bars) · scatter (random slice from last bar)
  auto mode: per bar, probability 'chaos' picks an event on steps chosen by 'rate'
  manual: 6 hold-pads (momentary) — event lasts while held, quantized in/out
  output crossfades 3 ms at every splice
config: rate enum [1/4,1/8,1/16,1/32] def 1/16 ; chaos 0..1 def 0 ; size (repeat length) div ; reverseProb/stopProb/scatterProb 0..1 ; pitchDrift −12..12 st ; STD mix
presets: Stutter 1/16, Build Roll, Tape Stop Drop, Reverse Tails, Chaos 50
hooks: STD.fx ; STD.transport_in ; glitch.hook.event_in (in ; event_bus ; fx:glitch {target, event, div}) — drop builder / macro can fire events
ui: hero = captured buffer strip with slice highlights as they replay ; 6 hold-pads (REPEAT 1/8, 1/16, 1/32, REVERSE, STOP, SCATTER) ; chaos knob
tests: STD.fx ; repeat 1/16 × 4 → output equals 4 copies of the captured 1/16 ± 3 ms crossfade ; tapeStop pitch falls monotonically to 0 over length ; splices < −40 dB click energy

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo, music.meter]   # ui expansion when added: Audio engine · Transport · Tempo · Master meter
  services:
    - audio: Audio engine — processes sound
    - clock: Master clock & tempo — locks to the beat
    - mod: 1 modulation input — LFO / XY / Macro can move them
  inputs:
    - fx.hook.audio_in (audio · port in)
    - fx.hook.mod_mix (modulation · port mod.mix)
    - glitch.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
    - glitch.hook.event_in (fx:glitch)
  outputs:
    - fx.hook.audio_out (audio · port out)
  permissions: [audio_out, audio_in, bus_publish, bus_subscribe]
  works_with: []
