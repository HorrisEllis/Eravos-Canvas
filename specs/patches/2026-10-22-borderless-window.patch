diff --git a/tests/frameless.mjs b/tests/frameless.mjs
new file mode 100644
index 0000000..2a890d8
--- /dev/null
+++ b/tests/frameless.mjs
@@ -0,0 +1,35 @@
+// node tests/frameless.mjs — the borderless ERAVOS.exe window, page side (2026-10-22, his call: "can you make it borderless windowed?").
+// The canvas runs with a stand-in for the app's preload (window.eravosDesktop) that records what the page asks for. It checks: the
+// top bar is the drag region, its buttons are not, − ▢ ✕ are there and send min / max / close, and ▢ becomes ❐ when maximized.
+// What it cannot check here: Electron itself (frame:false, the IPC in desktop/main.js). Run ERAVOS.exe for that.
+import path from 'path'; import { fileURLToPath } from 'url';
+import { chromium } from '../host/driver/glass.js';
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..'), OUT = process.argv[2];
+const b = await chromium.launch(), p = await b.newPage({ viewport: { width: 1500, height: 800 } }), errs = [];
+p.on('pageerror', e => errs.push(e.message));
+await p.addInitScript(() => {
+  window.__win = []; let st = null;
+  window.eravosDesktop = { info: async () => ({ desktop: true }), ready() {}, onFile() {}, onPacks(cb) { setTimeout(() => cb([]), 10); }, packsDone() {}, fileDone() {}, onSaved() {}, keepPack: async () => ({}), openLibrary() {},
+    window: { min: () => window.__win.push('min'), max: () => { window.__win.push('max'); st && st({ maximized: true }); }, close: () => window.__win.push('close'), onState: (cb) => { st = cb; cb({ maximized: false }); } } };
+});
+let pass = 0, fail = 0; const ok = (c, m) => { if (c) { pass++; console.log('  ✓ ' + m); } else { fail++; console.log('  ✗ ' + m); } };
+await p.goto('file://' + ROOT + '/canvas/index.html');
+await p.waitForFunction(() => document.querySelector('#topbar .win-ctl'), null, { timeout: 20000 });
+const r = await p.evaluate(() => {
+  const css = (el) => getComputedStyle(el).webkitAppRegion || getComputedStyle(el).getPropertyValue('-webkit-app-region');
+  const bar = document.getElementById('topbar'), ctl = document.querySelector('.win-ctl'), btns = Array.from(ctl.querySelectorAll('.win-btn'));
+  const out = { frameless: document.body.classList.contains('frameless'), bar: css(bar), add: css(document.getElementById('addBtn')), ctl: css(ctl), labels: btns.map(x => x.textContent), right: Math.round(window.innerWidth - ctl.getBoundingClientRect().right), top: Math.round(ctl.getBoundingClientRect().top) };
+  const r1 = btns[2].getBoundingClientRect(), top = document.elementFromPoint(r1.left + r1.width / 2, r1.top + r1.height / 2);
+  out.onTop = top === btns[2] || btns[2].contains(top);
+  btns[1].click(); out.afterMax = btns[1].textContent; btns[0].click(); btns[2].click(); out.calls = window.__win.slice(); return out;
+});
+ok(r.frameless, 'the page knows it is borderless');
+ok(r.bar === 'drag', 'the top bar is the title bar (drag region): ' + r.bar);
+ok(r.add === 'no-drag' && r.ctl === 'no-drag', 'its buttons and the window controls stay clickable');
+ok(JSON.stringify(r.labels) === JSON.stringify(['−', '▢', '✕']) && r.right === 0 && r.top === 0, '− ▢ ✕ at the top right, on the bar');
+ok(JSON.stringify(r.calls) === JSON.stringify(['max', 'min', 'close']), 'they send max, min, close: ' + r.calls.join(','));
+ok(r.onTop, '✕ is on top even under the start screen (the window can always be closed)');
+ok(r.afterMax === '❐', 'maximized: ▢ becomes ❐ (restore)');
+ok(!errs.length, 'no page errors ' + errs.join(' | '));
+if (OUT) await p.screenshot({ path: OUT });
+await b.close(); console.log(`\n${pass}/${pass + fail} passed, ${fail} failed`); process.exitCode = fail ? 1 : 0;
