# spec_id: eravos.dependency-map · generated by build/specs.mjs — the whole tool map, always current
# rule: every new tool appears here automatically; its UI expansion is derived from its hooks (domains/music/domain.js resolveNeeds)

units:
  music.engine: Audio engine — sound output, master bus and the clock every tool shares
  music.transport: Transport — play / stop, record, position, loop, metronome · Space plays
  music.tempo: Tempo — BPM + tap tempo
  music.key: Song key — the key and scale tools follow
  music.meter: Master meter — output level, right of the toolbar
  music.dock: Song Recorder — record the song along the bottom, edit takes, export every format
  music.midi: MIDI button — your pad controller: status light, one click opens the MIDI Map
  music.studio: Songs · Sounds · Learn — Songbook, Sounds (presets, kit packs, capture to pad) and Learn — pages of their own, off the canvas

modes:
  music: Music Production → units [music.engine, music.transport, music.tempo, music.key, music.meter, music.dock, music.midi, music.studio] · shows [Start here, Sound sources, Genre instruments, Sound Forge, Voice & samples, Drums & rhythm, Arrange, Effects, Mix, Modulation, Generators, Tools]
  music.lab: Lab → units [music.engine, music.meter, music.dock] · shows [Xenharmonic, Analysis, Effects, Modulation]

tools:
  Analysis:
    - eravos.harmonic-analyzer (Harmonic Analyzer) mode=music.lab units=[engine] needs=[audio,files] in=2 out=2
  Arrange:
    - eravos.timeline (Timeline) mode=music units=[engine,transport,tempo,meter] needs=[audio,clock,files] in=2 out=8
    - eravos.bass-drop-builder (Drop Builder) mode=music units=[engine,transport,tempo,key,meter] needs=[audio,clock,key,files] in=2 out=6
    - eravos.song-recorder (Song Recorder) mode=music units=[engine,transport,tempo,meter] needs=[audio,clock,files,assets] in=1 out=4
  Drums & rhythm:
    - eravos.pads (Drum Machine) mode=music units=[engine,meter,midi] needs=[audio,midi,mod,notes,files] in=3 out=3
    - eravos.sequencer (Sequencer) mode=music units=[engine,transport,tempo,key] needs=[audio,clock,key,notes,files] in=4 out=4
  Effects:
    - eravos.fx-echo (Tape Echo) mode=music units=[engine,meter] needs=[audio,mod] in=5 out=1
    - eravos.fx-filter (Filter) mode=music units=[engine,meter] needs=[audio,mod] in=4 out=1
    - eravos.fx-moddelay (Mod Delay) mode=music units=[engine,meter] needs=[audio,mod] in=4 out=1
    - eravos.fx-destroyer (Destroyer) mode=music units=[engine,meter] needs=[audio,mod] in=5 out=1
    - eravos.fx-phaser (Phaser) mode=music units=[engine,meter] needs=[audio,mod] in=4 out=1
    - eravos.fx-haunt (Haunt) mode=music units=[engine,meter] needs=[audio,mod] in=4 out=1
    - eravos.fx-eq (EQ) mode=music units=[engine,meter] needs=[audio,mod] in=5 out=1
    - eravos.fx-dynamics (Dynamics) mode=music units=[engine,meter] needs=[audio,mod] in=3 out=2
    - eravos.fx-glitch (Glitch) mode=music units=[engine,transport,tempo,meter] needs=[audio,clock,mod] in=3 out=1
    - eravos.fx-pitch (Pitch) mode=music units=[engine,key,meter] needs=[audio,key,mod] in=3 out=1
  Generators:
    - eravos.edm-lab (EDM Lab) mode=music units=[engine,transport,tempo,key,meter] needs=[audio,clock,key,mod] in=2 out=5
  Genre instruments:
    - eravos.dub-station (Dub Station) mode=music units=[engine,transport,tempo,key,meter] needs=[audio,clock,key,mod] in=3 out=2
    - eravos.organ (Gothic Organ) mode=music units=[engine,transport,tempo,key,meter,midi] needs=[audio,clock,key,midi,mod,notes] in=2 out=1
    - eravos.retro-poly (Retro Poly) mode=music units=[engine,transport,tempo,key,meter,midi] needs=[audio,clock,key,midi,mod,notes] in=3 out=1
    - eravos.coven (Coven) mode=music units=[engine,transport,tempo,key,meter,midi] needs=[audio,clock,key,midi,mod,notes] in=2 out=1
  Mix:
    - eravos.channel (Channel) mode=music units=[engine,meter] needs=[audio,mod] in=4 out=2
    - eravos.sidechain-compressor (Sidechain) mode=music units=[engine,transport,tempo,meter] needs=[audio,clock,notes] in=2 out=2
    - eravos.master-fx (Master) mode=music units=[engine,transport,tempo] needs=[audio,clock,mod] in=3 out=1
  Modulation:
    - eravos.lfo (LFO) mode=music units=[engine,transport,tempo] needs=[audio,clock,mod] in=1 out=1
    - eravos.xy-pad (XY Pad) mode=music units=[engine,transport,tempo] needs=[audio,clock] in=0 out=2
    - eravos.macro-automation (Automation) mode=music units=[engine,transport,tempo] needs=[audio,clock] in=1 out=9
    - eravos.breath (Breath) mode=music.lab units=[engine,key,meter] needs=[audio,key] in=0 out=3
  Sound Forge:
    - eravos.drum-forge (Drum Forge) mode=music units=[engine,meter,midi] needs=[audio,midi,notes,assets] in=1 out=4
    - eravos.bass-forge (Bass Forge) mode=music units=[engine,transport,tempo,key,meter,midi] needs=[audio,clock,key,midi,mod,notes,files] in=3 out=1
    - eravos.fx-box (FX Box) mode=music units=[engine,transport,tempo,meter,midi] needs=[audio,clock,midi,notes] in=1 out=2
  Sound sources:
    - eravos.wobble-bass (Wobble Bass) mode=music units=[engine,transport,tempo,key,meter,midi] needs=[audio,clock,key,midi,mod,notes] in=4 out=1
    - eravos.acid-synth (Acid Synth) mode=music units=[engine,key,meter,midi] needs=[audio,key,midi,mod,notes] in=3 out=2
    - eravos.reese-bass (Reese Bass) mode=music units=[engine,transport,tempo,meter,midi] needs=[audio,clock,midi,mod,notes] in=4 out=1
    - eravos.supersaw (Supersaw) mode=music units=[engine,key,meter,midi] needs=[audio,key,midi,mod,notes] in=3 out=1
    - eravos.sub-engine (Deep Sub) mode=music units=[engine,key,meter,midi] needs=[audio,key,midi,mod,notes] in=3 out=1
    - eravos.pad-forge (Pad Forge) mode=music units=[engine,key,meter,midi] needs=[audio,key,midi,mod,notes] in=4 out=1
    - eravos.curve-synth (Curve) mode=music units=[engine,meter,midi] needs=[audio,midi,notes] in=1 out=1
  Start here:
    - eravos.session (Session) mode=music units=[engine,tempo,key] needs=[audio,clock,key,files,assets] in=1 out=3
    - eravos.coach (Coach) mode=music units=[engine,transport,tempo] needs=[audio,clock,notes] in=1 out=1
  Tools:
    - eravos.contrast-analyser (Contrast) mode=music units=[engine] needs=[audio,files] in=3 out=1
    - eravos.midi-mapper (MIDI Map) mode=music units=[engine,midi] needs=[audio,midi] in=1 out=4
  Voice & samples:
    - eravos.sample-player (Sample) mode=music units=[engine,meter,midi] needs=[audio,midi,mod,notes,files,assets] in=5 out=2
    - eravos.clip-maker (Clip Maker) mode=music units=[engine,transport,tempo,meter] needs=[audio,clock,files,assets] in=1 out=2
    - eravos.lyric-rhythm (Lyrics → Rhythm) mode=music units=[engine,transport,tempo,key] needs=[audio,clock,key] in=0 out=2
  Xenharmonic:
    - eravos.xen-synth (Xen Synth) mode=music.lab units=[engine,meter,midi] needs=[audio,midi,mod,notes] in=4 out=1
    - eravos.ratio-lattice (Ratio Lattice) mode=music.lab units=[engine,transport,tempo,meter] needs=[audio,clock] in=0 out=3
    - eravos.recursive-spectra (Recursive Spectra) mode=music.lab units=[engine,transport,tempo,meter,midi] needs=[audio,clock,midi,mod,notes] in=3 out=3
    - eravos.embodiment-lab (Embodiment Lab) mode=music.lab units=[engine,transport,tempo,meter] needs=[audio,clock,mod,notes] in=2 out=3
