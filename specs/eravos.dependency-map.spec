# spec_id: eravos.dependency-map · generated by build/specs.mjs — the whole tool map, always current
# rule: every new tool appears here automatically; its UI expansion is derived from its hooks (tools/music/domain.js resolveNeeds)

units:
  music.engine: Audio engine — sound output, master bus and the clock every tool shares
  music.transport: Transport — play / stop, record, position, loop, metronome · Space plays
  music.tempo: Tempo — BPM + tap tempo
  music.key: Song key — the key and scale tools follow
  music.meter: Master meter — output level, right of the toolbar
  music.dock: Song Recorder — record the song along the bottom, edit takes, export every format
  music.midi: MIDI button — your pad controller: status light, one click opens the MIDI Map
  music.studio: Songs · Sounds · Learn — Songbook, Sounds (presets, kit packs, capture to pad) and Learn — pages of their own, off the canvas

modes:
  music: Music Production → units [music.engine, music.transport, music.tempo, music.key, music.meter, music.dock, music.midi, music.studio] · shows [Start here, Sound sources, Wubs, Genre instruments, Sound Forge, Voice & samples, Drums & rhythm, Arrange, Effects, Mix, Modulation, Generators, Tools]
  music.lab: Lab → units [music.engine, music.meter, music.dock] · shows [Xenharmonic, Analysis, Effects, Modulation]
  video: Video Editing → units [] · shows [Video, Image]
  image: Image Manipulation → units [] · shows [Image]
  agents: AI Automation → units [] · shows [AI, Code]
  coding: Coding Environment → units [] · shows [Code]

tools:
