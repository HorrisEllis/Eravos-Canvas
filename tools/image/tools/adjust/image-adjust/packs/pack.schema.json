{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.image.image-adjust/packs/pack.schema.json",
  "title": "Packs for Image Adjust — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.image.image-adjust",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.image.image-adjust": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "exposure": {
                        "type": "number",
                        "minimum": -4,
                        "maximum": 4
                      },
                      "contrast": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "highlights": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "shadows": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "blackPoint": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.5
                      },
                      "whitePoint": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 1
                      },
                      "gamma": {
                        "type": "number",
                        "minimum": 0.3,
                        "maximum": 3
                      },
                      "temperature": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "tint": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "saturation": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "vibrance": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "vignette": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "rotate": {
                        "enum": [
                          0,
                          90,
                          180,
                          270
                        ]
                      },
                      "flipH": {
                        "type": "boolean"
                      },
                      "aspect": {
                        "enum": [
                          "free",
                          "1:1",
                          "4:5",
                          "3:2",
                          "16:9",
                          "9:16"
                        ]
                      },
                      "format": {
                        "enum": [
                          "png",
                          "jpeg",
                          "webp"
                        ]
                      },
                      "quality": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
