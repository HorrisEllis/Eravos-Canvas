{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.agents.ai-step/packs/pack.schema.json",
  "title": "Packs for AI Step — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.agents.ai-step",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.agents.ai-step": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "enum": [
                          "anthropic",
                          "openai-compatible",
                          "echo"
                        ]
                      },
                      "model": {
                        "type": "string"
                      },
                      "endpoint": {
                        "type": "string"
                      },
                      "temperature": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "maxTokens": {
                        "type": "integer",
                        "minimum": 16,
                        "maximum": 16000
                      },
                      "output": {
                        "enum": [
                          "text",
                          "json"
                        ]
                      },
                      "requiredKeys": {
                        "type": "string"
                      },
                      "auto": {
                        "type": "boolean"
                      },
                      "timeout": {
                        "type": "number",
                        "minimum": 5,
                        "maximum": 600
                      },
                      "retries": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
