{
 "schema": "eravos.component-contract/1",
 "id": "filter-ladder",
 "version": "1.0.0",
 "domain": "music",
 "kind": "audio",
 "kernel": "MusicParts.Ladder",
 "worklet": "eravos-ladder",
 "variables_from": "LADDER_PARAMS",
 "ports": [
  {
   "id": "in",
   "dir": "in",
   "type": "audio",
   "channels": 2,
   "rate": "audio"
  },
  {
   "id": "out",
   "dir": "out",
   "type": "audio",
   "channels": 2,
   "rate": "audio"
  }
 ],
 "variables": [
  {
   "key": "frequency",
   "type": "number",
   "min": 16,
   "max": 20000,
   "default": 1000,
   "audio_param": true,
   "rate": "audio",
   "role": "tone",
   "unit": "Hz"
  },
  {
   "key": "detune",
   "type": "number",
   "min": -9600,
   "max": 9600,
   "default": 0,
   "audio_param": true,
   "rate": "audio",
   "role": "pitch",
   "unit": "cents"
  },
  {
   "key": "resonance",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0,
   "audio_param": true,
   "rate": "audio",
   "role": "tone"
  },
  {
   "key": "drive",
   "type": "number",
   "min": 0,
   "max": 36,
   "default": 0,
   "audio_param": true,
   "rate": "audio",
   "role": "drive",
   "unit": "dB"
  },
  {
   "key": "bass",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0,
   "audio_param": true,
   "rate": "audio",
   "role": "tone"
  },
  {
   "key": "mode",
   "type": "enum",
   "min": 0,
   "max": 4,
   "default": "lowpass 24",
   "audio_param": true,
   "rate": "block",
   "options": [
    "lowpass 24",
    "lowpass 12",
    "bandpass 12",
    "highpass 12",
    "highpass 24"
   ],
   "role": "mode"
  }
 ],
 "element": {
  "version": 1,
  "controls": [
   {
    "key": "frequency",
    "role": "tone",
    "face": true
   },
   {
    "key": "detune",
    "role": "pitch",
    "face": false
   },
   {
    "key": "resonance",
    "role": "tone",
    "face": true
   },
   {
    "key": "drive",
    "role": "drive",
    "face": true
   },
   {
    "key": "bass",
    "role": "tone",
    "face": false
   },
   {
    "key": "mode",
    "role": "mode",
    "face": false
   }
  ],
  "needs_ui": [
   "kit.knob",
   "kit.segmented"
  ]
 }
}
