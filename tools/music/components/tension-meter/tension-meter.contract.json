{
 "schema": "eravos.component-contract/1",
 "id": "tension-meter",
 "version": "1.0.0",
 "domain": "music",
 "kind": "audio",
 "kernel": "MusicParts.TensionMeter",
 "ports": [
  {
   "id": "in",
   "dir": "in",
   "type": "audio",
   "rate": "audio"
  },
  {
   "id": "tension",
   "dir": "out",
   "type": "control",
   "range": [
    0,
    1
   ],
   "rate": "block"
  }
 ],
 "variables": [
  {
   "key": "wLoud",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 1,
   "role": "level"
  },
  {
   "key": "wBright",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 1,
   "role": "tone"
  },
  {
   "key": "wDense",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 1,
   "role": "rate"
  },
  {
   "key": "wMotion",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 1,
   "role": "rate"
  }
 ],
 "element": {
  "version": 1,
  "controls": [
   {
    "key": "wLoud",
    "role": "level",
    "face": true
   },
   {
    "key": "wBright",
    "role": "tone",
    "face": true
   },
   {
    "key": "wDense",
    "role": "rate",
    "face": true
   },
   {
    "key": "wMotion",
    "role": "rate",
    "face": true
   }
  ],
  "needs_ui": [
   "kit.knob"
  ]
 }
}
