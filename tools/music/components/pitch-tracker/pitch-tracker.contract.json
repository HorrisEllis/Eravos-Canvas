{
 "schema": "eravos.component-contract/1",
 "id": "pitch-tracker",
 "version": "1.0.0",
 "domain": "music",
 "kind": "analysis",
 "kernel": "MusicParts.PitchTracker",
 "ports": [
  {
   "id": "in",
   "dir": "in",
   "type": "audio",
   "rate": "audio"
  },
  {
   "id": "pitch",
   "dir": "out",
   "type": "pitch",
   "rate": "block"
  },
  {
   "id": "confidence",
   "dir": "out",
   "type": "control",
   "range": [
    0,
    1
   ],
   "rate": "block"
  }
 ],
 "variables": [
  {
   "key": "min",
   "type": "number",
   "min": 20,
   "max": 1000,
   "default": 50,
   "role": "pitch",
   "unit": "Hz"
  },
  {
   "key": "max",
   "type": "number",
   "min": 100,
   "max": 4000,
   "default": 1500,
   "role": "pitch",
   "unit": "Hz"
  },
  {
   "key": "threshold",
   "type": "number",
   "min": 0.01,
   "max": 0.5,
   "default": 0.15,
   "role": "depth"
  },
  {
   "key": "gate",
   "type": "number",
   "min": -120,
   "max": 0,
   "default": -50,
   "role": "level",
   "unit": "dB"
  }
 ],
 "element": {
  "version": 1,
  "controls": [
   {
    "key": "min",
    "role": "pitch",
    "face": true
   },
   {
    "key": "max",
    "role": "pitch",
    "face": true
   },
   {
    "key": "threshold",
    "role": "depth",
    "face": false
   },
   {
    "key": "gate",
    "role": "level",
    "face": false
   }
  ],
  "needs_ui": [
   "kit.knob"
  ]
 }
}
