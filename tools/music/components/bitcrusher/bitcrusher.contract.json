{
 "schema": "eravos.component-contract/1",
 "id": "bitcrusher",
 "version": "1.0.0",
 "domain": "music",
 "kind": "audio",
 "kernel": "MusicParts.Crusher",
 "worklet": "eravos-bitcrusher",
 "variables_from": "CRUSHER_PARAMS",
 "ports": [
  {
   "id": "in",
   "dir": "in",
   "type": "audio",
   "channels": 2,
   "rate": "audio"
  },
  {
   "id": "out",
   "dir": "out",
   "type": "audio",
   "channels": 2,
   "rate": "audio"
  }
 ],
 "variables": [
  {
   "key": "bits",
   "type": "number",
   "min": 1,
   "max": 24,
   "default": 24,
   "audio_param": true,
   "rate": "audio",
   "role": "colour",
   "integer": true
  },
  {
   "key": "rate",
   "type": "number",
   "min": 200,
   "max": 192000,
   "default": 48000,
   "audio_param": true,
   "rate": "audio",
   "role": "tone",
   "unit": "Hz"
  },
  {
   "key": "aa",
   "type": "boolean",
   "min": 0,
   "max": 1,
   "default": false,
   "audio_param": true,
   "rate": "block",
   "role": "mode"
  },
  {
   "key": "jitter",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0,
   "audio_param": true,
   "rate": "block",
   "role": "colour"
  },
  {
   "key": "dither",
   "type": "boolean",
   "min": 0,
   "max": 1,
   "default": false,
   "audio_param": true,
   "rate": "block",
   "role": "mode"
  },
  {
   "key": "mix",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 1,
   "audio_param": true,
   "rate": "audio",
   "role": "mix"
  }
 ],
 "element": {
  "version": 1,
  "controls": [
   {
    "key": "bits",
    "role": "colour",
    "face": true
   },
   {
    "key": "rate",
    "role": "tone",
    "face": true
   },
   {
    "key": "aa",
    "role": "mode",
    "face": false
   },
   {
    "key": "jitter",
    "role": "colour",
    "face": false
   },
   {
    "key": "dither",
    "role": "mode",
    "face": false
   },
   {
    "key": "mix",
    "role": "mix",
    "face": true
   }
  ],
  "needs_ui": [
   "kit.knob",
   "kit.toggle"
  ]
 }
}
