{
 "schema": "eravos.component-contract/1",
 "id": "random-source",
 "version": "1.0.0",
 "domain": "music",
 "kind": "audio",
 "kernel": "MusicParts.Random",
 "worklet": "eravos-random",
 "variables_from": "RANDOM_PARAMS",
 "ports": [
  {
   "id": "value",
   "dir": "out",
   "type": "control",
   "range": [
    -1,
    1
   ],
   "rate": "audio",
   "channel": 0
  },
  {
   "id": "events",
   "dir": "out",
   "type": "gate",
   "rate": "audio",
   "channel": 1
  }
 ],
 "variables": [
  {
   "key": "rate",
   "type": "number",
   "min": 0.01,
   "max": 200,
   "default": 4,
   "audio_param": true,
   "rate": "audio",
   "role": "rate",
   "unit": "Hz"
  },
  {
   "key": "smooth",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0,
   "audio_param": true,
   "rate": "audio",
   "role": "shape"
  },
  {
   "key": "dist",
   "type": "enum",
   "min": 0,
   "max": 3,
   "default": "uniform",
   "audio_param": true,
   "rate": "block",
   "options": [
    "uniform",
    "gaussian",
    "beta",
    "histogram"
   ],
   "role": "mode"
  },
  {
   "key": "a",
   "type": "number",
   "min": 0.1,
   "max": 20,
   "default": 2,
   "audio_param": true,
   "rate": "block",
   "role": "shape"
  },
  {
   "key": "b",
   "type": "number",
   "min": 0.1,
   "max": 20,
   "default": 2,
   "audio_param": true,
   "rate": "block",
   "role": "shape"
  },
  {
   "key": "seed",
   "type": "number",
   "min": 1,
   "max": 2147483647,
   "default": 1,
   "audio_param": true,
   "rate": "block",
   "role": "seed",
   "integer": true
  },
  {
   "key": "depth",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 1,
   "audio_param": true,
   "rate": "audio",
   "role": "depth"
  },
  {
   "key": "offset",
   "type": "number",
   "min": -1,
   "max": 1,
   "default": 0,
   "audio_param": true,
   "rate": "audio",
   "role": "level"
  },
  {
   "key": "unipolar",
   "type": "boolean",
   "min": 0,
   "max": 1,
   "default": false,
   "audio_param": true,
   "rate": "block",
   "role": "mode"
  },
  {
   "key": "density",
   "type": "number",
   "min": 0,
   "max": 200,
   "default": 0,
   "audio_param": true,
   "rate": "audio",
   "role": "rate",
   "unit": "per second"
  },
  {
   "key": "eventLen",
   "type": "number",
   "min": 0.0005,
   "max": 2,
   "default": 0.002,
   "audio_param": true,
   "rate": "audio",
   "role": "time",
   "unit": "s"
  }
 ],
 "element": {
  "version": 1,
  "controls": [
   {
    "key": "rate",
    "role": "rate",
    "face": true
   },
   {
    "key": "smooth",
    "role": "shape",
    "face": true
   },
   {
    "key": "dist",
    "role": "mode",
    "face": false
   },
   {
    "key": "a",
    "role": "shape",
    "face": false
   },
   {
    "key": "b",
    "role": "shape",
    "face": false
   },
   {
    "key": "seed",
    "role": "seed",
    "face": false
   },
   {
    "key": "depth",
    "role": "depth",
    "face": true
   },
   {
    "key": "offset",
    "role": "level",
    "face": false
   },
   {
    "key": "unipolar",
    "role": "mode",
    "face": false
   },
   {
    "key": "density",
    "role": "rate",
    "face": false
   },
   {
    "key": "eventLen",
    "role": "time",
    "face": false
   }
  ],
  "needs_ui": [
   "kit.knob",
   "kit.segmented",
   "kit.toggle"
  ]
 }
}
