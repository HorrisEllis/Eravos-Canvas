{
 "schema": "eravos.component-contract/1",
 "id": "envelope-follower",
 "version": "1.0.0",
 "domain": "music",
 "kind": "audio",
 "kernel": "MusicParts.Follower",
 "ports": [
  {
   "id": "in",
   "dir": "in",
   "type": "audio",
   "rate": "audio"
  },
  {
   "id": "out",
   "dir": "out",
   "type": "control",
   "range": [
    0,
    1
   ],
   "rate": "audio"
  }
 ],
 "variables": [
  {
   "key": "attack",
   "type": "number",
   "min": 0.1,
   "max": 500,
   "default": 1,
   "role": "time",
   "unit": "ms"
  },
  {
   "key": "release",
   "type": "number",
   "min": 1,
   "max": 3000,
   "default": 300,
   "role": "time",
   "unit": "ms"
  },
  {
   "key": "hold",
   "type": "number",
   "min": 0,
   "max": 500,
   "default": 0,
   "role": "time",
   "unit": "ms"
  },
  {
   "key": "mode",
   "type": "enum",
   "options": [
    "peak",
    "rms"
   ],
   "default": "peak",
   "role": "mode"
  },
  {
   "key": "floor",
   "type": "number",
   "min": -90,
   "max": -6,
   "default": -48,
   "role": "level",
   "unit": "dB"
  }
 ],
 "element": {
  "version": 1,
  "controls": [
   {
    "key": "attack",
    "role": "time",
    "face": true
   },
   {
    "key": "release",
    "role": "time",
    "face": true
   },
   {
    "key": "hold",
    "role": "time",
    "face": false
   },
   {
    "key": "mode",
    "role": "mode",
    "face": false
   },
   {
    "key": "floor",
    "role": "level",
    "face": false
   }
  ],
  "needs_ui": [
   "kit.knob",
   "kit.segmented"
  ]
 }
}
