{
 "schema": "eravos.component-contract/1",
 "id": "oscillator-population",
 "version": "1.1.0",
 "domain": "music",
 "kind": "audio",
 "kernel": "MusicParts.POP",
 "ports": [
  {
   "id": "pitch",
   "dir": "in",
   "type": "pitch",
   "unit": "Hz",
   "rate": "audio"
  },
  {
   "id": "phases",
   "dir": "out",
   "type": "data",
   "rate": "audio",
   "about": "each voice’s phase — rendered through osc-va or osc-wavetable"
  },
  {
   "id": "coherence",
   "dir": "out",
   "type": "control",
   "range": [
    0,
    1
   ],
   "rate": "audio",
   "about": "R: 1 all in phase"
  }
 ],
 "variables": [
  {
   "key": "voices",
   "type": "number",
   "min": 1,
   "max": 32,
   "default": 8,
   "role": "voice",
   "integer": true,
   "code": "max"
  },
  {
   "key": "spread",
   "type": "number",
   "min": 0,
   "max": 100,
   "default": 20,
   "role": "pitch",
   "unit": "cents",
   "code": "spreadCents"
  },
  {
   "key": "coupling",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0.5,
   "role": "depth"
  },
  {
   "key": "mode",
   "type": "enum",
   "options": [
    "free",
    "coupled",
    "harmonic",
    "chaotic"
   ],
   "default": "coupled",
   "from": "POP_MODES",
   "role": "mode"
  },
  {
   "key": "pull",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0,
   "role": "depth"
  },
  {
   "key": "drift",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0,
   "role": "colour"
  },
  {
   "key": "cluster",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0,
   "role": "shape"
  },
  {
   "key": "restless",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0,
   "role": "colour"
  },
  {
   "key": "form",
   "type": "number",
   "min": 0,
   "max": 10,
   "default": 0,
   "role": "time",
   "unit": "s"
  },
  {
   "key": "fm",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0,
   "role": "colour"
  }
 ],
 "element": {
  "version": 1,
  "controls": [
   {
    "key": "voices",
    "role": "voice",
    "face": false
   },
   {
    "key": "spread",
    "role": "pitch",
    "face": true
   },
   {
    "key": "coupling",
    "role": "depth",
    "face": true
   },
   {
    "key": "mode",
    "role": "mode",
    "face": true
   },
   {
    "key": "pull",
    "role": "depth",
    "face": false
   },
   {
    "key": "drift",
    "role": "colour",
    "face": false
   },
   {
    "key": "cluster",
    "role": "shape",
    "face": false
   },
   {
    "key": "restless",
    "role": "colour",
    "face": false
   },
   {
    "key": "form",
    "role": "time",
    "face": false
   },
   {
    "key": "fm",
    "role": "colour",
    "face": false
   }
  ],
  "needs_ui": [
   "kit.knob",
   "kit.segmented"
  ]
 }
}
