{
 "schema": "eravos.component-contract/1",
 "id": "lfo",
 "version": "1.1.0",
 "domain": "music",
 "kind": "audio",
 "kernel": "MusicParts.LFO",
 "ports": [
  {
   "id": "reset",
   "dir": "in",
   "type": "trigger",
   "rate": "block"
  },
  {
   "id": "out",
   "dir": "out",
   "type": "control",
   "range": [
    -1,
    1
   ],
   "rate": "audio"
  }
 ],
 "variables": [
  {
   "key": "shape",
   "type": "enum",
   "options": [
    "sine",
    "triangle",
    "saw up",
    "saw down",
    "square",
    "sample & hold",
    "smooth random",
    "pendulum"
   ],
   "default": "sine",
   "from": "LFO_SHAPES",
   "role": "shape"
  },
  {
   "key": "rate",
   "type": "number",
   "min": 0.01,
   "max": 50,
   "default": 1,
   "role": "rate",
   "unit": "Hz"
  },
  {
   "key": "phase",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0,
   "role": "time",
   "code": "ph0"
  },
  {
   "key": "fade",
   "type": "number",
   "min": 0,
   "max": 10,
   "default": 0,
   "role": "time",
   "unit": "s"
  },
  {
   "key": "unipolar",
   "type": "boolean",
   "default": false,
   "role": "mode"
  },
  {
   "key": "lean",
   "type": "number",
   "min": -1,
   "max": 1,
   "default": 0,
   "role": "shape"
  }
 ],
 "element": {
  "version": 1,
  "controls": [
   {
    "key": "shape",
    "role": "shape",
    "face": true
   },
   {
    "key": "rate",
    "role": "rate",
    "face": true
   },
   {
    "key": "phase",
    "role": "time",
    "face": false
   },
   {
    "key": "fade",
    "role": "time",
    "face": true
   },
   {
    "key": "unipolar",
    "role": "mode",
    "face": false
   },
   {
    "key": "lean",
    "role": "shape",
    "face": false
   }
  ],
  "needs_ui": [
   "kit.knob",
   "kit.segmented",
   "kit.toggle"
  ]
 }
}
