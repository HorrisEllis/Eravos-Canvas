{
 "schema": "eravos.component-contract/1",
 "id": "onset-detector",
 "version": "1.0.0",
 "domain": "music",
 "kind": "analysis",
 "kernel": "MusicParts.OnsetDetector",
 "ports": [
  {
   "id": "in",
   "dir": "in",
   "type": "audio",
   "rate": "audio"
  },
  {
   "id": "onsets",
   "dir": "out",
   "type": "trigger",
   "rate": "block"
  },
  {
   "id": "env",
   "dir": "out",
   "type": "control",
   "rate": "block"
  }
 ],
 "variables": [
  {
   "key": "sensitivity",
   "type": "number",
   "min": 1,
   "max": 4,
   "default": 1.5,
   "role": "depth"
  },
  {
   "key": "floor",
   "type": "number",
   "min": 0,
   "max": 20,
   "default": 1,
   "role": "level"
  },
  {
   "key": "gap",
   "type": "number",
   "min": 0.005,
   "max": 1,
   "default": 0.06,
   "role": "time",
   "unit": "s"
  }
 ],
 "element": {
  "version": 1,
  "controls": [
   {
    "key": "sensitivity",
    "role": "depth",
    "face": true
   },
   {
    "key": "floor",
    "role": "level",
    "face": false
   },
   {
    "key": "gap",
    "role": "time",
    "face": true
   }
  ],
  "needs_ui": [
   "kit.knob"
  ]
 }
}