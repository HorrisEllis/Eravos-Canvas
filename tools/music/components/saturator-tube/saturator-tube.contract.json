{
 "schema": "eravos.component-contract/1",
 "id": "saturator-tube",
 "version": "1.0.0",
 "domain": "music",
 "kind": "audio",
 "kernel": "MusicParts.TubeSat",
 "worklet": "eravos-saturator-tube",
 "variables_from": "TUBESAT_PARAMS",
 "ports": [
  {
   "id": "in",
   "dir": "in",
   "type": "audio",
   "channels": 2,
   "rate": "audio"
  },
  {
   "id": "out",
   "dir": "out",
   "type": "audio",
   "channels": 2,
   "rate": "audio"
  }
 ],
 "variables": [
  {
   "key": "drive",
   "type": "number",
   "min": 0,
   "max": 24,
   "default": 6,
   "audio_param": true,
   "rate": "audio",
   "role": "drive",
   "unit": "dB"
  },
  {
   "key": "bias",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0.3,
   "audio_param": true,
   "rate": "audio",
   "role": "colour"
  },
  {
   "key": "tone",
   "type": "number",
   "min": -1,
   "max": 1,
   "default": 0,
   "audio_param": true,
   "rate": "block",
   "role": "tone"
  },
  {
   "key": "out",
   "type": "number",
   "min": -24,
   "max": 6,
   "default": 0,
   "audio_param": true,
   "rate": "audio",
   "role": "level",
   "unit": "dB"
  },
  {
   "key": "mix",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 1,
   "audio_param": true,
   "rate": "audio",
   "role": "mix"
  }
 ],
 "element": {
  "version": 1,
  "controls": [
   {
    "key": "drive",
    "role": "drive",
    "face": true
   },
   {
    "key": "bias",
    "role": "colour",
    "face": false
   },
   {
    "key": "tone",
    "role": "tone",
    "face": true
   },
   {
    "key": "out",
    "role": "level",
    "face": false
   },
   {
    "key": "mix",
    "role": "mix",
    "face": true
   }
  ],
  "needs_ui": [
   "kit.knob"
  ]
 }
}
