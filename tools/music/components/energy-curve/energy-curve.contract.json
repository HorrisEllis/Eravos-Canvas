{
 "schema": "eravos.component-contract/1",
 "id": "energy-curve",
 "version": "1.0.0",
 "domain": "music",
 "kind": "audio",
 "kernel": "MusicParts.EnergyCurve",
 "ports": [
  {
   "id": "start",
   "dir": "in",
   "type": "trigger",
   "rate": "block"
  },
  {
   "id": "release",
   "dir": "in",
   "type": "trigger",
   "rate": "block"
  },
  {
   "id": "out",
   "dir": "out",
   "type": "control",
   "range": [
    0,
    1
   ],
   "rate": "block"
  }
 ],
 "variables": [
  {
   "key": "hold",
   "type": "number",
   "min": 0.01,
   "max": 600,
   "default": 8,
   "role": "time",
   "unit": "s"
  },
  {
   "key": "shape",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0.6,
   "role": "shape"
  },
  {
   "key": "release",
   "type": "number",
   "min": 0.001,
   "max": 30,
   "default": 0.2,
   "role": "time",
   "unit": "s"
  },
  {
   "key": "floor",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0,
   "role": "level"
  },
  {
   "key": "peak",
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 1,
   "role": "level"
  },
  {
   "key": "loop",
   "type": "enum",
   "options": [
    0,
    1
   ],
   "default": 0,
   "role": "mode"
  },
  {
   "key": "rest",
   "type": "number",
   "min": 0,
   "max": 600,
   "default": 0,
   "role": "time",
   "unit": "s"
  }
 ],
 "element": {
  "version": 1,
  "controls": [
   {
    "key": "hold",
    "role": "time",
    "face": true
   },
   {
    "key": "shape",
    "role": "shape",
    "face": true
   },
   {
    "key": "release",
    "role": "time",
    "face": true
   },
   {
    "key": "floor",
    "role": "level",
    "face": false
   },
   {
    "key": "peak",
    "role": "level",
    "face": false
   },
   {
    "key": "loop",
    "role": "mode",
    "face": false
   },
   {
    "key": "rest",
    "role": "time",
    "face": false
   }
  ],
  "needs_ui": [
   "kit.knob",
   "kit.segmented"
  ]
 }
}
