                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.5
                      },
                      "bassLevel": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.5
                      },
                      "harmonyLevel": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.5
                      },
                      "leadLevel": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.5
                      },
                      "rhythmOn": {
                        "type": "boolean"
                      },
                      "bassOn": {
                        "type": "boolean"
