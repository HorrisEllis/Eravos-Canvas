                        "minimum": 0,
                        "maximum": 2
                      },
                      "seed": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 99999
                      },
                      "pattern": {
                        "enum": [
                          "A",
                          "B",
                          "C",
                          "D"
                        ]
