{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.edm-lab/packs/pack.schema.json",
  "title": "Packs for EDM Lab (all-in-one) — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.edm-lab",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.edm-lab": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "energy": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "tension": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "progression": {
                        "enum": [
                          "i-VI-III-VII",
                          "i-iv-v-i",
                          "vi-IV-I-V",
                          "i-i-VI-VII"
                        ]
                      },
                      "chordBars": {
                        "enum": [
                          1,
                          2
                        ]
                      },
                      "swing": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.6
                      },
                      "seed": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 99999
                      },
                      "rhythmLevel": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "bassLevel": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "harmonyLevel": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "rhythmOn": {
                        "type": "boolean"
                      },
                      "bassOn": {
                        "type": "boolean"
                      },
                      "harmonyOn": {
                        "type": "boolean"
                      },
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
