                        "maximum": 1
                      },
                      "tension": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "swing": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.6
                      },
                      "humanize": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "density": {
