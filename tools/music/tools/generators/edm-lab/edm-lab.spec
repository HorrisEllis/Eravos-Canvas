# ============================================================
# ERAVOS ORGANISM SPEC — EDM LAB (groove generator)
# spec_id:      eravos.organism.edm-lab
# version:      3.0.0   (rebuild of 2.0.0)
# phase:        P6
# resolves:     F-18(lab)
# status:       canonical
# ============================================================

identity:
  id: eravos.edm-lab ; label: EDM Lab ; icon: ⚗ ; accent: "#ff2266"
  comp_intent: >
    Sketchpad for ideas when you don't know theory: paint where the
    rhythm is busy, turn one TENSION dial, and the lab plays a
    drum groove, an in-key bassline and a harmony bed that follow
    it. When it sounds right, PRINT it into a real sequencer.
  novelty: >
    Only organism that is generative: probability-density rhythm,
    bassline derived from the density map, tension-mapped harmony.
    Keeps the 2.0 concepts (density paint, tension wheel, drop) —
    rebuilt on the shared transport and scale.

rebuild_rules (F-18):
  - no private clock: all timing from transport:tick
  - no duplicated synth engines from other organisms: the lab's three voices are its own compact designs below
  - three separate out ports so each layer can go to its own channel

engines:
  RHYTHM: 8 kit rows × 32 steps density map (0..1); per tick: fire if rand(seed,step) < density·energy
          kit voices: kick(sine drop) · snare(noise+tone) · ghost-snare · closed hat(metal) · open hat · clap · perc(FM) · shaker
          seeded PRNG per bar (mulberry32) so a painted map is repeatable; 'reseed' button for variation
  BASS:   mono, root-following; on each kick-density peak ≥ 0.5 → note; degree chosen from chord of current bar (progression below); octave 1–2
          voice: saw+sub → LP (env) → soft clip ; glide on off-beats
  HARMONY: pad chords from progression; TENSION 0..1 maps voicing:
          0–0.25 triad · 0.25–0.5 add9/sus2 · 0.5–0.75 seventh + suspension · 0.75–1 cluster incl. b9/tritone, filter squeeze
          voice: 4-voice detuned triangle/saw blend → LP → slow amp swell
  PROGRESSION: preset list in scale degrees (i–VI–III–VII, i–iv–v–i, vi–IV–I–V, i–i–VI–VII) 1 chord / bar or / 2 bars
  ENERGY: macro 0..1 scales rhythm density, bass octave jumps, harmony brightness (one-knob arrangement)
  DROP: armed → at next bar: 1-bar filter-closed build (energy ramps), silence 1 beat, then energy = 1 + impact (sub boom + noise crash)

config:
  energy 0..1 def 0.6 ; tension 0..1 def 0.3 ; progression enum def 'i-VI-III-VII' ; chordBars enum [1,2] def 1
  swing 0..0.6 def 0.1 ; seed int ; levels: rhythm/bass/harmony 0..1 ; bassOn/harmonyOn/rhythmOn bool

hooks:
  - lab.hook.out_rhythm:  out ; audio ; port rhythm
  - lab.hook.out_bass:    out ; audio ; port bass
  - lab.hook.out_harmony: out ; audio ; port harmony
  - lab.hook.transport_in STD.transport_in
  - lab.hook.theory_in    STD.theory_in
  - lab.hook.print_out:   out ; event_bus ; seq:pattern_suggest {target, track, steps} (bakes current seed: drum lanes + bass lane)
  - lab.hook.drop_out:    out ; edm:drop-fired {time}
  - lab.hook.mod_energy   STD.mod_in(energy)   (event-rate; also accepts automation)
  - lab.hook.mod_tension  STD.mod_in(tension)

presets: [UKG Shuffle, Dubstep Half-time, Melodic House, Neuro Roller, Lo-fi Drift]

ui:
  three panes kept from 2.0 identity, rebuilt:
    RHYTHM canvas — brush paint density (size, strength, erase), playing cursor, fired hits flash
    BASS view — scrolling note ribbon (notes actually played, named)
    TENSION wheel — dial + chord name readout ("Am add9"), voicing dots on a circle of fifths
  bottom: ENERGY slider, DROP (arm/cancel), PRINT → sequencer (target + track select), reseed
  ui_hooks: [ui:paint {row, step, radius, value}, ui:clear {row?}, ui:reseed, ui:drop_arm, ui:print {target}, standard_ui_hooks]

tests:
  - standard_tests (each of 3 ports non-silent)
  - same seed + same map → identical hit list over 4 bars
  - bass notes ⊂ scale; on chord change bar, bass root = chord root
  - tension 0 → triad pitch classes ; tension 1 → includes b9 or tritone
  - DROP armed at bar 3 → impact at bar 5 beat 1 ± 1 sample, silence on bar 4 beat 4
  - PRINT → sequencer receives pattern whose playback equals lab output for that seed (drum lanes)

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo, music.key, music.meter]   # ui expansion when added: Audio engine · Transport · Tempo · Song key · Master meter
  services:
    - audio: Audio engine — makes sound
    - clock: Master clock & tempo — locks to the beat
    - key: Song key & scale — plays in key
    - mod: 2 modulation inputs — LFO / XY / Macro can move them
  inputs:
    - lab.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
    - lab.hook.theory_in (theory:key-change) — ambient broadcast
    - lab.hook.mod_energy (modulation · port mod.energy)
    - lab.hook.mod_tension (modulation · port mod.tension)
  outputs:
    - lab.hook.out_rhythm (audio · port rhythm)
    - lab.hook.out_bass (audio · port bass)
    - lab.hook.out_harmony (audio · port harmony)
    - lab.hook.print_out (seq:pattern_suggest)
    - lab.hook.drop_out (edm:drop-fired)
  permissions: [audio_out, bus_publish, bus_subscribe, registry_read]
  works_with: [eravos.sequencer]
