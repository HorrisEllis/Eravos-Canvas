{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.arp/packs/pack.schema.json",
  "title": "Packs for Arp — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.arp",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.arp": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "order": {
                        "enum": [
                          "up",
                          "down",
                          "up-down",
                          "random",
                          "played"
                        ]
                      },
                      "div": {
                        "enum": [
                          "1/4",
                          "1/8",
                          "1/16",
                          "1/8t",
                          "1/16t",
                          "1/32"
                        ]
                      },
                      "octaves": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3
                      },
                      "gate": {
                        "type": "number",
                        "minimum": 0.05,
                        "maximum": 1
                      },
                      "latch": {
                        "type": "boolean"
                      },
                      "velocity": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 1
                      },
                      "transpose": {
                        "type": "integer",
                        "minimum": -24,
                        "maximum": 24
                      },
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
