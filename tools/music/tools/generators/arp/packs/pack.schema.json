{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.arp/packs/pack.schema.json",
  "title": "Packs for Arp — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.arp",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.arp": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "order": {
                        "enum": [
                          "up",
                          "down",
                          "up-down",
                          "down-up",
                          "converge",
                          "diverge",
                          "pinky",
                          "thumb",
                          "scale",
                          "random",
                          "played",
                          "chord"
                        ]
                      },
                      "div": {
                        "enum": [
                          "1/1",
                          "1/2",
                          "1/2t",
                          "1/4",
                          "1/4t",
                          "1/8",
                          "1/16",
                          "1/8t",
                          "1/16t",
                          "1/32",
                          "1/32t"
                        ]
                      },
                      "octaves": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4
                      },
                      "octDir": {
                        "enum": [
                          "up",
                          "down",
                          "center"
                        ]
                      },
                      "repeat": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 8
                      },
                      "length": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 32
                      },
                      "restart": {
                        "enum": [
                          "off",
                          "bar",
                          "notes"
                        ]
                      },
                      "steps": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 32
                      },
                      "swing": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.75
                      },
                      "chance": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "gate": {
                        "type": "number",
                        "minimum": 0.05,
                        "maximum": 2
                      },
                      "gateRand": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "humanize": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 40
                      },
                      "slide": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "latch": {
                        "type": "boolean"
                      },
                      "velocity": {
                        "type": "number",
                        "minimum": 0.05,
                        "maximum": 1
                      },
                      "velRand": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "velRamp": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "transpose": {
                        "type": "integer",
                        "minimum": -36,
                        "maximum": 36
                      },
                      "stack": {
                        "enum": [
                          "none",
                          "+oct",
                          "+5th",
                          "+oct+5th",
                          "-oct"
                        ]
                      },
                      "seed": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9999
                      },
                      "_react": {},
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
