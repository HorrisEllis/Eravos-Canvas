{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.pattern-field/packs/pack.schema.json",
  "title": "Packs for Pattern — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.pattern-field",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.pattern-field": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "chords": {
                        "enum": [
                          "progression",
                          "scale only"
                        ]
                      },
                      "progression": {
                        "enum": [
                          "i-VI-III-VII",
                          "i-iv-v-i",
                          "vi-IV-I-V",
                          "i-i-VI-VII",
                          "i-v-VI-iv",
                          "ii-V-I-I",
                          "ii-V-I-vi",
                          "I-vi-ii-V",
                          "IV-iii-vi-ii",
                          "i-iv-VII-III",
                          "vi-ii-V-I"
                        ]
                      },
                      "chordBars": {
                        "enum": [
                          1,
                          2,
                          4
                        ]
                      },
                      "bars": {
                        "enum": [
                          1,
                          2,
                          4,
                          8
                        ]
                      },
                      "gridK": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16
                      },
                      "gridN": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16
                      },
                      "gridRot": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 15
                      },
                      "lo": {
                        "type": "integer",
                        "minimum": 12,
                        "maximum": 108
                      },
                      "hi": {
                        "type": "integer",
                        "minimum": 13,
                        "maximum": 120
                      },
                      "densStart": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "densEnd": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "densShape": {
                        "enum": [
                          "rise",
                          "fall",
                          "arch",
                          "hold"
                        ]
                      },
                      "contour": {
                        "enum": [
                          "flat",
                          "rise",
                          "fall",
                          "arch",
                          "wave"
                        ]
                      },
                      "contourAmt": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 36
                      },
                      "centre": {
                        "type": "integer",
                        "minimum": 12,
                        "maximum": 120
                      },
                      "length": {
                        "type": "number",
                        "minimum": 0.25,
                        "maximum": 8
                      },
                      "seed": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 99999
                      },
                      "locked": {},
                      "_react": {},
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
