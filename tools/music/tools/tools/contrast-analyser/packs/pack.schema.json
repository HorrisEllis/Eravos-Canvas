{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.contrast-analyser/packs/pack.schema.json",
  "title": "Packs for Contrast — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.contrast-analyser",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.contrast-analyser": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "fft": {
                        "enum": [
                          2048,
                          4096,
                          8192
                        ]
                      },
                      "smoothing": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.95
                      },
                      "sensitivity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "bpmSource": {
                        "enum": [
                          "session",
                          "detected"
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
