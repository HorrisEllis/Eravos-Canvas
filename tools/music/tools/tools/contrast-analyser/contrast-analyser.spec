# ============================================================
# ERAVOS ORGANISM SPEC — CONTRAST ANALYSER
# spec_id:      eravos.organism.contrast-analyser
# version:      2.0.0
# phase:        P6
# resolves:     F-14
# status:       canonical
# ============================================================

identity:
  id: eravos.contrast-analyser ; label: Contrast ; icon: ⟺ ; accent: "#00d4ff"
  comp_intent: >
    Tell a non-engineer, in plain words, whether two sounds fight:
    same frequencies (mud), same loudness (masking), same rhythm
    (flat) — and what to do about it. Works on files or live signals.
  novelty: >
    Only analysis organism: real FFT, band-wise masking, onset
    detection, and live tap inputs that never alter routing.

engine:
  inputs per slot (A, B):
    file:  decoded buffer (drop on slot or asset:ready) — never global intake grab (F-14)
    live:  audio in port (tap: true) — kernel keeps source on master
  spectrum: radix-2 FFT 4096, Hann, 50% overlap, Welch-averaged magnitude (file) / exponential average τ 1 s (live)
  bands: 24 Bark bands; band energy dB
  clash: Σ_b min(Ea_b, Eb_b) / Σ_b max(Ea_b, Eb_b) over bands where both > −60 dB ×100  → 0 separate … 100 identical
  masking: per band, which slot dominates by > 6 dB ; list top 3 contested bands with Hz range
  dynamics: short-term RMS curves (100 ms), crest factor, loudness difference (K-weighted)
  rhythm: spectral-flux onsets ; tempo via autocorrelation of onset envelope (60–200 BPM, octave-error correction) ; displacement vs 1/16 grid at session BPM
  advice: rule table → plain sentences with a concrete action (e.g. "Both are loud at 180–250 Hz. Cut 3 dB at 220 Hz on B, or sidechain B to A.")

config:
  fft enum [2048, 4096, 8192] def 4096 ; smoothing 0..0.95 def 0.8 ; sensitivity 0..1 def 0.4 ; bpmSource enum [session, detected] def session

hooks:
  - ca.hook.in_a:        in ; audio ; port inA ; tap
  - ca.hook.in_b:        in ; audio ; port inB ; tap
  - ca.hook.asset_in:    in ; asset:ready (only when a slot is 'waiting')
  - ca.hook.analysis_out: out ; contrast:analysis {clash, contested:[{lo,hi,winner}], dynDiffDb, displacement, bpm, advice[]} ; 2.0.0

ui:
  slots A/B: file or LIVE toggle, name, mini waveform
  tabs: FREQUENCY (overlaid Bark spectra, contested bands shaded) · DYNAMICS (RMS curves, crest) · RHYTHM (onset grids on 1/16 lattice)
  score strip: CLASH · LOUDNESS GAP · DISPLACEMENT with coloured plain-language verdicts
  advice list (copyable)
  ui_hooks: [ui:slot_load {slot, arrayBuffer, name}, ui:slot_mode {slot, mode}, ui:tab, ui:reanalyse, standard_ui_hooks]

raises_faults: [ASSET_002, RUNTIME_002]

tests:
  - FFT of 1 kHz sine peaks in bin round(1000·N/sr) ± 1
  - 100 Hz vs 5 kHz sines → clash < 5 ; identical file twice → clash > 95
  - 120 BPM click track → detected 120 ± 1
  - live mode: source still audible on master (tap does not reroute)
  - no slot captures files dropped elsewhere on the canvas

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine]   # ui expansion when added: Audio engine
  services:
    - audio: Audio engine — listens to sound
    - mod: 4 modulation inputs — LFO / XY / Macro can move them
    - files: Your files — drop audio / MIDI on it
  inputs:
    - ca.hook.in_a (audio · port inA)
    - ca.hook.in_b (audio · port inB)
    - ca.hook.asset_in (asset:ready)
    - knob.fft (modulation · port mod.knob.fft)
    - knob.smoothing (modulation · port mod.knob.smoothing)
    - knob.sensitivity (modulation · port mod.knob.sensitivity)
    - knob.bpmSource (modulation · port mod.knob.bpmSource)
  outputs:
    - ca.hook.analysis_out (contrast:analysis)
  permissions: [audio_in, bus_publish, bus_subscribe, filesystem_read]
  works_with: [eravos.song-recorder, eravos.drum-forge, eravos.session, eravos.clip-maker, eravos.sample-player]
