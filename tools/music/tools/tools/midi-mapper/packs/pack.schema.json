{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.midi-mapper/packs/pack.schema.json",
  "title": "Packs for MIDI Map — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.midi-mapper",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.midi-mapper": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "profile": {
                        "enum": [
                          "generic",
                          "starrypad",
                          "launchpad",
                          "apc"
                        ]
                      },
                      "input": {
                        "type": "string"
                      },
                      "output": {
                        "type": "string"
                      },
                      "bank": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "padTarget": {
                        "type": "string"
                      },
                      "velocityCurve": {
                        "enum": [
                          "soft",
                          "linear",
                          "hard",
                          "fixed"
                        ]
                      },
                      "padLayout": {
                        "enum": [
                          "drums",
                          "keys",
                          "chords",
                          "split",
                          "perform",
                          "custom"
                        ]
                      },
                      "keysTarget": {
                        "type": "string"
                      },
                      "padOctave": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 7
                      },
                      "chordType": {
                        "enum": [
                          "triad",
                          "seventh",
                          "add9",
                          "sus2",
                          "sus4",
                          "power"
                        ]
                      },
                      "noteLength": {
                        "type": "number",
                        "minimum": 0.05,
                        "maximum": 4
                      },
                      "ledFeedback": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
