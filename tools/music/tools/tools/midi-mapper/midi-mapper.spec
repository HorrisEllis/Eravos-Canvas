# spec_id: eravos.organism.midi-mapper · version 1.0.0 · phase P8.5 · status canonical
# source: v10 MAPPER V2 (visual pad grid, inline editor, MIDI monitor, bank switcher) + PAD LIGHTING TO HARDWARE
identity:
  id: eravos.midi-mapper ; label: MIDI Map ; icon: 🎛 ; accent: "#ff6b00"
  comp_intent: Plug in a MIDI controller, wiggle a knob, click a parameter — mapped. Pads light up on the hardware.
  novelty: Only organism owning Web MIDI I/O; learn-mode mapping from any CC/note to any organism parameter; LED feedback out.
engine:
  access: navigator.requestMIDIAccess({sysex:false}) ; hot-plug via onstatechange ; permissions midi_in, midi_out
  publish: midi:note {note, velocity, on, channel, deviceId} (replaces shell's inline MIDI handler as the canonical source; shell handler left, duplicate suppressed by deviceId+timestamp de-dup)
  learn: arm → next CC/note captured → next ui:config_change on any organism captured → mapping {device, channel, type, number, target, key, min, max, curve, takeover: jump|pickup}
  apply: CC value → denormalised → ui:config_change:<target> {key, value} (event-rate, ≤ 1 per ms per mapping)
  feedback: pad:trigger / seq:fire / mapped param changes → note-on/CC out to device (colour velocity table per device profile)
  banks: 4 mapping banks, switchable by a mapped button
  profiles: generic, Launchpad-style grid, APC-style (LED velocity tables)
config: inputs[] enabled ; output device ; profile ; bank 0..3 ; mappings[]
hooks: mm.hook.midi_out_bus (out ; midi:note) ; drive_out (out ; ui:config_change per target) ; feedback_in (in ; pad:trigger | seq:fire | org:param)
ui: hero = device list + live MIDI monitor (scrolling messages) ; mapping table (source → target.param, range, curve, delete) ; LEARN button ; visual pad grid mirroring controller layout
raises_faults: [RUNTIME_001 (MIDI permission denied — organism stays, shows state), RUNTIME_002]
tests (with mocked MIDIAccess): learn CC 74 → channel fader ; value 127 → max ; pickup mode ignores CC until it crosses current value ; LED note-on sent on pad:trigger

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.midi]   # ui expansion when added: Audio engine · MIDI button
  services:
    - audio: Audio engine — shares the audio clock
    - midi: MIDI input — plays from a controller (arm with the MIDI button)
  inputs:
    - mm.hook.feedback_in (pad:trigger|seq:fire)
  outputs:
    - mm.hook.midi_out_bus (midi:note)
    - mm.hook.status_out (midi:status)
    - mm.hook.pads_out (note:trigger)
    - mm.hook.drive_out (ui:config_change)
  permissions: [midi_in, midi_out, bus_publish, bus_subscribe, registry_read]
  works_with: [eravos.pads, eravos.sample-player, eravos.wobble-bass, eravos.acid-synth, eravos.reese-bass, eravos.supersaw, eravos.macro-automation, eravos.xen-synth]
