# spec_id: eravos.organism.sub-engine · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.sub-engine ; label: Deep Sub ; icon: ◉ ; accent: "#7a5cff" ; category: Sound sources
  comp_intent: The deepest bass: pure mono sub, 808 drops and slides, plus phantom harmonics so it is heard even on a phone.
  engine_notes: |
    Bass you feel AND hear. A clean mono sub (sine ↔ triangle ↔ rounded square) with an 808 pitch-drop envelope and
    legato glide, kept pure below; above it, PHANTOM harmonics: the sub is folded into its 2nd–5th harmonics and
    band-limited to 90–600 Hz, so the ear rebuilds the missing fundamental on phones and laptop speakers
    (psychoacoustic bass). Transient click for definition, warm drive on a separate band, infrasonic floor + DC block.
config:
  shape: number 0..1 def 0.15   # SUB · Shape
  octave: integer -4..0 def -2   # SUB · Octave
  floor: number 12..45 Hz def 24   # SUB · Floor
  drop: number 0..36 st def 0   # PITCH · Drop
  dropTime: number 0.005..2 s def 0.06   # PITCH · Drop time
  glide: number 0..1.5 s def 0.08   # PITCH · Glide
  phantom: number 0..1 def 0.35   # TONE · Phantom
  drive: number 0..1 def 0.15   # TONE · Warmth
  click: number 0..1 def 0.2   # TONE · Click
  tone: number 120..4000 Hz def 900   # TONE · Tone
  attack: number 0.001..1 s def 0.004   # ENV · Attack
  decay: number 0.02..6 s def 0.8   # ENV · Decay
  sustain: number 0..1 def 0.85   # ENV · Sustain
  release: number 0.01..4 s def 0.18   # ENV · Release
  level: number 0..1.5 def 0.8   # OUT · Level
presets: ["Deep Sine", "Sound-System Sub (reggae)", "808 Boom", "808 Long Slide", "Earthquake Drop", "Phone-Speaker Sub", "Dubstep Sub Layer", "Garage Punch"]
ui_hooks: [] + standard
tests: standard_tests + see tests/p14.test.js

