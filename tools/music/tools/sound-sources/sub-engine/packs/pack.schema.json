                      "dropTime": {
                        "type": "number",
                        "minimum": 0.005,
                        "maximum": 2
                      },
                      "glide": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.5
                      },
                      "phantom": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "drive": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "click": {
