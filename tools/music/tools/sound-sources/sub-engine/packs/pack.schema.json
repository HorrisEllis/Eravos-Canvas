{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.sub-engine/packs/pack.schema.json",
  "title": "Packs for Deep Sub — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
