{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.curve-synth/packs/pack.schema.json",
  "title": "Packs for Curve — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.curve-synth",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.curve-synth": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "slot": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 7
                      },
                      "duration": {
                        "type": "number",
                        "minimum": 0.05,
                        "maximum": 4
                      },
                      "lowNote": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 120
                      },
                      "highNote": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 127
                      },
                      "edge": {
                        "type": "boolean"
                      },
                      "bounces": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 8
                      },
                      "restitution": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "decay": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 1
                      },
                      "wave": {
                        "enum": [
                          "sine",
                          "triangle",
                          "sawtooth",
                          "square"
                        ]
                      },
                      "noise": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "drive": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "sustain": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "level": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.5
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
