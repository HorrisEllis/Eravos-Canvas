# spec_id: eravos.organism.curve-synth · version 1.0.0 · phase P8.3 · status canonical
# source: v10 CURVE_INSTRUMENT, curve editor window, synths.curvePerc, plugins/curve.json "CURVE PERCUSSOR"
identity:
  id: eravos.curve-synth ; label: Curve ; icon: ⤵ ; accent: "#993300"
  comp_intent: Draw a pitch gesture; the sound follows it, slams the edge and bounces — the QOTSA dive-and-ricochet.
  novelty: Only organism whose pitch trajectory is a user-drawn curve with physical edge-bounce.
engine:
  curve: up to 8 stored curves, each ≤ 256 points (t 0..1, pitch 0..1) ; smoothed (Catmull-Rom) → setValueCurveAtTime on osc frequency (range lowNote..highNote)
  edge: when curve hits top/bottom edge → bounce: reflected segment with energy × restitution, up to N bounces, each shorter by decay
  voice: osc (saw/square/sine) + noise layer → BP tracking pitch → amp env → drive
  trigger: note:trigger (note transposes whole curve), click on canvas, keys 1–8 select curve
config: curve slot 1..8 ; duration 0.05..4 s (or div) ; lowNote/highNote ; bounces 0..8 def 3 ; restitution 0..1 def 0.6 ; edge bool ; wave ; noise 0..1 ; drive
presets: Songs-for-the-Dead Dive, Ricochet, Siren, Drop Whoop
hooks: STD.audio_out ; STD.note_in ; STD.midi_in
ui: hero = draw canvas (drag to draw, shift = straight), bounce path preview, live pitch dot while playing ; curve slots strip
tests: straight rising curve 0→1 over 1 s → f rises low→high monotonically ; bounces 2 → 2 reflections with decreasing amplitude ; curve stored in serialize

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.meter, music.midi]   # ui expansion when added: Audio engine · Master meter · MIDI button
  services:
    - audio: Audio engine — makes sound
    - midi: MIDI input — plays from a controller (arm with the MIDI button)
    - mod: 13 modulation inputs — LFO / XY / Macro can move them
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
  inputs:
    - curve.hook.note_in (note:trigger)
    - curve.hook.midi_in (midi:note) — ambient broadcast
    - knob.slot (modulation · port mod.knob.slot)
    - knob.duration (modulation · port mod.knob.duration)
    - knob.lowNote (modulation · port mod.knob.lowNote)
    - knob.highNote (modulation · port mod.knob.highNote)
    - knob.edge (modulation · port mod.knob.edge)
    - knob.bounces (modulation · port mod.knob.bounces)
    - knob.restitution (modulation · port mod.knob.restitution)
    - knob.decay (modulation · port mod.knob.decay)
    - knob.wave (modulation · port mod.knob.wave)
    - knob.noise (modulation · port mod.knob.noise)
    - knob.drive (modulation · port mod.knob.drive)
    - knob.sustain (modulation · port mod.knob.sustain)
    - knob.level (modulation · port mod.knob.level)
  outputs:
    - curve.hook.audio_out (audio · port out)
  permissions: [audio_out, midi_in, bus_publish, bus_subscribe]
  works_with: [eravos.drum-forge, eravos.sequencer, eravos.fx-echo, eravos.timeline, eravos.arp, eravos.bass-gen, eravos.chord-gen, eravos.groove-gen]
