# ============================================================
# ERAVOS ORGANISM SPEC — SUPERSAW (poly lead + chords)
# spec_id:      eravos.organism.supersaw
# version:      2.1.0   (amendment A-1: arp moved to eravos.arp)
# phase:        P2
# resolves:     F-11(supersaw)
# status:       canonical
# ============================================================

identity:
  id: eravos.supersaw ; label: Supersaw ; icon: 🌊 ; accent: "#00d4ff"
  comp_intent: >
    Polyphonic festival lead / chord stab. One key press can play a
    full in-key chord — the main gap-bridge for a non-musician.
    Pair with eravos.arp for tempo-locked patterns.
  novelty: >
    Only polyphonic organism: voice allocator + chord engine
    (arpeggiation lives in eravos.arp). JP-8000 non-linear detune curve.

engine:
  voices: 8 poly (steal: oldest released, then oldest held)
  per_voice: unison 1..9 saws, detune curve d(x) = x·(0.25 + 0.75·x²) × detune, center voice louder by mix
             → HP at note freq (removes unison mud) → LP with filter ADSR → amp ADSR → stereo spread pan
  chord: note → MusicTheory.chord(degreeOf(note), root, scale, chordType) when chordMode on
  poly aftertouch: none (declared out of scope)

config:
  unison 1..9 def 7 ; detune 0..1 def 0.35 ; mix 0..1 def 0.6 ; spread 0..1 def 0.7
  cutoff 200..18000 def 6000 ; res 0.5..10 def 0.8 ; fEnv 0..4 oct def 1 ; fA/fD/fS/fR
  aA 0.001..4 def 0.01 ; aD 0.01..4 def 0.3 ; aS 0..1 def 0.7 ; aR 0.01..6 def 0.4
  chordMode: enum [off, triad, seventh, sus2, sus4, power] def off
  octave −2..2 ; level 0..1 def 0.7

hooks:
  - saw.hook.audio_out    STD.audio_out
  - saw.hook.note_in      STD.note_in (duration used for note-off)
  - saw.hook.midi_in      STD.midi_in
  - saw.hook.theory_in    STD.theory_in (chords, keyboard)
  - saw.hook.mod_cutoff   STD.mod_in(cutoff) → per-voice filters via shared ConstantSource → detune ±4800 c
  - saw.hook.mod_detune   STD.mod_in(detune)

presets: [Festival Lead, Trance Pluck, Wide Pad, Chord Stab (triad)]

ui:
  hero: playable scale keyboard (2 octaves, in-key notes lit; out-of-key dimmed and snapped when scale lock on)
  voice activity strip (8 cells lit per active voice)
  panels: OSC (unison/detune/mix/spread) | FILTER+ENV | AMP ENV (drawn ADSR, draggable nodes) | CHORD
  qwerty: A S D F G H J K = scale degrees 1..8 while focused
  ui_hooks: [standard_ui_hooks, ui:key_down {note}, ui:key_up {note}]

tests:
  - standard_tests
  - 9 simultaneous notes → 8 voices, first released steals
  - chordMode triad, C major, degree 2 → [62, 65, 69]
  - ADSR: sustain level reached at t + A + D ± 1 ms

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.key, music.meter, music.midi]   # ui expansion when added: Audio engine · Song key · Master meter · MIDI button
  services:
    - audio: Audio engine — makes sound
    - key: Song key & scale — plays in key
    - midi: MIDI input — plays from a controller (arm with the MIDI button)
    - mod: 19 modulation inputs — LFO / XY / Macro can move them
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
  inputs:
    - saw.hook.note_in (note:trigger)
    - saw.hook.midi_in (midi:note) — ambient broadcast
    - saw.hook.theory_in (theory:key-change) — ambient broadcast
    - saw.hook.mod_cutoff (modulation · port mod.cutoff)
    - saw.hook.mod_detune (modulation · port mod.detune)
    - knob.unison (modulation · port mod.knob.unison)
    - knob.mix (modulation · port mod.knob.mix)
    - knob.spread (modulation · port mod.knob.spread)
    - knob.res (modulation · port mod.knob.res)
    - knob.fEnv (modulation · port mod.knob.fEnv)
    - knob.fA (modulation · port mod.knob.fA)
    - knob.fD (modulation · port mod.knob.fD)
    - knob.fS (modulation · port mod.knob.fS)
    - knob.fR (modulation · port mod.knob.fR)
    - knob.aA (modulation · port mod.knob.aA)
    - knob.aD (modulation · port mod.knob.aD)
    - knob.aS (modulation · port mod.knob.aS)
    - knob.aR (modulation · port mod.knob.aR)
    - knob.chordMode (modulation · port mod.knob.chordMode)
    - knob.octave (modulation · port mod.knob.octave)
    - knob.level (modulation · port mod.knob.level)
    - bend.in (modulation · port mod.bendin)
  outputs:
    - saw.hook.audio_out (audio · port out)
    - curve.out (modulation · port curve)
  permissions: [audio_out, midi_in, bus_publish, bus_subscribe]
  works_with: [eravos.timeline, eravos.sequencer, eravos.arp, eravos.bass-gen, eravos.chord-gen, eravos.groove-gen, eravos.midi-mapper, eravos.lyric-rhythm]

