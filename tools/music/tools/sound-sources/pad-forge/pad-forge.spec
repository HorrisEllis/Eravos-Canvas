# spec_id: eravos.organism.pad-forge · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.pad-forge ; label: Pad Forge ; icon: ☁ ; accent: "#8fd3ff" ; category: Sound sources
  comp_intent: Make pads: blend four sources on an XY square that drifts by itself, blooming filter, chord hold, shimmer halos.
  engine_notes: |
    Make pad sounds. Vector synthesis: four different sources sit on the corners of a square (swarm, glass, air, choir,
    organ, strings, halo); a point inside the square mixes them, and that point ORBITS (circle, figure-8, drift) so the pad
    keeps changing while you hold the chord. Bloom opens the filter over seconds; Hold latches chords; the shimmer space
    is a long generated reverb whose tail is pitched up an octave and fed back — halos that build on themselves.
config:
  cornerA: enum ["swarm", "glass", "air", "choir", "organ", "strings", "halo"] def "swarm"   # CORNERS · ↖ A
  cornerB: enum ["swarm", "glass", "air", "choir", "organ", "strings", "halo"] def "glass"   # CORNERS · ↗ B
  cornerC: enum ["swarm", "glass", "air", "choir", "organ", "strings", "halo"] def "choir"   # CORNERS · ↙ C
  cornerD: enum ["swarm", "glass", "air", "choir", "organ", "strings", "halo"] def "air"   # CORNERS · ↘ D
  x: number 0..1 def 0.4   # VECTOR · X
  y: number 0..1 def 0.4   # VECTOR · Y
  orbit: enum ["still", "circle", "figure-8", "drift"] def "circle"   # VECTOR · Orbit
  orbitRate: number 0.005..2 Hz def 0.06   # VECTOR · Orbit rate
  orbitSize: number 0..0.5 def 0.3   # VECTOR · Orbit size
  cutoff: number 120..16000 Hz def 3200   # TONE · Cutoff
  bloom: number 0..1 def 0.5   # TONE · Bloom
  warmth: number 0..1 def 0.2   # TONE · Warmth
  width: number 0..1 def 0.8   # TONE · Width
  attack: number 0.005..10 s def 1.2   # ENV · Attack
  release: number 0.05..16 s def 3   # ENV · Release
  hold: boolean def false   # ENV · Hold
  space: number 0..1 def 0.45   # SHIMMER · Space
  shimmer: number 0..0.85 def 0.35   # SHIMMER · Shimmer
  size: number 1..14 s def 6   # SHIMMER · Size
  level: number 0..1.5 def 0.7   # OUT · Level
presets: ["Her Essence", "Celestial Glass", "Golden Hour Strings", "Dark Choir", "Neon Juno Pad", "Dub Chord Bed", "Frozen Halo (hold)", "Underwater"]
ui_hooks: [release_all] + standard
tests: standard_tests + see tests/p14.test.js

