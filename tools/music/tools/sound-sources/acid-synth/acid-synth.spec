# ============================================================
# ERAVOS ORGANISM SPEC — ACID SYNTH (303 model)
# spec_id:      eravos.organism.acid-synth
# version:      2.0.0
# phase:        P2
# resolves:     F-11(acid)
# status:       canonical
# ============================================================

identity:
  id: eravos.acid-synth ; label: Acid Synth ; icon: ⚡ ; accent: "#00ff88"
  comp_intent: >
    Faithful TB-303 behaviour: accent and slide are per-note
    articulations that change the envelope circuit, not presets.
  novelty: >
    Only organism modelling the accent-sweep capacitor (consecutive
    accents stack cutoff) and gate-held slide. Ships a scale-locked
    line generator that writes into a sequencer track.

engine:
  graph: osc(saw|square) → 18 dB-ish LP (3 cascaded biquads, shared cutoff) → VCA → drive(tanh, pre-gain) → out
  env_mod: filter env decay (fixed 200 ms non-accent / accent-decay 200 ms), depth = envMod
  accent:
    - adds accent × (envMod + 0.5) to filter peak
    - amp +accent×6 dB
    - sweep capacitor: charge += accent·0.35 per accented note, leaks with τ = 0.35 s; adds charge × 2 oct to cutoff
  slide:
    - note flagged slide → pitch glides to NEXT note over 60 ms (fixed, like hardware)
    - gate held: amp + filter env NOT retriggered on the slid-to note
  tuning: note from STD.note_in, already scale-quantized by sender; octave −2..+2

config:
  wave: enum [saw, square] def saw ; cutoff 30..5000 def 350 ; res 0..1 def 0.7 (mapped Q 0.7..22)
  envMod 0..1 def 0.5 ; decay 0.05..2 s def 0.3 ; accent 0..1 def 0.6 ; drive 0..1 def 0.3 ; octave −2..2 def 0 ; tune −1..1 st

hooks:
  - acid.hook.audio_out   STD.audio_out
  - acid.hook.note_in     STD.note_in (honours accent, slide)
  - acid.hook.midi_in     STD.midi_in (vel > 0.8 → accent)
  - acid.hook.theory_in   STD.theory_in (generator scale)
  - acid.hook.mod_cutoff  STD.mod_in(cutoff) → detune ±4800 c
  - acid.hook.mod_res     STD.mod_in(res)
  - acid.hook.pattern_out: out ; event_bus ; seq:pattern_suggest {target, track, steps:[{on, degree, octave, accent, slide}]} ; 1.0.0

generator:
  input:  length 16, density 0..1, accent rate, slide rate, range (octaves), seed
  output: scale degrees only (root-weighted: 1 and 5 twice as likely)
  delivery: publishes seq:pattern_suggest to a chosen sequencer instance/track; never touches it directly (K-3)

presets: [Phuture Squelch, Hardfloor Growl, Rubber Square, Deep Minimal, Screamer]

ui:
  hero: 3 big knobs (CUTOFF, RES, ENV MOD) + accent-charge meter (live capacitor level)
  secondary: decay, accent, drive, wave toggle, octave
  generator panel: density/accent/slide sliders, target sequencer+track select, GENERATE, seed dice
  ui_hooks: [standard_ui_hooks, ui:generate {target, track, density, accentRate, slideRate, range, seed}]

tests:
  - standard_tests
  - 3 consecutive accents raise effective cutoff monotonically; decays after 1 s idle
  - slide: second note no env retrigger, pitch reaches target at 60 ms ± 2 ms
  - generator seed determinism: same seed → identical steps; all notes in scale

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.key, music.meter, music.midi]   # ui expansion when added: Audio engine · Song key · Master meter · MIDI button
  services:
    - audio: Audio engine — makes sound
    - key: Song key & scale — plays in key
    - midi: MIDI input — plays from a controller (arm with the MIDI button)
    - mod: 10 modulation inputs — LFO / XY / Macro can move them
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
  inputs:
    - acid.hook.note_in (note:trigger)
    - acid.hook.midi_in (midi:note) — ambient broadcast
    - acid.hook.theory_in (theory:key-change) — ambient broadcast
    - acid.hook.mod_cutoff (modulation · port mod.cutoff)
    - acid.hook.mod_res (modulation · port mod.res)
    - knob.envMod (modulation · port mod.knob.envMod)
    - knob.decay (modulation · port mod.knob.decay)
    - knob.accent (modulation · port mod.knob.accent)
    - knob.drive (modulation · port mod.knob.drive)
    - knob.level (modulation · port mod.knob.level)
    - knob.wave (modulation · port mod.knob.wave)
    - knob.octave (modulation · port mod.knob.octave)
    - knob.tune (modulation · port mod.knob.tune)
  outputs:
    - acid.hook.audio_out (audio · port out)
    - acid.hook.pattern_out (seq:pattern_suggest)
  permissions: [audio_out, midi_in, bus_publish, bus_subscribe]
  works_with: [eravos.timeline, eravos.sequencer, eravos.arp, eravos.bass-gen, eravos.chord-gen, eravos.groove-gen, eravos.midi-mapper, eravos.lyric-rhythm]
