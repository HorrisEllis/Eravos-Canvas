# spec_id: eravos.lyric-rhythm · version 1.0.0 · status built · template eravos.tool/1
identity:
  id: eravos.lyric-rhythm ; label: Lyrics → Rhythm ; domain: music ; category: voice-and-words (shown as Voice & samples)
  purpose: type the words — they become a rhythm (drums) or a melody line in key, on the beat.
ports:
  in:  transport (ticks) · theory (song key)
  out: note_out (note:trigger to the wired instrument, else the chosen one, else the first Drum Machine / synth)
       ui:clip_add:<timeline> (a note clip: {kind:'notes', target, startBar, bars, name, notes:[{s,l,n,v}]})
params: text (hidden; the lyrics box) · flow [spoken, on-beat chant, syncopated, rap triplets, dancehall, ballad] ·
  mode [drums, melody] · bars (0 = fit) · vary (seed) · octave · range · gate · target (hidden) · level
behaviour:
  - syllables: lexicon first (~150 words with stress), else rules: vowel groups (y after a consonant), silent e,
    consonant+le, -ed/-es that add no syllable, V-CV / VC-CV cuts; one-syllable function words are weak
  - stress: lexicon CAPS · two+ syllables → first unless a light prefix (re-, be-, a-, to-, for-…) · -tion/-sion →
    the syllable before · CAPS word or a following "!" → accent
  - flows place syllables in 16ths (fractional for triplets); a line end rests to the next half bar (ballad: bar)
  - playback: on each transport 16th, syllables starting inside it fire at their exact time
  - drums: strong → kick (beats 1,3) / snare (2,4) · accent adds clap · weak → hat · weak phrase end → perc
  - melody: stress steps up, weak wanders, questions rise at the line end, statements come home to degree 1
  - edits: click a syllable to cycle weak/strong/accent, drag to nudge (kept with the project)
packs: ships [flows] — Spoken word · Chant · Syncopated hook · Rap triplets · Dancehall chat · Ballad line · Sung hook
acceptance (tests/p20-lyric-rhythm.test.js): syllable counts and stress on a fixed word list · same input → same grid ·
  ticks send notes at the placed steps to the target · the Timeline accepts the clip

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo, music.key]   # ui expansion when added: Audio engine · Transport · Tempo · Song key
  services:
    - audio: Audio engine — shares the audio clock
    - clock: Master clock & tempo — locks to the beat
    - key: Song key & scale — plays in key
  inputs:
    - lyr.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
    - lyr.hook.theory_in (theory:key-change) — ambient broadcast
  outputs:
    - lyr.hook.note_out (note:trigger)
    - lyr.hook.clip_out (ui:clip_add)
    - lyr.hook.seq_out (seq:pattern_suggest|ui:chain_edit|ui:slot_select|ui:config_change)
  permissions: [bus_publish, bus_subscribe, registry_read]
  works_with: [eravos.pads, eravos.supersaw, eravos.retro-poly, eravos.timeline, eravos.embodiment-lab, eravos.arp, eravos.coven, eravos.organ]
