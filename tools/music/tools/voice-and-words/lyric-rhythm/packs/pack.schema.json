{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.lyric-rhythm/packs/pack.schema.json",
  "title": "Packs for Lyrics → Rhythm — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.lyric-rhythm",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.lyric-rhythm": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "flow": {
                        "enum": [
                          "spoken",
                          "on-beat chant",
                          "syncopated",
                          "rap triplets",
                          "dancehall",
                          "ballad"
                        ]
                      },
                      "mode": {
                        "enum": [
                          "drums",
                          "melody"
                        ]
                      },
                      "bars": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 32
                      },
                      "vary": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 999
                      },
                      "octave": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 7
                      },
                      "range": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 10
                      },
                      "gate": {
                        "type": "number",
                        "minimum": 0.2,
                        "maximum": 1
                      },
                      "target": {
                        "type": "string"
                      },
                      "level": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "songGenre": {
                        "enum": [
                          "darkwave",
                          "synthwave",
                          "witch-house",
                          "house",
                          "techno",
                          "future-bass",
                          "melodic",
                          "dubstep",
                          "riddim",
                          "dnb",
                          "neuro",
                          "trap"
                        ]
                      },
                      "_react": {},
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
