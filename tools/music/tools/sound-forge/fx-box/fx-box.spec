# spec_id: eravos.organism.fx-box · version 1.0.0 · phase P8.3 · status canonical
# source: v10 synths laser, pew, zap, riser, drop, scream, glitch, vinyl, eerie_scrape, bounceL/R, ricochet
identity:
  id: eravos.fx-box ; label: FX Box ; icon: 💥 ; accent: "#ff44aa"
  comp_intent: Twelve playable one-shot sound effects for transitions and ear candy, each tweakable.
  novelty: Only SFX designer — parameterised one-shots (length/pitch/bounce) rather than instruments; tempo-lengthed.
engine:
  slots 12, each one algorithm with 3 macro params (A/B/C) + length (seconds or bars) + pitch:
    laser (exp sine sweep) · pew (FM down-chirp) · zap (noise+saw burst, BP sweep) · riser (noise+saw, bars) · downer (inverse) · impact (sub boom + crash) ·
    scream (BP noise, resonant sweep) · glitch (micro-burst train) · vinyl (crackle+hiss bed) · scrape (eerie comb-filtered noise drag) ·
    bounce (decaying ping chain, L→R ricochet with pan per bounce) · ricochet (pitch up-slam, echo reflections)
  triggering: pads (click), note:trigger (note 36+i), pad:trigger passthrough
  tempo: length unit bars → seconds via BPM at trigger time
config: per slot {algorithm, A, B, C, length, lengthUnit [s, bars], pitch −24..24, level, pan}
presets: Transition Kit, Sci-fi, Ear Candy, Build Tools
hooks: STD.audio_out ; STD.note_in ; STD.midi_in ; STD.transport_in
ui: 12 pads (4×3) with algorithm glyphs ; selected slot editor: A/B/C knobs labelled per algorithm, length, pitch ; mini waveform of last render
tests: every algorithm non-silent ; riser 2 bars @120 lasts 4.0 s ± 10 ms ; bounce pans alternate sign per bounce

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo, music.meter, music.midi]   # ui expansion when added: Audio engine · Transport · Tempo · Master meter · MIDI button
  services:
    - audio: Audio engine — makes sound
    - clock: Master clock & tempo — locks to the beat
    - midi: MIDI input — plays from a controller (arm with the MIDI button)
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
  inputs:
    - box.hook.note_in (note:trigger)
    - box.hook.midi_in (midi:note) — ambient broadcast
    - box.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
  outputs:
    - box.hook.audio_out (audio · port out)
    - box.hook.bank_out (pad:bank-change)
  permissions: [audio_out, midi_in, bus_publish, bus_subscribe]
  works_with: [eravos.sequencer, eravos.timeline, eravos.midi-mapper, eravos.ratio-lattice, eravos.lyric-rhythm]
