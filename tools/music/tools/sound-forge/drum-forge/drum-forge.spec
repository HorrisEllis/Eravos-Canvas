# spec_id: eravos.organism.drum-forge · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.drum-forge ; label: Drum Forge ; icon: ⚒ ; accent: "#ff7b00" ; category: Sound Forge
  comp_intent: Design your own drum-pad sounds: 16 synthesized one-shots, gated 80s room, genre kits — render a WAV or the whole kit for your pads.
  engine_notes: |
    Design drum-pad sounds instead of picking them. 16 slots, each a synthesized one-shot built from one voice model
    (kick, 808, snare, gated '84 snare, clap, closed / open hat, ride, crash, tom-syndrum, rim, FM perc with any —
    often irrational — ratio, metal bar, zap, laser, riser, downlifter, impact, vinyl crackle) and the same handful
    of shaping controls. A shared GATED room gives the 80s gated reverb per slot. Plays from notes 36–51 (and the
    StarryPad through MIDI Map). Every voice is a pure function of (context, slot, time) so the same code renders
    offline: one slot → WAV, or the whole kit → a ZIP of 16 WAVs for any sampler / pad controller, or straight onto
    a Drum Machine pad / Sample Player. Kits: dancehall, roots one-drop, dubstep, riddim, synthwave '84, witch house,
    industrial goth, xen percussion.
config:
  kit: enum ["Dancehall · Bun Dem", "Roots · One Drop", "Dubstep · Heavy", "Riddim · Stripped", "Synthwave '84", "Witch House", "Industrial Goth", "Xen Percussion (φ, π, √2)"] def "Dancehall · Bun Dem"   # KIT · Kit
  sel: integer 0..15 def 0   # KIT · Slot
  room: number 0..1 def 0.6   # KIT · Gated room
  volume: number 0..1.5 def 0.9   # KIT · Volume
  sendTo: string def ""   # KIT · Send to
presets: ["Dancehall · Bun Dem", "Roots · One Drop", "Dubstep · Heavy", "Riddim · Stripped", "Synthwave '84", "Witch House", "Industrial Goth", "Xen Percussion (φ, π, √2)"]
ui_hooks: [hit, slot_edit, render, render_kit, send, preview] + standard
tests: standard_tests + see tests/p14.test.js

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.meter, music.midi]   # ui expansion when added: Audio engine · Master meter · MIDI button
  services:
    - audio: Audio engine — makes sound
    - midi: MIDI input — plays from a controller (arm with the MIDI button)
    - mod: 4 modulation inputs — LFO / XY / Macro can move them
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
    - assets: Clip output — renders sounds other tools can load
  inputs:
    - df.hook.note_in (note:trigger)
    - df.hook.midi_in (midi:note) — ambient broadcast
    - knob.kit (modulation · port mod.knob.kit)
    - knob.sel (modulation · port mod.knob.sel)
    - knob.room (modulation · port mod.knob.room)
    - knob.volume (modulation · port mod.knob.volume)
  outputs:
    - df.hook.audio_out (audio · port out)
    - df.hook.asset_out (asset:ready)
    - df.hook.pad_trigger_out (pad:trigger)
    - df.hook.bank_out (pad:bank-change)
  permissions: [audio_out, midi_in, bus_publish, bus_subscribe, filesystem_write, registry_read]
  works_with: [eravos.sequencer, eravos.midi-mapper, eravos.pads, eravos.dub-station, eravos.harmonic-analyzer, eravos.bass-drop-builder, eravos.song-recorder, eravos.timeline]
  notes:
    - Pads 1–16 = notes 36–51; the StarryPad plays it through MIDI Map.
