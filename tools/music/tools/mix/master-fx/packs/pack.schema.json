{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.master-fx/packs/pack.schema.json",
  "title": "Packs for Master — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.master-fx",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.master-fx": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "reverbMix": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "size": {
                        "type": "number",
                        "minimum": 0.3,
                        "maximum": 8
                      },
                      "decay": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 8
                      },
                      "predelay": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.2
                      },
                      "damping": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "freeze": {
                        "type": "boolean"
                      },
                      "shimmer": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "delayMix": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "delayDiv": {
                        "enum": [
                          "1/4",
                          "1/8",
                          "1/8.",
                          "1/16",
                          "3/16",
                          "1/4t"
                        ]
                      },
                      "feedback": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.95
                      },
                      "tone": {
                        "type": "number",
                        "minimum": 500,
                        "maximum": 12000
                      },
                      "width": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "compThresh": {
                        "type": "number",
                        "minimum": -40,
                        "maximum": 0
                      },
                      "compRatio": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 20
                      },
                      "compAttack": {
                        "type": "number",
                        "minimum": 0.001,
                        "maximum": 0.1
                      },
                      "compRelease": {
                        "type": "number",
                        "minimum": 0.02,
                        "maximum": 1
                      },
                      "makeup": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 12
                      },
                      "ceiling": {
                        "type": "number",
                        "minimum": -6,
                        "maximum": 0
                      },
                      "djFilter": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "outGain": {
                        "type": "number",
                        "minimum": -24,
                        "maximum": 6
                      },
                      "target": {
                        "enum": [
                          "-14",
                          "-8",
                          "custom"
                        ]
                      },
                      "customTarget": {
                        "type": "number",
                        "minimum": -30,
                        "maximum": -4
                      },
                      "_react": {}
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
