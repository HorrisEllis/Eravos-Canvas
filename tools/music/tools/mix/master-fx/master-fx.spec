# ============================================================
# ERAVOS ORGANISM SPEC — MASTER SECTION
# spec_id:      eravos.organism.master-fx
# version:      2.0.0
# phase:        P3
# resolves:     F-04, F-17
# status:       canonical
# ============================================================

identity:
  id: eravos.master-fx ; label: Master ; icon: ✦ ; accent: "#aa44ff"
  comp_intent: >
    Control surface for the kernel master chain and shared FX
    returns, with the metering a finished track needs: peak, RMS,
    momentary/short-term LUFS and gain reduction.
  novelty: >
    Only organism that controls kernel-owned nodes (via kernel
    setters) and measures loudness. Singleton: second instance
    mounts read-only (MOUNT_006 warning, non-blocking).

engine:
  controls kernel via: setReverb, setDelay, setCompressor, setLimiter, setDJFilter
  delay sync: time = MusicTheory.divisionSec(div, bpm); recomputed on bpm change
  loudness: K-weighting on a tap of audio.output (HS +4 dB @1681 Hz, HP 38 Hz, Q 0.5) → mean square
            momentary 400 ms, short-term 3 s; LUFS = −0.691 + 10·log10(Σ channels ms); integrated gated (−70 abs, −10 rel) while transport plays
  targets: streaming −14, club −8, reference (user)
  GR: compressor.reduction read ≤ 30 Hz

config:
  reverbMix 0..1 def 0.25 ; size 0.3..8 s def 2.2 ; decay 1..8 def 3 ; predelay 0..0.2 def 0.02 ; damping 0..1 def 0.5
  delayMix 0..1 def 0.2 ; delayDiv enum [1/4,1/8,1/8.,1/16,3/16,1/4t] def 1/8. ; feedback 0..0.95 def 0.35 ; tone 500..12000 def 4000 ; width 0..1 def 0.8
  compThresh −40..0 def −12 ; compRatio 1..20 def 2 ; compAttack 0.001..0.1 def 0.01 ; compRelease 0.02..1 def 0.2 ; makeup 0..12 dB def 0
  ceiling −6..0 dB def −1 ; djFilter −1..1 def 0 ; outGain −24..6 dB def 0 ; target enum [−14, −8, custom]

hooks:
  - mfx.hook.transport_in STD.transport_in (bpm, integrated gating)
  - mfx.hook.mod_dj       STD.mod_in(djFilter)    # LFO/XY/macro can sweep the DJ filter
  - mfx.hook.mod_revmix   STD.mod_in(reverbMix)
  - mfx.hook.loudness_out: out ; event_bus ; master:loudness {momentary, shortTerm, integrated, truePeakDb} ≤ 10 Hz

ui:
  columns: SPACE (reverb) | ECHO (delay, division ladder) | GLUE (comp + GR needle) | OUT (ceiling, DJ filter big knob, out gain)
  meter bridge: stereo peak/RMS bars, LUFS M/S/I readouts, target line, "too loud / on target / quiet" plain-language status
  ui_hooks: [standard_ui_hooks, ui:loudness_reset]

tests:
  - standard_tests (audio via master chain)
  - compThresh −30 on −6 dBFS sine → GR > 5 dB on dry signal (proves F-04 fixed)
  - delayDiv 1/8 at 120 BPM → kernel delay time 0.25 s
  - 1 kHz sine at −20 dBFS (stereo) → momentary ≈ −20 LUFS ± 0.5 (K-weight gain @1k ≈ 0)
  - djFilter +1 → HPF > 1 kHz ; −1 → LPF < 500 Hz ; 0 → neutral
  - second instance → read-only flag, no duplicate setters fire

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo]   # ui expansion when added: Audio engine · Transport · Tempo
  services:
    - audio: Audio engine — listens to sound
    - clock: Master clock & tempo — locks to the beat
    - mod: 2 modulation inputs — LFO / XY / Macro can move them
  inputs:
    - mfx.hook.audio_in (audio · port in)
    - mfx.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
    - mfx.hook.mod_dj (modulation · port mod.djFilter)
    - mfx.hook.mod_revmix (modulation · port mod.reverbMix)
  outputs:
    - mfx.hook.loudness_out (master:loudness)
  permissions: [audio_out, audio_in, bus_publish, bus_subscribe]
  works_with: []
