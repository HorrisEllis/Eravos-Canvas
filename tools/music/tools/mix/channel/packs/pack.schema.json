{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.channel/packs/pack.schema.json",
  "title": "Packs for Channel — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.channel",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.channel": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "trim": {
                        "type": "number",
                        "minimum": -24,
                        "maximum": 24
                      },
                      "hpf": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 400
                      },
                      "phase": {
                        "type": "boolean"
                      },
                      "low": {
                        "type": "number",
                        "minimum": -15,
                        "maximum": 15
                      },
                      "midFreq": {
                        "type": "number",
                        "minimum": 200,
                        "maximum": 6000
                      },
                      "midQ": {
                        "type": "number",
                        "minimum": 0.3,
                        "maximum": 6
                      },
                      "mid": {
                        "type": "number",
                        "minimum": -15,
                        "maximum": 15
                      },
                      "high": {
                        "type": "number",
                        "minimum": -15,
                        "maximum": 15
                      },
                      "drive": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "sendRev": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "sendDel": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "pan": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "fader": {
                        "type": "number",
                        "minimum": -60,
                        "maximum": 6
                      },
                      "mute": {
                        "type": "boolean"
                      },
                      "solo": {
                        "type": "boolean"
                      },
                      "_react": {}
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
