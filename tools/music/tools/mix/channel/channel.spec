# ============================================================
# ERAVOS ORGANISM SPEC — CHANNEL STRIP
# spec_id:      eravos.organism.channel
# version:      2.0.0
# phase:        P3
# resolves:     F-09
# status:       canonical
# ============================================================

identity:
  id: eravos.channel ; label: Channel ; icon: 🎚 ; accent: "#6a88a8"
  comp_intent: >
    Real mixer channel: any audio out wired into it is trimmed,
    EQ'd, panned, faded, metered and sent to the shared reverb/delay.
  novelty: >
    Only organism with an audio IN port, solo-in-place across
    instances, and true dBFS metering.

engine:
  graph: in → trim → HPF(18 dB, off..400 Hz) → EQ[lowshelf 120 Hz, peaking(freq,Q), highshelf 8 kHz] → drive(tanh, 0..1) → pan(StereoPanner) → fader → muteGain → out
         post-fader: → sendRev(Gain) → kernel reverbSend ; → sendDel(Gain) → kernel delaySend
         post-fader tap → Splitter → analyser L/R (fftSize 1024)
  meter: peak = max|x| per frame, rms over 300 ms, dBFS = 20·log10; peak hold 1.5 s; clip LED at ≥ −0.1 dBFS latched until clicked
  solo (solo-in-place): bus mixer:solo {instanceId, on}; every channel keeps soloSet; effective mute = mute || (soloSet.size > 0 && !soloSet.has(self))
  fader law: dB scale −inf..+6 dB, 0 dB at 75% travel
  name: user-editable; colour follows the first wired source's accent

config:
  name string def 'CH n' ; trim −24..24 dB def 0 ; hpf 0..400 Hz def 0 (0 = bypass)
  low −15..15 dB ; midFreq 200..6000 def 1000 ; midQ 0.3..6 def 1 ; mid −15..15 ; high −15..15
  drive 0..1 def 0 ; pan −1..1 def 0 ; fader −60..6 dB def 0 (−60 = −inf)
  sendRev 0..1 def 0 ; sendDel 0..1 def 0 ; mute bool ; solo bool ; phase bool (invert)

hooks:
  - ch.hook.audio_in:   in ; audio ; port in ; 2.0.0
  - ch.hook.audio_out   STD.audio_out
  - ch.hook.solo_io:    inout ; event_bus ; mixer:solo {instanceId, on}
  - ch.hook.mod_pan     STD.mod_in(pan)
  - ch.hook.mod_fader   STD.mod_in(fader) → fader gain (linear range 0..2)

ui:
  vertical strip: name (click-edit) ; input source label ; HPF knob ; 3-band EQ knobs + mini EQ curve ; drive ; sends ; pan ; big fader with dB scale ; stereo meter with peak hold + clip LED ; M / S / Ø buttons
  ui_hooks: [standard_ui_hooks, ui:clip_reset]
  org_hooks: [org:meter {peakL, peakR, rmsL, rmsR, holdL, holdR, clip}, org:source {label, accent}]

raises_faults: [PORT_001, RUNTIME_002]

tests:
  - standard_tests (non-silent test uses an oscillator wired into audio_in)
  - 0.5-amplitude sine → peak −6.02 dBFS ± 0.1
  - fader −6 dB → output −6 dB ± 0.05
  - solo A → B, C effective mute; un-solo restores
  - sendRev 1 → signal present at kernel reverbSend
  - unmount → upstream source rerouted to master (kernel K-12)

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.meter]   # ui expansion when added: Audio engine · Master meter
  services:
    - audio: Audio engine — processes sound
    - mod: 2 modulation inputs — LFO / XY / Macro can move them
  inputs:
    - ch.hook.audio_in (audio · port in)
    - ch.hook.solo_io (mixer:solo)
    - ch.hook.mod_pan (modulation · port mod.pan)
    - ch.hook.mod_fader (modulation · port mod.fader)
  outputs:
    - ch.hook.audio_out (audio · port out)
    - ch.hook.solo_io (mixer:solo)
  permissions: [audio_out, audio_in, bus_publish, bus_subscribe]
  works_with: []
