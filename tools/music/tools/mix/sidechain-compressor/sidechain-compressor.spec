# ============================================================
# ERAVOS ORGANISM SPEC — SIDECHAIN (volume shaper)
# spec_id:      eravos.organism.sidechain-compressor
# version:      2.0.0
# phase:        P3
# resolves:     F-05
# status:       canonical
# ============================================================

identity:
  id: eravos.sidechain-compressor ; label: Sidechain ; icon: 〽 ; accent: "#ffaa00"
  comp_intent: >
    The EDM pump. Ducks whatever is wired through it (or the whole
    master) on every kick, sample-accurately, using the trigger's
    scheduled audio time rather than listening after the fact.
  novelty: >
    Only organism that is an audio insert AND a scheduled-curve
    generator; drawable duck shape; two trigger sources (events or tempo).

engine:
  target:
    insert: in → duckGain → out (wire channels/instruments through it)
    master: calls kernel audio.duckAt(t, shape) — ducks entire master incl. FX tails
  triggers:
    event: pad:trigger / note:trigger / seq:fire whose sound or target matches source → duck at payload.time
    tempo: transport:tick on every division (1/4, 1/8, 1/2) → duck at tick.time
  shape: breakpoints over one duck period (normalized 0..1 time, 0..1 gain), default = attack 5 ms → hold → exponential release
         applied with setValueCurveAtTime (Float32Array 128 points, scaled to release length)
  overlap: new duck cancels scheduled values after t, starts from current computed value (no clicks)

config:
  target: enum [insert, master] def insert
  triggerMode: enum [event, tempo] def tempo
  source: string def 'kick' (sound name or instanceId)
  division: enum [1/2, 1/4, 1/8] def 1/4
  depth 0..1 def 0.8 ; attack 0..50 ms def 3 ; hold 0..200 ms def 10 ; release 20..1000 ms def 220 ; curve 0..1 (tension) def 0.6
  enabled bool def true

hooks:
  - sc.hook.audio_in:  in ; audio ; port in
  - sc.hook.audio_out  STD.audio_out
  - sc.hook.trig_in:   in ; event_bus ; pad:trigger | seq:fire | note:trigger (filtered)
  - sc.hook.transport_in STD.transport_in
  - sc.hook.duck_out:  out ; mod ; port env  # the duck envelope as a mod signal (pump other params)

presets: [Classic 1/4 Pump, Subtle Glue, Hard Gate 1/8, Half-time 1/2, Kick-triggered]

ui:
  hero: shape editor — curve drawn over one beat, draggable breakpoints, live playhead dot synced to ducks
  gain-reduction meter (reads duckGain.gain value via analyser of env port)
  controls: target, trigger mode/source/division, depth/attack/hold/release/curve
  ui_hooks: [standard_ui_hooks, ui:shape_edit {points}, ui:test_duck]

tests:
  - standard_tests
  - tempo 1/4 at 120 BPM: ducks at t0, t0+0.5, t0+1.0 (± 1 sample)
  - depth 0.8: gain at t+attack = 0.2 ± 1e-3
  - master target: reverb return attenuated during duck
  - overlapping trigger mid-release: no discontinuity > 0.01

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo, music.meter]   # ui expansion when added: Audio engine · Transport · Tempo · Master meter
  services:
    - audio: Audio engine — processes sound
    - clock: Master clock & tempo — locks to the beat
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
  inputs:
    - sc.hook.audio_in (audio · port in)
    - sc.hook.trig_in (pad:trigger|seq:fire|note:trigger)
    - sc.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
  outputs:
    - sc.hook.audio_out (audio · port out)
    - sc.hook.duck_out (modulation · port env)
  permissions: [audio_out, audio_in, bus_publish, bus_subscribe]
  works_with: []
