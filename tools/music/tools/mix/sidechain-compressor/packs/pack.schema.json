{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.sidechain-compressor/packs/pack.schema.json",
  "title": "Packs for Sidechain — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.sidechain-compressor",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.sidechain-compressor": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "target": {
                        "enum": [
                          "insert",
                          "master"
                        ]
                      },
                      "mode": {
                        "enum": [
                          "duck",
                          "step"
                        ]
                      },
                      "triggerMode": {
                        "enum": [
                          "event",
                          "tempo"
                        ]
                      },
                      "source": {
                        "type": "string"
                      },
                      "division": {
                        "enum": [
                          "1/2",
                          "1/4",
                          "1/8"
                        ]
                      },
                      "depth": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "attack": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 50
                      },
                      "hold": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 200
                      },
                      "release": {
                        "type": "number",
                        "minimum": 20,
                        "maximum": 1000
                      },
                      "curve": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "shapeLength": {
                        "enum": [
                          "1 beat",
                          "1 bar"
                        ]
                      },
                      "steps": {},
                      "smoothing": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 60
                      },
                      "enabled": {
                        "type": "boolean"
                      },
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
