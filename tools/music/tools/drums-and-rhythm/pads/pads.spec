# ============================================================
# ERAVOS ORGANISM SPEC — DRUM MACHINE
# spec_id:      eravos.organism.pads
# version:      2.0.0   (supersedes 1.0.0)
# phase:        P2
# conforms_to:  ERAVOS.kernel.spec + amendment-3.1 + eravos.runtime.music
# resolves:     F-11(drums), F-15
# status:       canonical
# ============================================================

identity:
  id: eravos.pads ; label: Drum Machine ; icon: 🥁 ; accent: "#00ff88"
  comp_intent: >
    Sixteen velocity-sensitive pads in four banks, each pad a
    synthesised voice OR a loaded sample, mixed internally and
    emitted through one audio port.
  novelty: >
    Only organism with per-pad voice graphs, choke groups and a
    per-pad internal mixer. Voices are real analogue-model designs,
    not shared oscillator templates.

permissions: [audio_out, midi_in, bus_publish, bus_subscribe, filesystem_read]
provides:    [capability.pad_trigger, capability.audio_out, capability.bank_select, capability.note_in]
requires:    [capability.audio_context]

voices:   # each a distinct graph — no two share topology
  kick:     sine body, pitch env (start 4×→1× over pitchDecay), click transient (HP noise 3 ms), tanh drive
  snare:    two detuned triangles (180/330 Hz) + BP noise, separate tone/noise envelopes
  hat:      six square oscillators at 808 ratios → BP 10 kHz → HP 7 kHz, decay 40 ms
  openhat:  same metal source, decay 400 ms, choke group 1 with hat
  clap:     4 BP-noise bursts 10 ms apart + diffuse tail 120 ms
  808:      sine with glide-from-previous, saturation, long decay, note-tracked
  rim:      short BP 1.7 kHz ping + 400 Hz triangle click
  tom:      sine pitch-drop, note-tracked
  crash:    metal source + noise, 1.8 s, HP 5 kHz
  perc:     FM pair (ratio 1.41) plink
  shaker:   HP noise with 2-stage envelope
  cowbell:  two squares 540/800 Hz → BP
  sample:   AudioBuffer voice (loaded per pad), start/end, reverse copy, tune
pad_params: [voice, tune(st −24..24), decay(0.05..4 s), level(0..1.5), pan(−1..1), drive(0..1), choke(0..4), color]
banks:      4 × 16 pads (constraint pads.C-2 amended P9: bank D future/Monstercat; 3-bank snapshots restore with D appended)

hooks:
  - pads.hook.audio_out      STD.audio_out
  - pads.hook.pad_trigger_out:  out ; event_bus ; pad:trigger ; schema {index, sound, velocity, bank, time, source:'pads'} ; 2.0.0
  - pads.hook.bank_change_out:  out ; pad:bank-change ; {bank, pads:[{sound,color,note}]} ; 1.0.0
  - pads.hook.note_in        STD.note_in   # note 36+i → pad i (sequencer drum lanes)
  - pads.hook.midi_in        STD.midi_in   # 36..51
  - pads.hook.seq_fire_in:    in ; seq:fire ; light only
  - pads.hook.mod_level      STD.mod_in(level)   # internal mix bus gain

config:
  bank:    enum [0,1,2] default 0
  volume:  number 0..1.5 default 0.9
  swingVel: number 0..1 default 0   # velocity humanise
  keymap:  boolean default true     # QWERTY map only while window focused (F-15)

ui:
  layout: 4×4 pad grid ; bank strip ; selected-pad inspector (voice select, 6 knobs, choke, color) ; output meter
  velocity: vertical press position in pad (top = 1.0, bottom = 0.35)
  drop: audio file onto a pad → loads as sample voice (ASSET_001/002 on failure)
  ui_hooks: [ui:pad_press {index, velocity}, ui:bank_select {bank}, ui:pad_edit {index, key, value}, ui:pad_load {index, arrayBuffer, name}, standard_ui_hooks]
  org_hooks: [org:pad_lit {index, color}, standard]

exports: [json banks ; samples embedded as asset hashes via Workspace]
raises_faults: [MOUNT_002, MOUNT_005, RUNTIME_002, RUNTIME_003, ASSET_001, ASSET_002]

tests:
  - standard_tests
  - note 36 → pad 0, note 51 → pad 15, note 52 → ignored
  - choke: hat at t+0.1 cuts openhat started at t (gain < −60 dB by t+0.105)
  - keymap inactive when window unfocused
  - pad load sample → sample voice plays buffer, reverse produces reversed copy
  - bank change emits 16 pads with note field

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.meter, music.midi]   # ui expansion when added: Audio engine · Master meter · MIDI button
  services:
    - audio: Audio engine — makes sound
    - midi: MIDI input — plays from a controller (arm with the MIDI button)
    - mod: 5 modulation inputs — LFO / XY / Macro can move them
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
    - files: Your files — drop audio / MIDI on it
  inputs:
    - pads.hook.note_in (note:trigger)
    - pads.hook.midi_in (midi:note) — ambient broadcast
    - pads.hook.seq_fire_in (seq:fire)
    - pads.hook.mod_level (modulation · port mod.level)
    - knob.bank (modulation · port mod.knob.bank)
    - knob.volume (modulation · port mod.knob.volume)
    - knob.swingVel (modulation · port mod.knob.swingVel)
    - knob.keymap (modulation · port mod.knob.keymap)
  outputs:
    - pads.hook.audio_out (audio · port out)
    - pads.hook.pad_trigger_out (pad:trigger)
    - pads.hook.bank_change_out (pad:bank-change)
  permissions: [audio_out, midi_in, bus_publish, bus_subscribe, filesystem_read]
  works_with: [eravos.timeline, eravos.sequencer, eravos.arp, eravos.bass-gen, eravos.chord-gen, eravos.groove-gen, eravos.midi-mapper, eravos.sample-player]
