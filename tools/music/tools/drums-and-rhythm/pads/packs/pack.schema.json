{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.pads/packs/pack.schema.json",
  "title": "Packs for Drum Machine — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.pads",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.pads": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "bank": {
                        "enum": [
                          0,
                          1,
                          2,
                          3
                        ]
                      },
                      "volume": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.5
                      },
                      "swingVel": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "keymap": {
                        "type": "boolean"
                      },
                      "mods": {}
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
