{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.sequencer/packs/pack.schema.json",
  "title": "Packs for Sequencer — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.sequencer",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.sequencer": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "length": {
                        "enum": [
                          8,
                          12,
                          16,
                          24,
                          32,
                          48,
                          64
                        ]
                      },
                      "swing": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.75
                      },
                      "slot": {
                        "enum": [
                          "A",
                          "B",
                          "C",
                          "D",
                          "E",
                          "F",
                          "G",
                          "H"
                        ]
                      },
                      "chainOn": {
                        "type": "boolean"
                      },
                      "recordMode": {
                        "enum": [
                          "off",
                          "overdub",
                          "replace"
                        ]
                      },
                      "view": {
                        "enum": [
                          "grid",
                          "paint"
                        ]
                      },
                      "fill": {
                        "type": "boolean"
                      },
                      "humanize": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "seed": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9999
                      },
                      "_react": {},
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
