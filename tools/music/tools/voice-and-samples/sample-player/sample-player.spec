# ============================================================
# ERAVOS ORGANISM SPEC — SAMPLE PLAYER / CHOPPER
# spec_id:      eravos.organism.sample-player
# version:      2.0.0   (supersedes 1.0.0)
# phase:        P2
# resolves:     F-13
# status:       canonical
# ============================================================

identity:
  id: eravos.sample-player ; label: Sample ; icon: 🎵 ; accent: "#aa44ff"
  comp_intent: >
    Load one audio file (Raven's voice clips are the primary use),
    play it whole, chromatically, or chopped into slices that can
    be fired from pads, the sequencer, or the keyboard.
  novelty: >
    Only organism with transient-detected slicing and a buffer-domain
    engine (reverse, fades, time-stretch-free repitch). Waveform is
    the whole interface.

permissions: [audio_out, bus_publish, bus_subscribe, filesystem_read]
provides:    [capability.audio_out, capability.sample_source, capability.note_in]

modes:
  oneshot:  trigger plays start→end, ignores note-off
  gate:     plays while held, amp release on note-off
  loop:     loops between loopStart/loopEnd with crossfade (xfade ms)
  chromatic: note − root semitones → playbackRate
  slice:    N slices (auto transient | 4 | 8 | 16 | manual markers); note 36+i → slice i

engine:
  reverse: pre-computed reversed AudioBuffer copy (never negative playbackRate)
  playhead: position = start + elapsed × rate, reported ≤ 30 Hz
  voices: 8-voice polyphony, oldest-steal; each voice BufferSource → amp env → pan → out
  analysis on load: peaks(1024), transients (spectral flux, adaptive threshold), RMS, peak dBFS, duration

config:
  gain: 0..2 def 1 ; pitch: −24..24 st step 0.01 def 0 ; root: 0..127 def 60
  start: 0..1 def 0 ; end: 0..1 def 1 ; loopStart/loopEnd 0..1
  reverse: bool ; mode: enum above def oneshot ; slices: enum [auto,4,8,16,manual] def auto
  sensitivity: 0..1 def 0.4 ; attack 0..2 s def 0.002 ; release 0..4 s def 0.05 ; xfade 0..200 ms def 10
  padLink: enum [off, bank A, bank B, bank C] def off   # slices mirrored as pad:trigger listeners

hooks:
  - samp.hook.audio_out  STD.audio_out
  - samp.hook.note_in    STD.note_in
  - samp.hook.midi_in    STD.midi_in
  - samp.hook.trigger_in: in ; pad:trigger ; plays slice[index] when padLink matches bank
  - samp.hook.clip_in:    in ; timeline:clip_play ; plays from offset at time
  - samp.hook.mod_pitch  STD.mod_in(pitch) → playbackRate detune (cents, range ±2400)
  - samp.hook.asset_out:  out ; asset:ready {hash, name, duration} (timeline/pads may import)

ui:
  canvas waveform: drag start/end handles, loop handles, slice markers (add = dbl-click, remove = right-click)
  click slice → audition ; drag vertical on waveform → pitch
  footer: mode segmented, gain, pitch, attack, release, reverse, sensitivity
  ui_hooks: [ui:load {arrayBuffer, name}, ui:play_press, ui:stop_press, ui:scrub {position}, ui:slice_edit {op, position}, standard_ui_hooks]
  org_hooks: [org:waveform_ready {peaks, duration_sec, name, transients}, org:playhead_update {position_normalized}, org:slices {positions}]

raises_faults: [ASSET_001, ASSET_002, RUNTIME_002, RUNTIME_003]

tests:
  - standard_tests
  - reverse plays reversed samples (first output frame = last input frame ±1)
  - chromatic note root+12 → rate 2.0
  - slice mode 8: note 39 plays slice 3 bounds exactly
  - click train with 4 transients → auto slices = 4
  - playhead at pitch +12 advances 2× per second
  - undecodable file → ASSET_002, organism stays mounted

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.meter, music.midi]   # ui expansion when added: Audio engine · Master meter · MIDI button
  services:
    - audio: Audio engine — makes sound
    - midi: MIDI input — plays from a controller (arm with the MIDI button)
    - mod: 1 modulation input — LFO / XY / Macro can move them
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
    - files: Your files — drop audio / MIDI on it
    - assets: Clip output — renders sounds other tools can load
  inputs:
    - samp.hook.note_in (note:trigger)
    - samp.hook.midi_in (midi:note) — ambient broadcast
    - samp.hook.trigger_in (pad:trigger)
    - samp.hook.clip_in (timeline:clip_play)
    - samp.hook.mod_pitch (modulation · port mod.pitch)
    - samp.hook.asset_in (asset:ready)
  outputs:
    - samp.hook.audio_out (audio · port out)
    - samp.hook.asset_out (asset:ready)
  permissions: [audio_out, bus_publish, bus_subscribe, filesystem_read]
  works_with: [eravos.harmonic-analyzer, eravos.bass-drop-builder, eravos.song-recorder, eravos.timeline, eravos.pads, eravos.sequencer, eravos.bass-forge, eravos.drum-forge]
