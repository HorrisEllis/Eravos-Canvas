{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.clip-maker/packs/pack.schema.json",
  "title": "Packs for Clip Maker — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.clip-maker",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.clip-maker": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "snapZero": {
                        "type": "boolean"
                      },
                      "normalizeTarget": {
                        "type": "number",
                        "minimum": -24,
                        "maximum": 0
                      },
                      "normalizeMode": {
                        "enum": [
                          "peak",
                          "loudness"
                        ]
                      },
                      "silenceThresh": {
                        "type": "number",
                        "minimum": -60,
                        "maximum": -20
                      },
                      "minGap": {
                        "type": "number",
                        "minimum": 20,
                        "maximum": 2000
                      },
                      "fadeShape": {
                        "enum": [
                          "lin",
                          "exp",
                          "S"
                        ]
                      },
                      "source": {
                        "enum": [
                          "mic",
                          "input"
                        ]
                      },
                      "_react": {}
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
