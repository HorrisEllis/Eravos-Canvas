# spec_id: eravos.organism.clip-maker · version 1.0.0 · phase P8.5 · status canonical
# source: v10 CLIP MAKER (draw/load/record, selection, history, assign to pad)
identity:
  id: eravos.clip-maker ; label: Clip Maker ; icon: ✂ ; accent: "#00ff88"
  comp_intent: Cut, clean and shape audio clips — trim Raven's recordings to the exact word, fade, normalise, then send them to pads, sampler or timeline.
  novelty: Only destructive audio editor (sample-accurate selection edits with undo) — the clip factory feeding every other organism.
engine:
  buffer: AudioBuffer (stereo kept) ; history: undo/redo stack (≤ 50 states, stored as diffs of changed ranges)
  sources: drop/load file, record (mic via getUserMedia or in port), draw (pencil on zoomed-in waveform), paste
  ops on selection: cut, copy, paste, delete, crop, silence, gain (dB), normalise (peak/−1 dBFS or LUFS target), fade in/out (lin/exp/S), reverse, pitch-by-resample, remove DC, zero-crossing snap
  detection: transient markers ; silence split (threshold, min gap) → multiple clips
  tempo: detect BPM (onset autocorrelation) ; trim-to-bars (snap selection to whole bars at session BPM)
  export: WAV (via audio-recorder encoder) ; asset:ready (to pads/sample-player/timeline/granular)
config: snapZero bool def true ; normalizeTarget def −1 dBFS ; silenceThresh −60..−20 ; minGap ms ; fadeShape
hooks: clip.hook.audio_in (in ; audio ; port in — record) ; asset_out (out ; asset:ready {hash, name, duration}) ; STD.audio_out (audition) ; STD.transport_in (bars)
ui: hero = zoomable waveform (wheel zoom, drag select, shift-extend, markers) ; tool bar (select/draw/zoom) ; op buttons ; clip list (from silence split) with send-to menu
tests: cut then undo → buffer bit-identical ; normalise peak −1 → max|x| = 0.891 ± 1e-4 ; silence split on 3 words separated by 300 ms → 3 clips ; trim-to-bars 2 @120 → 4.000 s

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo, music.meter]   # ui expansion when added: Audio engine · Transport · Tempo · Master meter
  services:
    - audio: Audio engine — processes sound
    - clock: Master clock & tempo — locks to the beat
    - files: Your files — drop audio / MIDI on it
    - assets: Clip output — renders sounds other tools can load
  inputs:
    - clip.hook.audio_in (audio · port in)
    - clip.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
  outputs:
    - clip.hook.asset_out (asset:ready)
    - clip.hook.audio_out (audio · port out)
  permissions: [audio_out, audio_in, bus_publish, bus_subscribe, filesystem_read, filesystem_write]
  works_with: [eravos.harmonic-analyzer, eravos.bass-drop-builder, eravos.song-recorder, eravos.timeline, eravos.bass-forge, eravos.granular, eravos.contrast-analyser, eravos.sample-player]
