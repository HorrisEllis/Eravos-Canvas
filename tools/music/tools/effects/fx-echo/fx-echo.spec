# spec_id: eravos.organism.fx-echo · version 1.0.0 · phase P8.1 · status canonical
# source: v10 plugins/delay.json (shell, F-19) · inherits STD.fx
identity:
  id: eravos.fx-echo ; label: Tape Echo ; icon: ⌁ ; accent: "#00ff44"
  comp_intent: Insert echo with character — dub throws, tape wobble, vocal delays.
  novelty: Only FX modelling tape: wow/flutter on delay time, saturating feedback, head-age filter, and 'throw' momentary send.
engine:
  path: in → throwGate → delay (tempo-synced, dotted/triplet) → feedback loop [HP → LP(age) → tanh sat → wow/flutter LFOs on delayTime] → out ; stereo modes mono / ping-pong / offset (R = L × ratio)
  throw: momentary button/port opens throwGate for 1 division; tail rings out (dub throw)
  freeze: feedback → 1.0, input muted (loop the tail)
config: div enum [1/4,1/8,1/8.,1/16,1/4t,3/16,1/2] def 1/8. ; timeFree ms ; sync bool def true ; feedback 0..1.05 (>1 only with sat) def 0.45 ; age 0..1 ; wow 0..1 ; flutter 0..1 ; sat 0..1 ; stereo enum ; throwMode bool ; freeze bool ; STD mix
presets: Dub Throw, Slapback, Ping-pong 1/8., Worn Tape, Infinite Freeze
hooks: STD.fx ; echo.hook.throw_in (in ; event_bus ; fx:throw {target, time}) ; mod_feedback, mod_age STD.mod_in
ui: hero = echo train visualiser (decaying bars at repeat times, real levels from analyser) ; big THROW pad
tests: STD.fx ; 1/8 @120 → repeats every 0.25 s ± 1 sample ; feedback 1.05 with sat bounded < 0 dBFS ; throw passes exactly one division of input

