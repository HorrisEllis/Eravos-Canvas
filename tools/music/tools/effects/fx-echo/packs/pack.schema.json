{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.fx-echo/packs/pack.schema.json",
  "title": "Packs for Tape Echo — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.fx-echo",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.fx-echo": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "div": {
                        "enum": [
                          "1/4",
                          "1/8",
                          "1/8.",
                          "1/16",
                          "1/4t",
                          "3/16",
                          "1/2"
                        ]
                      },
                      "sync": {
                        "type": "boolean"
                      },
                      "timeFree": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 2000
                      },
                      "stereo": {
                        "enum": [
                          "mono",
                          "pingpong",
                          "offset"
                        ]
                      },
                      "offsetRatio": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2
                      },
                      "feedback": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.05
                      },
                      "age": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "wow": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "flutter": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "sat": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "throwMode": {
                        "type": "boolean"
                      },
                      "freeze": {
                        "type": "boolean"
                      },
                      "mix": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "inGain": {
                        "type": "number",
                        "minimum": -24,
                        "maximum": 24
                      },
                      "outGain": {
                        "type": "number",
                        "minimum": -24,
                        "maximum": 24
                      },
                      "bypass": {
                        "type": "boolean"
                      },
                      "_react": {}
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
