{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.fx-filter/packs/pack.schema.json",
  "title": "Packs for Filter — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.fx-filter",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.fx-filter": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "enum": [
                          "LP",
                          "HP",
                          "BP",
                          "notch"
                        ]
                      },
                      "slope": {
                        "enum": [
                          12,
                          24
                        ]
                      },
                      "cutoff": {
                        "type": "number",
                        "minimum": 20,
                        "maximum": 20000
                      },
                      "res": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 20
                      },
                      "drive": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "lfoAmt": {
                        "type": "number",
                        "minimum": -8,
                        "maximum": 8
                      },
                      "lfoShape": {
                        "enum": [
                          "sine",
                          "triangle",
                          "sawtooth",
                          "square"
                        ]
                      },
                      "lfoSync": {
                        "type": "boolean"
                      },
                      "lfoDiv": {
                        "enum": [
                          "1/1",
                          "1/2",
                          "1/4",
                          "1/8",
                          "1/16",
                          "1/4t",
                          "1/8t"
                        ]
                      },
                      "lfoRate": {
                        "type": "number",
                        "minimum": 0.01,
                        "maximum": 40
                      },
                      "envAmt": {
                        "type": "number",
                        "minimum": -8,
                        "maximum": 8
                      },
                      "envAttack": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2000
                      },
                      "envRelease": {
                        "type": "number",
                        "minimum": 5,
                        "maximum": 5000
                      },
                      "mix": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "inGain": {
                        "type": "number",
                        "minimum": -24,
                        "maximum": 24
                      },
                      "outGain": {
                        "type": "number",
                        "minimum": -24,
                        "maximum": 24
                      },
                      "bypass": {
                        "type": "boolean"
                      },
                      "_react": {}
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
