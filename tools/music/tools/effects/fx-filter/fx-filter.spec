# spec_id: eravos.organism.fx-filter · version 1.0.0 · phase P8.1 · status canonical
# source: v10 plugins/filter.json (shell, F-19) · inherits STD.fx
identity:
  id: eravos.fx-filter ; label: Filter ; icon: ⌇ ; accent: "#00ffaa"
  comp_intent: Auto-filter / wah / build sweeps on one sound (master sweep lives in master-fx).
  novelty: Only FX with three simultaneous cutoff drivers — manual, tempo LFO and envelope follower — summed in cents.
engine:
  filter: 12 or 24 dB (1–2 biquads) types LP/HP/BP/notch ; drive pre-filter (tanh)
  drivers → filter.detune (cents): manual cutoff ; LFO (division/Hz, shapes sine/tri/saw/square/S&H) ; envelope follower (in → abs → one-pole LP attack/release → gain → detune) sensitivity ±
config: type enum def LP ; slope [12, 24] def 24 ; cutoff 20..20000 def 1200 ; res 0.5..20 def 2 ; drive 0..1 ; lfoAmt −4..4 oct ; lfoShape ; lfoRate/div ; envAmt −4..4 oct def 0 ; envAttack 1..200 ms ; envRelease 10..1000 ms ; STD mix
presets: Auto-Wah (env +2 oct BP), Build HP 1/1, Wobble 1/8 LP, Tremble S&H 1/16, Telephone BP
hooks: STD.fx ; mod_cutoff STD.mod_in(cutoff → detune ±4800) ; mod_res
ui: hero = response curve (getFrequencyResponse) animated with real cutoff position from driver sum readout
tests: STD.fx ; LP 1 kHz 24 dB: −24 dB ± 2 at 2 kHz ; envAmt +2 oct with transient input raises cutoff then releases in envRelease ± 20%

