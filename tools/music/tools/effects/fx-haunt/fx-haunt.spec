# spec_id: eravos.organism.fx-haunt · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.fx-haunt ; label: Haunt ; icon: 👁 ; accent: "#9b8cff" ; category: Effects
  comp_intent: Screw it down, warble it like old tape, crackle it like vinyl, swell a reversed ghost into it. Witch house in one plug.
  engine_notes: |
    Make anything sound like a memory that is going wrong: SCREW (pitch down, chopped-and-screwed), cassette WARBLE
    (wow + flutter on a single moving tap — pitch wobble, no echo), TONE (open · underwater · radio · telephone ·
    séance), CRUSH (bit depth), VINYL (generated crackle + hiss riding the signal's level), and GHOST — a reverse-swell
    reverb: the impulse response is time-reversed so every sound is preceded by its own rising tail.
config:
  screw: number 0..12 st def 0   # TIME · Screw
  warble: number 0..1 def 0.3   # TIME · Warble
  wowRate: number 0.1..3 Hz def 0.55   # TIME · Wow
  tone: enum ["open", "underwater", "radio", "telephone", "séance"] def "open"   # COLOUR · Tone
  crush: number 0..1 def 0   # COLOUR · Crush
  vinyl: number 0..1 def 0.2   # COLOUR · Vinyl
  ghost: number 0..1 def 0.3   # GHOST · Ghost
  ghostLen: number 0.4..6 s def 2.2   # GHOST · Ghost length
  mix: number 0..1 def 0.8   # IO · Mix
  inGain: number -24..24 dB def 0   # IO · In
  outGain: number -24..24 dB def 0   # IO · Out
  bypass: boolean def false   # IO · Bypass
presets: ["Chopped & Screwed", "Haunted Cassette", "Witch Fog", "Séance Radio", "Reverse Ghost", "Telephone From Below"]
ui_hooks: [] + standard
tests: standard_tests + see tests/p14.test.js

