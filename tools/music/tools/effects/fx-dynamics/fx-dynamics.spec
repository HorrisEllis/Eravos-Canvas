# spec_id: eravos.organism.fx-dynamics · version 1.0.0 · phase P8.1 · status canonical
# source: v10 plugins/comp.json (shell, F-19) · inherits STD.fx
identity:
  id: eravos.fx-dynamics ; label: Dynamics ; icon: ⊓ ; accent: "#ff8800"
  comp_intent: Control punch and consistency on one sound — compress, gate, or parallel-smash.
  novelty: Only insert with a KEY input port (external sidechain audio) and an expander/gate stage before the compressor.
engine:
  gate/expander: AudioWorklet envelope detector (peak, attack/hold/release) → gain computer (range dB, ratio for expander) ; fallback DynamicsCompressor-free approximation disabled with notice
  compressor: DynamicsCompressorNode (threshold, ratio, knee, attack, release) + makeup ; key: when key port wired, detector reads key (worklet mode) — native node cannot key, so keyed mode uses worklet compressor
  parallel: mix = New York compression (dry + compressed)
config: gateOn bool ; gateThresh −80..0 ; gateRange 0..80 dB ; gateAttack/hold/release ; compOn bool ; thresh −60..0 def −18 ; ratio 1..20 def 4 ; knee 0..30 ; attack 0.1..100 ms ; release 10..1000 ms ; makeup 0..24 ; keyListen bool ; STD mix
presets: Punchy Drums, Vocal Level, Bass Glue, Tight Gate, NY Parallel Smash
hooks: STD.fx ; dyn.hook.key_in (in ; audio ; port key ; tap) ; gr_out (out ; mod ; port gr — gain reduction as signal)
ui: hero = scrolling level + GR history (in, out, GR lanes) ; static transfer curve with live dot
tests: STD.fx ; 4:1 at −18: input −6 dBFS → output −15 ± 0.5 (steady state) ; key wired: ducks on key signal while in is steady ; gate: −60 dBFS noise below thresh attenuated by range

