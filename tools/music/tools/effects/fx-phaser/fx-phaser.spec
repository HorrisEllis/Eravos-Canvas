# spec_id: eravos.organism.fx-phaser · version 1.0.0 · phase P8.1 · status canonical
# source: v10 plugins/phaser.json "12-stage phaser" (shell, F-19) · inherits STD.fx
identity:
  id: eravos.fx-phaser ; label: Phaser ; icon: ◈ ; accent: "#5533ff"
  comp_intent: Psychedelic sweeping notches — classic on pads, bass and vocals.
  novelty: Only FX built from a cascaded all-pass chain with feedback; notches move, pitch doesn't.
engine:
  chain: 2..12 BiquadFilter(allpass) stages (even counts), shared centre freq; LFO → each stage .detune (cents, log sweep)
  sweep range: minHz..maxHz mapped to detune span ; feedback path last stage → input (0..0.9) ; stereo: R channel LFO phase offset
config: stages enum [2,4,6,8,12] def 6 ; rate 0.01..8 Hz def 0.3 ; sync bool ; div ; minHz 100..2000 def 300 ; maxHz 500..12000 def 3000 ; feedback 0..0.9 def 0.5 ; stereo 0..180° def 90 ; Q 0.3..4 def 0.7 ; STD mix
presets: 70s Swirl, Deep 12-stage, Dubstep Sweep 1/8, Vocal Air, Stereo Spin
hooks: STD.fx ; mod_rate, mod_feedback STD.mod_in
ui: hero = live spectrum with notch positions overlaid (computed from stage freq, drawn on analyser output)
tests: STD.fx ; 6 stages → 3 notches visible in white-noise response ; feedback 0.9 stable 10 s (peak < 0 dBFS)

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.meter]   # ui expansion when added: Audio engine · Master meter
  services:
    - audio: Audio engine — processes sound
    - mod: 3 modulation inputs — LFO / XY / Macro can move them
  inputs:
    - fx.hook.audio_in (audio · port in)
    - fx.hook.mod_mix (modulation · port mod.mix)
    - ph.hook.mod_rate (modulation · port mod.rate)
    - ph.hook.mod_feedback (modulation · port mod.feedback)
  outputs:
    - fx.hook.audio_out (audio · port out)
  permissions: [audio_out, audio_in, bus_publish, bus_subscribe]
  works_with: []
