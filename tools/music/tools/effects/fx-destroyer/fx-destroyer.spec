# spec_id: eravos.organism.fx-destroyer · version 1.0.0 · phase P8.1 · status canonical
# source: v10 plugins/dist.json + bitcrush.json "8-BIT DESTROYER" (shells, F-19) · inherits STD.fx
identity:
  id: eravos.fx-destroyer ; label: Destroyer ; icon: 👾 ; accent: "#aaff00"
  comp_intent: Saturation to total destruction — warm tape, grit, fold, 8-bit crunch.
  novelty: Only FX with an AudioWorklet DSP stage (sample-rate reduction + bit depth), series non-linear chain.
engine:
  chain: pre-EQ tilt → SHAPER (tanh soft | hard clip | asymmetric tube | foldback via WaveShaper curve, 4× oversample) → CRUSHER worklet (bits 1..16 with TPDF option, downsample hold 1..64) → post LP (anti-harsh) → mix
  worklet: Blob-loaded (runtime precision-clock pattern) ; fallback: WaveShaper quantization only (downsample disabled, org:error notice)
  auto-level: shaper output compensated by curve RMS at drive setting
config: shape enum [soft, hard, tube, fold] def soft ; drive 0..1 def 0.3 ; bits 1..16 def 16 ; downsample 1..64 def 1 ; tilt −1..1 ; postLP 1000..20000 def 16000 ; STD mix
presets (from bitcrush/dist json): Tape Warm, Grit, Fold Growl, NES 8-bit, Lo-fi 12-bit 22k, Total Destruction
hooks: STD.fx ; mod_drive, mod_bits, mod_downsample STD.mod_in
ui: hero = transfer curve plot + before/after oscilloscope ; bit/downsample staircase preview
tests: STD.fx ; bits 1 → output ∈ {−1, +1}·level ; downsample 4 → each value held 4 samples ; fold drive 1 stays < 0 dBFS after auto-level

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.meter]   # ui expansion when added: Audio engine · Master meter
  services:
    - audio: Audio engine — processes sound
    - mod: 4 modulation inputs — LFO / XY / Macro can move them
  inputs:
    - fx.hook.audio_in (audio · port in)
    - fx.hook.mod_mix (modulation · port mod.mix)
    - dst.hook.mod_drive (modulation · port mod.drive)
    - dst.hook.mod_bits (modulation · port mod.bits)
    - dst.hook.mod_down (modulation · port mod.downsample)
  outputs:
    - fx.hook.audio_out (audio · port out)
  permissions: [audio_out, audio_in, bus_publish, bus_subscribe]
  works_with: []
