{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.fx-destroyer/packs/pack.schema.json",
  "title": "Packs for Destroyer — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.fx-destroyer",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.fx-destroyer": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "shape": {
                        "enum": [
                          "soft",
                          "hard",
                          "tube",
                          "fold",
                          "tape",
                          "fuzz",
                          "rectify"
                        ]
                      },
                      "drive": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "asym": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "autoGain": {
                        "type": "boolean"
                      },
                      "tight": {
                        "type": "number",
                        "minimum": 10,
                        "maximum": 600
                      },
                      "lowKeep": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 400
                      },
                      "bits": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16
                      },
                      "downsample": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 64
                      },
                      "alias": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "dither": {
                        "type": "boolean"
                      },
                      "tilt": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "postLP": {
                        "type": "number",
                        "minimum": 1000,
                        "maximum": 20000
                      },
                      "autoTame": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "mix": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "inGain": {
                        "type": "number",
                        "minimum": -24,
                        "maximum": 24
                      },
                      "outGain": {
                        "type": "number",
                        "minimum": -24,
                        "maximum": 24
                      },
                      "bypass": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
