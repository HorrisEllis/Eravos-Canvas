{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.tape-memory/packs/pack.schema.json",
  "title": "Packs for Tape Memory — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.tape-memory",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.tape-memory": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "enum": [
                          "cassette",
                          "vhs",
                          "reel",
                          "dictaphone"
                        ]
                      },
                      "wear": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "generation": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 8
                      },
                      "wow": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "flutter": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "speed": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 1.5
                      },
                      "hiss": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "crackle": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "dropouts": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "lowCut": {
                        "type": "number",
                        "minimum": 20,
                        "maximum": 400
                      },
                      "highCut": {
                        "type": "number",
                        "minimum": 1500,
                        "maximum": 18000
                      },
                      "drive": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "wowRate": {
                        "type": "number",
                        "minimum": 0.05,
                        "maximum": 4
                      },
                      "flutterRate": {
                        "type": "number",
                        "minimum": 3,
                        "maximum": 25
                      },
                      "stereoWow": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "wowSync": {
                        "enum": [
                          "free",
                          "1 bar",
                          "2 bars",
                          "1/2"
                        ]
                      },
                      "crackleSize": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "dropLen": {
                        "type": "number",
                        "minimum": 0.01,
                        "maximum": 0.5
                      },
                      "hissTone": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "head": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "bits": {
                        "type": "integer",
                        "minimum": 4,
                        "maximum": 16
                      },
                      "rate": {
                        "type": "number",
                        "minimum": 4000,
                        "maximum": 48000
                      },
                      "stopTime": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 4
                      },
                      "stopped": {
                        "type": "boolean"
                      },
                      "mix": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "inGain": {
                        "type": "number",
                        "minimum": -24,
                        "maximum": 24
                      },
                      "outGain": {
                        "type": "number",
                        "minimum": -24,
                        "maximum": 24
                      },
                      "bypass": {
                        "type": "boolean"
                      },
                      "_react": {},
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
