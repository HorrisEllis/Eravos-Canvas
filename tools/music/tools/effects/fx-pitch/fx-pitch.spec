# spec_id: eravos.organism.fx-pitch · version 1.0.0 · phase P8.1 · status canonical
# source: v10 plugins/pitch.json "PITCH DEMON" (shell, F-19) · inherits STD.fx
identity:
  id: eravos.fx-pitch ; label: Pitch ; icon: ♮ ; accent: "#ff44aa"
  comp_intent: Pitch Raven's voice (or anything) up/down in real time — chipmunk, demon, harmonies.
  novelty: Only real-time pitch shifter (AudioWorklet granular overlap-add) with formant preservation option and scale-locked harmony voices.
engine:
  shifter: worklet, two crossfaded read heads over a circular buffer (window 30–80 ms, Hann), ratio = 2^(st/12)
  formant: optional — spectral envelope preserved by pre-emphasis LPC (order 16) whitening then re-colouring (declared CPU-heavy; toggle)
  harmony: up to 2 extra voices at scale intervals (3rd, 5th, octave) using MusicTheory with song key
  latency: reported (window/2) → kernel ledger ; no PDC (declared)
config: semitones −24..24 def 0 ; cents −100..100 ; formant bool ; window 30..80 ms def 50 ; harm1/harm2 enum [off, 3rd, 5th, oct, −oct] ; harmLevel 0..1 ; glide 0..500 ms ; STD mix
presets: Octave Down Demon, Chipmunk, Vocal Double (+7 c/−7 c), Fifth Harmony, Octave Stack
hooks: STD.fx ; STD.theory_in ; mod_semitones STD.mod_in (range −24..24)
ui: hero = input vs output pitch trace (autocorrelation f0 of both, drawn as note names)
tests: STD.fx ; 440 Hz in, +12 → 880 ± 3 Hz ; −12 → 220 ± 2 Hz ; latency reported = window/2

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.key, music.meter]   # ui expansion when added: Audio engine · Song key · Master meter
  services:
    - audio: Audio engine — processes sound
    - key: Song key & scale — plays in key
    - mod: 2 modulation inputs — LFO / XY / Macro can move them
  inputs:
    - fx.hook.audio_in (audio · port in)
    - fx.hook.mod_mix (modulation · port mod.mix)
    - pitch.hook.theory_in (theory:key-change) — ambient broadcast
    - pitch.hook.mod_semitones (modulation · port mod.semitones)
  outputs:
    - fx.hook.audio_out (audio · port out)
  permissions: [audio_out, audio_in, bus_publish, bus_subscribe]
  works_with: []
