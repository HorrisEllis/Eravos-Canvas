{
 "schema": "eravos.pack/1",
 "id": "wub-filter.factory",
 "version": "1.0.0",
 "label": "Factory",
 "prefix": "",
 "author": "ERAVOS",
 "tags": [
  "factory",
  "wubs",
  "dubstep"
 ],
 "for": "eravos.wub-filter",
 "enabled": true,
 "items": {
  "eravos.wub-filter": {
   "presets": {
    "Classic LP Wub": {
     "params": {
      "mode": "lowpass",
      "slope": 24,
      "cutoff": 160,
      "range": 4.5,
      "res": 6,
      "drive": 0.25,
      "invert": false,
      "position": 0,
      "outGain": -7
     }
    },
    "Yoi Vowel (OO → AH)": {
     "params": {
      "mode": "vowel",
      "vowelA": "OO",
      "vowelB": "AH",
      "res": 8,
      "drive": 0.3,
      "formant": 0
     }
    },
    "Talking Yoi (OH → EE)": {
     "params": {
      "mode": "vowel",
      "vowelA": "OH",
      "vowelB": "EE",
      "res": 10,
      "drive": 0.35
     }
    },
    "Yoi Yoi (OO → YOI)": {
     "params": {
      "mode": "vowel",
      "vowelA": "OO",
      "vowelB": "YOI",
      "res": 9,
      "drive": 0.4,
      "formant": -2
     }
    },
    "Riddim Notch": {
     "params": {
      "mode": "notch",
      "cutoff": 300,
      "range": 3,
      "res": 4,
      "drive": 0.5,
      "outGain": -4.8
     }
    },
    "Robot Comb": {
     "params": {
      "mode": "comb",
      "cutoff": 80,
      "range": 3,
      "comb": 0.9,
      "drive": 0.3
     }
    },
    "Hollow Comb (−)": {
     "params": {
      "mode": "comb",
      "cutoff": 110,
      "range": 2.5,
      "comb": -0.85,
      "drive": 0.2
     }
    },
    "Bandpass Yap": {
     "params": {
      "mode": "bandpass",
      "cutoff": 250,
      "range": 3.5,
      "res": 9,
      "drive": 0.35
     }
    },
    "Gentle 12 dB": {
     "params": {
      "mode": "lowpass",
      "slope": 12,
      "cutoff": 220,
      "range": 3,
      "res": 2,
      "drive": 0.1
     }
    },
    "Screech Reso": {
     "params": {
      "mode": "lowpass",
      "slope": 24,
      "cutoff": 400,
      "range": 4,
      "res": 16,
      "drive": 0.6,
      "outGain": -11.9
     }
    },
    "Inverted Mouth": {
     "params": {
      "mode": "lowpass",
      "slope": 24,
      "cutoff": 160,
      "range": 4.5,
      "res": 6,
      "invert": true,
      "outGain": -8.6
     }
    },
    "Bun Dem Throat (OO → AE)": {
     "params": {
      "mode": "vowel",
      "vowelA": "OO",
      "vowelB": "AE",
      "res": 12,
      "drive": 0.6,
      "formant": 2,
      "position": 0,
      "invert": false,
      "outGain": -2.5
     }
    }
   }
  }
 }
}
