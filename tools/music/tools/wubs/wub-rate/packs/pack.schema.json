{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.wub-rate/packs/pack.schema.json",
  "title": "Packs for Wub Rate — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.wub-rate",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.wub-rate": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "steps": {},
                      "length": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16
                      },
                      "stepLen": {
                        "enum": [
                          "1/16",
                          "1/8",
                          "1/4",
                          "1/2",
                          "1/1"
                        ]
                      },
                      "shape": {
                        "enum": [
                          "sine",
                          "talk",
                          "sawdown",
                          "sawup",
                          "square",
                          "triangle"
                        ]
                      },
                      "phase": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "smooth": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "polarity": {
                        "enum": [
                          "unipolar+",
                          "unipolar−",
                          "bipolar",
                          "bipolar inverted"
                        ]
                      },
                      "depth": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "retrig": {
                        "enum": [
                          "on change",
                          "every step",
                          "never"
                        ]
                      },
                      "noteRetrig": {
                        "type": "boolean"
                      },
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
