# spec_id: eravos.organism.song-recorder · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.song-recorder ; label: Song Recorder ; icon: ⏺ ; accent: "#ff3355" ; category: Arrange ; dock: bottom
  comp_intent: Pinned to the bottom: record the canvas (or one tool) into takes, edit them like a DAW, export WAV/FLAC/AIFF/MP3/Opus or stems.
  engine_notes: |
    The song, pinned to the bottom of the canvas (dock:'bottom'). Record what the canvas plays — the master you hear,
    or one tool on its own — as takes on lanes, bar-aligned to the transport. Then edit: move, trim either edge, split,
    duplicate, delete, fade, gain, mute / solo / volume per lane, drop audio files in. Every edit is undoable (Ctrl+Z).
    Playback joins AFTER the master-output capture point (audio post bus): overdubbing never re-records earlier takes
    and nothing is mastered twice. Export renders offline (fast, exact) to every codec in Codecs, or stems as a ZIP.
config:
  source: string def "master"   # RECORD · Record
  snap: enum ["bar", "beat", "1/8", "1/16", "off"] def "beat"   # EDIT · Snap
  zoom: number 4..200 def 26   # EDIT · Zoom
  follow: boolean def true   # EDIT · Follow
  format: enum ["wav24", "wav16", "wav32f", "flac24", "flac16", "aiff24", "aiff16", "mp3-320", "mp3-192", "mp3-128", "opus-webm", "opus-ogg"] def "wav24"   # EXPORT · Format
  range: enum ["song", "loop", "selection"] def "song"   # EXPORT · Range
  stems: boolean def false   # EXPORT · Stems
  tail: number 0..12 s def 2   # EXPORT · Tail
  songName: string def "my song"   # EXPORT · Song name
  level: number 0..1.5 def 1   # OUT · Playback
presets: []
ui_hooks: [record, play, stop, seek, clip_move, clip_trim, clip_split, clip_delete, clip_dup, clip_edit, lane_add, lane_edit, lane_delete, lane_arm, select, import, export, want_peaks] + standard
tests: standard_tests + see tests/p14.test.js

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo, music.meter]   # ui expansion when added: Audio engine · Transport · Tempo · Master meter
  services:
    - audio: Audio engine — makes sound
    - clock: Master clock & tempo — locks to the beat
    - mod: 9 modulation inputs — LFO / XY / Macro can move them
    - files: Your files — drop audio / MIDI on it
    - assets: Clip output — renders sounds other tools can load
  inputs:
    - songrec.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
    - songrec.hook.asset_in (asset:ready)
    - knob.snap (modulation · port mod.knob.snap)
    - knob.zoom (modulation · port mod.knob.zoom)
    - knob.follow (modulation · port mod.knob.follow)
    - knob.format (modulation · port mod.knob.format)
    - knob.range (modulation · port mod.knob.range)
    - knob.stems (modulation · port mod.knob.stems)
    - knob.tail (modulation · port mod.knob.tail)
    - knob.level (modulation · port mod.knob.level)
    - knob.withSong (modulation · port mod.knob.withSong)
  outputs:
    - songrec.hook.audio_out (audio · port out)
    - songrec.hook.asset_out (asset:ready)
    - songrec.hook.song_out (song:saved)
    - songrec.hook.transport_out (ui:transport-play|ui:transport-stop|ui:transport-seek)
  permissions: [audio_out, audio_in, bus_publish, bus_subscribe, filesystem_read, filesystem_write, registry_read]
  works_with: [eravos.timeline, eravos.session, eravos.clip-maker, eravos.harmonic-analyzer, eravos.bass-drop-builder, eravos.bass-forge, eravos.drum-forge, eravos.granular]
  notes:
    - Always docked at the bottom; drag its top edge to resize, double-click to fold.
    - Records the master you hear; its own playback is never re-recorded.
    - 🏷 Tags (3.68): title / artist / album / genre / year / BPM / key / comment + cover, autofilled (song name or the Songbook's last song, genre, year, BPM, key); typed values override, empty = auto again. Artist remembered per computer (ctx.secret), never saved. Cover: uploaded PNG/JPEG, else (autoCover) a 1000 px cover drawn from the export. Written into MP3 / WAV / FLAC / AIFF by Codecs (not Opus) on export, stems and Save to Songs; audio untouched.
