{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.song-recorder/packs/pack.schema.json",
  "title": "Packs for Song Recorder — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.song-recorder",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.song-recorder": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "snap": {
                        "enum": [
                          "bar",
                          "beat",
                          "1/8",
                          "1/16",
                          "off"
                        ]
                      },
                      "zoom": {
                        "type": "number",
                        "minimum": 4,
                        "maximum": 200
                      },
                      "follow": {
                        "type": "boolean"
                      },
                      "format": {
                        "enum": [
                          "wav24",
                          "wav16",
                          "wav32f",
                          "flac24",
                          "flac16",
                          "aiff24",
                          "aiff16",
                          "mp3-320",
                          "mp3-192",
                          "mp3-128",
                          "opus-webm",
                          "opus-ogg"
                        ]
                      },
                      "range": {
                        "enum": [
                          "song",
                          "loop",
                          "selection"
                        ]
                      },
                      "stems": {
                        "type": "boolean"
                      },
                      "tail": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 12
                      },
                      "songName": {
                        "type": "string"
                      },
                      "meta": {},
                      "autoCover": {
                        "type": "boolean"
                      },
                      "level": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.5
                      },
                      "withSong": {
                        "type": "boolean"
                      },
                      "_react": {}
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
