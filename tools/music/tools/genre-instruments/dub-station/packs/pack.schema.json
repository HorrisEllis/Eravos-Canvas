{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.dub-station/packs/pack.schema.json",
  "title": "Packs for Dub Station — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.dub-station",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.dub-station": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "skankOn": {
                        "type": "boolean"
                      },
                      "skankStyle": {
                        "enum": [
                          "one-drop chop",
                          "organ bubble",
                          "dancehall stab"
                        ]
                      },
                      "prog": {
                        "enum": [
                          "i–iv",
                          "i–VII",
                          "i–VI–VII",
                          "I–IV–V",
                          "i–v (minor dub)",
                          "one chord"
                        ]
                      },
                      "skankTone": {
                        "type": "number",
                        "minimum": 400,
                        "maximum": 8000
                      },
                      "skankLevel": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "sirenPitch": {
                        "type": "number",
                        "minimum": 120,
                        "maximum": 2000
                      },
                      "sirenRate": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 16
                      },
                      "sirenDepth": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 24
                      },
                      "sirenShape": {
                        "enum": [
                          "sine",
                          "square",
                          "saw up",
                          "saw down"
                        ]
                      },
                      "sirenRise": {
                        "type": "number",
                        "minimum": -12,
                        "maximum": 24
                      },
                      "sirenLevel": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "hornLevel": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "bigKnob": {
                        "type": "number",
                        "minimum": 20,
                        "maximum": 3000
                      },
                      "spring": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "echo": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "echoDiv": {
                        "enum": [
                          "1/4",
                          "1/8.",
                          "3/16",
                          "1/2",
                          "1/8"
                        ]
                      },
                      "echoFeedback": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.08
                      },
                      "echoSweep": {
                        "type": "number",
                        "minimum": 150,
                        "maximum": 6000
                      },
                      "rewindLen": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 8
                      },
                      "rewindRestart": {
                        "type": "boolean"
                      },
                      "level": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.5
                      },
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
