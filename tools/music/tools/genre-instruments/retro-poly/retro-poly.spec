# spec_id: eravos.organism.retro-poly · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.retro-poly ; label: Retro Poly ; icon: 🌆 ; accent: "#ff2bd6" ; category: Genre instruments
  comp_intent: Synthwave poly: PWM pulse + saw + sub, analog drift, 24 dB filter, BBD chorus, unison, glide, arpeggiator.
  engine_notes: |
    Synthwave / outrun / darksynth poly in the 80s DCO tradition: per voice a saw + a TRUE pulse-width-modulated pulse
    (saw minus its own delayed copy — width = delay·f, so PWM is a moving delay), a sub square, noise, a 24 dB low-pass
    with its own envelope and key-tracking, analog DRIFT (each voice wanders a few cents on its own slow path).
    Global: high-pass, BBD-style chorus I / II / I+II, unison stack for leads, mono + glide, and a transport-locked
    ARPEGGIATOR over held keys (up · down · up-down · random · as played; 1–3 octaves; gate).
config:
  saw: number 0..1 def 0.7   # DCO · Saw
  pulse: number 0..1 def 0.5   # DCO · Pulse
  width: number 0.05..0.5 def 0.35   # DCO · Width
  pwm: number 0..1 def 0.3   # DCO · PWM
  pwmRate: number 0.05..8 Hz def 0.6   # DCO · PWM rate
  sub: number 0..1 def 0.3   # DCO · Sub
  noise: number 0..1 def 0   # DCO · Noise
  drift: number 0..1 def 0.3   # DCO · Drift
  octave: integer -2..2 def 0   # DCO · Octave
  cutoff: number 60..16000 Hz def 2400   # VCF · Cutoff
  res: number 0.3..20 def 3   # VCF · Reso
  envAmt: number -1..1 def 0.5   # VCF · Env amt
  keytrack: number 0..1 def 0.5   # VCF · Keytrack
  hpf: integer 0..3 def 0   # VCF · HPF
  fA: number 0.001..4 s def 0.005   # ENV · F att
  fD: number 0.01..6 s def 0.35   # ENV · F dec
  fS: number 0..1 def 0.3   # ENV · F sus
  attack: number 0.001..5 s def 0.005   # ENV · Attack
  decay: number 0.01..6 s def 0.5   # ENV · Decay
  sustain: number 0..1 def 0.7   # ENV · Sustain
  release: number 0.01..8 s def 0.4   # ENV · Release
  chorus: enum ["off", "I", "II", "I+II"] def "I"   # FX · Chorus
  unison: integer 1..4 def 1   # FX · Unison
  mono: boolean def false   # FX · Mono
  glide: number 0..1 s def 0   # FX · Glide
  arp: enum ["off", "up", "down", "up-down", "random", "played"] def "off"   # ARP · Arp
  arpDiv: enum ["1/4", "1/8", "1/16", "1/8t", "1/16t"] def "1/16"   # ARP · Rate
  arpOct: integer 1..3 def 1   # ARP · Octaves
  arpGate: number 0.05..1 def 0.55   # ARP · Gate
  arpHold: boolean def false   # ARP · Latch
  level: number 0..1.5 def 0.6   # OUT · Level
presets: ["Outrun Lead", "Nightdrive Pad", "Brass Stab '84", "String Machine", "Synthwave Bass (arp)", "Arp Pluck", "Darksynth Saw", "Neon Keys"]
ui_hooks: [] + standard
tests: standard_tests + see tests/p14.test.js

