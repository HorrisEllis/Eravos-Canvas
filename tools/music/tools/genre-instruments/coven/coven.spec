  permissions: [audio_out, midi_in, bus_publish, bus_subscribe]
  works_with: [eravos.organ, eravos.fx-haunt, eravos.drum-forge, eravos.timeline, eravos.sequencer, eravos.arp, eravos.bass-gen, eravos.chord-gen]
