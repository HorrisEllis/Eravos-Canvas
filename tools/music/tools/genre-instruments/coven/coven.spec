# spec_id: eravos.organism.coven · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.coven ; label: Coven ; icon: ⛧ ; accent: "#c4002f" ; category: Genre instruments
  comp_intent: Witch-house choir that chants vowel spells on the beat: hex ring-mod, screw pitch-down, static, a drone that summons itself.
  engine_notes: |
    Weird, witchy music (witch house, dark wave, ritual drone). A choir that CHANTS: every held note is a small coven
    of detuned voices (saws + breath) through a three-formant mouth; the mouth walks a vowel sequence you type
    ("O A E A", "U O U I") one syllable per division, gliding between vowels. HEX rings the choir against a
    sine at an (often irrational) ratio of the note — bells, ghosts. SCREW drags everything down in pitch and time
    feel; STATIC crushes and decimates; SUMMON grows a drone (sub-octave + fifth) the longer a chord is held.
config:
  chant: string def "O A E A"   # CHANT · Chant (vowels A E I O U Y)
  chantDiv: enum ["1/1", "1/2", "1/4", "1/8", "1/4t"] def "1/4"   # CHANT · Syllable
  glide: number 0..1 def 0.35   # CHANT · Mouth glide
  voices: integer 1..7 def 4   # CHOIR · Voices
  spread: number 0..60 ¢ def 18   # CHOIR · Spread
  breath: number 0..1 def 0.35   # CHOIR · Breath
  vibrato: number 0..1 def 0.25   # CHOIR · Vibrato
  hex: enum ["off", "φ", "√2", "π", "7/4", "13/8", "e"] def "off"   # HEX · Hex ratio
  hexMix: number 0..1 def 0.4   # HEX · Hex
  screw: number 0..12 st def 0   # DARK · Screw
  static: number 0..1 def 0   # DARK · Static
  summon: number 0..1 def 0.4   # DARK · Summon
  dark: number 300..12000 Hz def 3200   # DARK · Darkness
  attack: number 0.005..6 s def 0.6   # ENV · Attack
  release: number 0.05..10 s def 2.2   # ENV · Release
  level: number 0..1.5 def 0.7   # OUT · Level
presets: ["Witch House Choir", "Hex Drone", "Séance Pad", "Ritual Bell", "Static Ghost", "Graveyard Chant (screwed)", "Crystal Coven"]
ui_hooks: [] + standard
tests: standard_tests + see tests/p14.test.js

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo, music.key, music.meter, music.midi]   # ui expansion when added: Audio engine · Transport · Tempo · Song key · Master meter · MIDI button
  services:
    - audio: Audio engine — makes sound
    - clock: Master clock & tempo — locks to the beat
    - key: Song key & scale — plays in key
    - midi: MIDI input — plays from a controller (arm with the MIDI button)
    - mod: 15 modulation inputs — LFO / XY / Macro can move them
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
  inputs:
    - cov.hook.note_in (note:trigger)
    - cov.hook.midi_in (midi:note) — ambient broadcast
    - cov.hook.theory_in (theory:key-change) — ambient broadcast
    - cov.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
    - cov.hook.mod_screw (modulation · port mod.screw)
    - knob.chantDiv (modulation · port mod.knob.chantDiv)
    - knob.glide (modulation · port mod.knob.glide)
    - knob.voices (modulation · port mod.knob.voices)
    - knob.spread (modulation · port mod.knob.spread)
    - knob.breath (modulation · port mod.knob.breath)
    - knob.vibrato (modulation · port mod.knob.vibrato)
    - knob.hex (modulation · port mod.knob.hex)
    - knob.hexMix (modulation · port mod.knob.hexMix)
    - knob.static (modulation · port mod.knob.static)
    - knob.summon (modulation · port mod.knob.summon)
    - knob.dark (modulation · port mod.knob.dark)
    - knob.attack (modulation · port mod.knob.attack)
    - knob.release (modulation · port mod.knob.release)
    - knob.level (modulation · port mod.knob.level)
  outputs:
