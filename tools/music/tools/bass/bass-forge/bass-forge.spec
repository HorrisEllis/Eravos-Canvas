# spec_id: eravos.organism.bass-forge · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.bass-forge ; label: Bass Forge ; icon: 🜂 ; accent: "#ff3d00" ; category: Sound Forge
  comp_intent: FM growls, riddim, neuro, screech — one LFO talks through FM, fold, vowel, comb, notch. MATCH learns a reference bass recursively.
  engine_notes: |
    Growls, riddim, neuro, screech, tearout — FM-based, not filter-based (the Wobble Bass is filter-based, the Reese is
    detune-based; this is the third, different way). Chain: 2 carriers (unison) frequency-modulated by a sine at ANY
    ratio (incl. irrational φ, √2, π/2) → wavefolder → vowel formant morph → pitch-tracked comb → riddim notch →
    low-pass → drive / bit-crush → 3-band upward-ish OTT squash → clean sub added last.
    ONE tempo LFO (retriggered per note) moves FM index, fold, formant, comb, notch and cutoff together — each with
    its own depth — so a single gesture talks. Pitch envelope for zaps / lasers.
    MATCH (recursive): drop a reference bass clip → it is measured (centroid, flatness, sub/brightness balance,
    modulation rate + depth) → the forge renders itself offline, measures the render, nudges its knobs (coordinate
    descent, step halving) and loops until the distance stops shrinking. Same graph code live and offline.
config:
  wave: enum ["sawtooth", "square", "triangle", "sine"] def "sawtooth"   # FM · Carrier
  ratio: enum ["1", "2", "3", "0.5", "1.5", "φ 1.618", "√2 1.414", "π/2 1.571", "e/2 1.359", "7/4"] def "1"   # FM · Ratio
  fm: number 0..10 def 1.2   # FM · FM index
  spread: number 0..60 ¢ def 12   # FM · Unison
  fold: number 0..1 def 0.3   # SHAPE · Fold
  formant: number 0..1 def 0.4   # SHAPE · Formant
  vowelA: enum ["OO", "OH", "AH", "EH", "EE"] def "OO"   # SHAPE · Vowel A
  vowelB: enum ["OO", "OH", "AH", "EH", "EE"] def "AH"   # SHAPE · Vowel B
  comb: number 0..0.95 def 0.15   # SHAPE · Comb
  combPitch: number 0.5..8 def 2   # SHAPE · Comb ×
  notch: number 0..1 def 0   # SHAPE · Notch
  cutoff: number 80..16000 Hz def 2600   # FILTER · Cutoff
  res: number 0.3..18 def 2   # FILTER · Reso
  drive: number 0..1 def 0.35   # FILTER · Drive
  crush: number 0..1 def 0   # FILTER · Crush
  ott: number 0..1 def 0.45   # FILTER · OTT
  lfoDiv: enum ["1/1", "1/2", "1/4", "1/4t", "1/8", "1/8t", "1/16", "1/16t", "1/32"] def "1/8"   # LFO · LFO rate
  lfoShape: enum ["sine", "saw", "square", "stair", "talk"] def "talk"   # LFO · LFO shape
  lfoFM: number 0..1 def 0.6   # LFO · → FM
  lfoFold: number 0..1 def 0.3   # LFO · → Fold
  lfoFormant: number 0..1 def 0.8   # LFO · → Vowel
  lfoComb: number 0..1 def 0   # LFO · → Comb
  lfoNotch: number 0..1 def 0   # LFO · → Notch
  lfoCut: number 0..1 def 0.3   # LFO · → Cutoff
  pitchEnv: number 0..48 st def 0   # PITCH · Pitch env
  pitchTime: number 0.005..1.5 s def 0.08   # PITCH · Pitch time
  glide: number 0..0.6 s def 0.04   # PITCH · Glide
  octave: integer -2..1 def -1   # PITCH · Octave
  sub: number 0..1 def 0.6   # OUT · Sub
  attack: number 0.001..1 s def 0.004   # OUT · Attack
  release: number 0.01..2 s def 0.1   # OUT · Release
  level: number 0..1.5 def 0.8   # OUT · Level
presets: ["Brostep Growl", "Riddim Stair", "Yoi Talker", "Neuro Reese-FM", "Screech", "Tearout Metal", "Laser Zap", "Machine Gun 1/32", "Golden Growl (φ)", "Dub Wobble (soft)"]
ui_hooks: [match, match_stop] + standard
tests: standard_tests + see tests/p14.test.js

