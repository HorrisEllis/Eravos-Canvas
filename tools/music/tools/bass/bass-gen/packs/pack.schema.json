{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.bass-gen/packs/pack.schema.json",
  "title": "Packs for Bassline — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.bass-gen",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.bass-gen": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "rhythm": {
                        "enum": [
                          "groove kick",
                          "every beat",
                          "offbeats",
                          "eighths",
                          "half-time"
                        ]
                      },
                      "energy": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "octave": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4
                      },
                      "length": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 8
                      },
                      "progression": {
                        "enum": [
                          "i-VI-III-VII",
                          "i-iv-v-i",
                          "vi-IV-I-V",
                          "i-i-VI-VII",
                          "i-v-VI-iv"
                        ]
                      },
                      "chordBars": {
                        "enum": [
                          1,
                          2,
                          4
                        ]
                      },
                      "_react": {},
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
