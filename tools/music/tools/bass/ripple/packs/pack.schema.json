{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.ripple/packs/pack.schema.json",
  "title": "Packs for Ripple — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.ripple",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.ripple": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "wave": {
                        "enum": [
                          "saw",
                          "square",
                          "triangle",
                          "sine"
                        ]
                      },
                      "voices": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 7
                      },
                      "beat": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 12
                      },
                      "detune": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "width": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "midOct": {
                        "enum": [
                          "0",
                          "+1",
                          "+2"
                        ]
                      },
                      "drive": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 24
                      },
                      "bias": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "grind": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "sub": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "cutoff": {
                        "type": "number",
                        "minimum": 80,
                        "maximum": 12000
                      },
                      "res": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 14
                      },
                      "fEnv": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 4
                      },
                      "fDec": {
                        "type": "number",
                        "minimum": 0.02,
                        "maximum": 3
                      },
                      "dive": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 24
                      },
                      "diveTime": {
                        "type": "number",
                        "minimum": 0.01,
                        "maximum": 1.5
                      },
                      "aA": {
                        "type": "number",
                        "minimum": 0.001,
                        "maximum": 2
                      },
                      "aD": {
                        "type": "number",
                        "minimum": 0.01,
                        "maximum": 4
                      },
                      "aS": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "aR": {
                        "type": "number",
                        "minimum": 0.01,
                        "maximum": 6
                      },
                      "octave": {
                        "type": "integer",
                        "minimum": -3,
                        "maximum": 2
                      },
                      "level": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "_react": {}
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
