{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.acid-synth/packs/pack.schema.json",
  "title": "Packs for Acid Synth — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.acid-synth",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.acid-synth": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "cutoff": {
                        "type": "number",
                        "minimum": 20,
                        "maximum": 14000
                      },
                      "res": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "envMod": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "decay": {
                        "type": "number",
                        "minimum": 0.02,
                        "maximum": 6
                      },
                      "accent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "drive": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "level": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.5
                      },
                      "wave": {
                        "enum": [
                          "saw",
                          "square"
                        ]
                      },
                      "octave": {
                        "type": "integer",
                        "minimum": -3,
                        "maximum": 3
                      },
                      "tune": {
                        "type": "number",
                        "minimum": -12,
                        "maximum": 12
                      },
                      "_react": {}
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
