# spec_id: eravos.organism.recursive-spectra · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.recursive-spectra ; label: Recursive Spectra ; icon: ⟲ ; accent: "#7cffb2" ; category: Xenharmonic
  comp_intent: A spectrum fed through itself, generation after generation: evolving irrational drones, bells and pads that never repeat — or loop.
  engine_notes: |
    Loop-recursive harmony: a seed spectrum S₀ (harmonic, bell, membrane, φ-series, primes, or one received from the
    Harmonic Analyzer) is fed through a transform T again and again — S₁ = T(S₀), S₂ = T(S₁) … — and the oscillator
    bank glides from generation to generation (per bar on the transport, or every N seconds), cycling, ping-ponging
    or running free. Transforms: power (stretch), golden fold (×φ^a, reflected under a ceiling), sum–difference
    (combination tones of the strongest pairs, pruned), mirror (log-reflection), spiral (golden rotation inside each
    octave). Every generation can be sent on as a spectrum (xen:spectrum) or turned into a scale: the minima of its
    own dissonance curve (xen:tuning) — the timbre writes its tuning.
config:
  seed: enum ["harmonic", "odd", "bell", "membrane", "bar", "golden", "prime", "fibonacci", "received"] def "harmonic"   # RECURSION · Seed
  transform: enum ["power", "golden-fold", "sum-difference", "mirror", "spiral"] def "golden-fold"   # RECURSION · Transform
  amount: number 0..1 def 0.5   # RECURSION · Amount
  depth: integer 1..32 def 8   # RECURSION · Depth
  loop: enum ["cycle", "ping-pong", "free", "hold"] def "ping-pong"   # RECURSION · Loop
  partials: integer 3..16 def 10   # RECURSION · Partials
  ceiling: number 2..32 def 12   # RECURSION · Ceiling ×
  rate: enum ["1 bar", "2 bars", "4 bars", "8 bars", "seconds"] def "seconds"   # TIME · Advance
  seconds: number 0.25..60 s def 4   # TIME · Every
  morph: number 0..1 def 0.7   # TIME · Morph
  baseHz: number 20..800 Hz def 98   # SOUND · Drone Hz
  drone: boolean def true   # SOUND · Drone
  level: number 0..1.5 def 0.5   # SOUND · Level
  attack: number 0.001..6 s def 0.3   # NOTES · Attack
  release: number 0.01..12 s def 2   # NOTES · Release
  autoSend: boolean def false   # SEND · Stream
presets: ["Golden Drift", "Bell Fractal", "Stretching Organ", "Mirror Choir", "φ Spiral Pad", "Membrane Storm", "Witch Bell Loop"]
ui_hooks: [goto, send_spectrum, send_scale] + standard
tests: standard_tests + see tests/p14.test.js

