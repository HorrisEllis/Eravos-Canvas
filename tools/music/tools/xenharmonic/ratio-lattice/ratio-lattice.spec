# spec_id: eravos.organism.ratio-lattice · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.ratio-lattice ; label: Ratio Lattice ; icon: ⋕ ; accent: "#00ffcc" ; category: Xenharmonic
  comp_intent: Click a just-intonation lattice (3 × 5 × 7/11/13) to build chords from exact ratios. Hear the beats, see the harmonic series.
  engine_notes: |
    A just-intonation lattice: x = powers of 3, y = powers of 5, z-layer = powers of 7 / 11 / 13. Every node is an exact
    ratio folded into one octave. Click nodes to sound them as drones; the readout shows the chord as an otonal
    harmonic series (4:5:6:7), each pair's slowest beat rate, and total sensory dissonance (Sethares).
    Sends exact frequencies as note:trigger { note: nearest key, freq } to any instrument (Xen Synth honours freq),
    an arpeggiator over the chord (transport-locked), and exports the chord as a scale (xen:tuning).
config:
  baseHz: number 30..880 Hz def 196   # LATTICE · 1/1 Hz
  primeZ: enum [7, 11, 13] def 7   # LATTICE · Z prime
  layer: integer -2..2 def 0   # LATTICE · Z layer
  timbre: enum ["sine", "harmonic", "organ", "glass"] def "harmonic"   # SOUND · Timbre
  fade: number 0.01..4 s def 0.4   # SOUND · Fade
  level: number 0..1.5 def 0.5   # SOUND · Level
  drone: boolean def true   # SOUND · Drone
  arp: boolean def false   # ARP · Arp
  arpDiv: enum ["1/4", "1/8", "1/16", "1/8t"] def "1/8"   # ARP · Rate
  arpOrder: enum ["up", "down", "updown", "random"] def "up"   # ARP · Order
  sendTo: string def ""   # SEND · Send notes to
  noteDur: number 0.05..6 s def 0.5   # SEND · Note length
presets: ["Harmonic Seventh 4:5:6:7", "Utonal Minor 1/4:1/5:1/6", "Just Major Triad 4:5:6", "Syntonic Comma Beat 81:80", "Undecimal Neutral 8:11:12", "Tridecimal Glass 8:10:13", "Septimal Cluster (arp)"]
ui_hooks: [node_toggle, clear, send_chord, export_scale] + standard
tests: standard_tests + see tests/p14.test.js

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music.lab   # Lab
  toolbar_units: [music.engine, music.transport, music.tempo, music.meter]   # ui expansion when added: Audio engine · Transport · Tempo · Master meter
  services:
    - audio: Audio engine — makes sound
    - clock: Master clock & tempo — locks to the beat
    - mod: 11 modulation inputs — LFO / XY / Macro can move them
  inputs:
    - lat.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
    - knob.baseHz (modulation · port mod.knob.baseHz)
    - knob.primeZ (modulation · port mod.knob.primeZ)
    - knob.layer (modulation · port mod.knob.layer)
    - knob.timbre (modulation · port mod.knob.timbre)
    - knob.fade (modulation · port mod.knob.fade)
    - knob.level (modulation · port mod.knob.level)
    - knob.drone (modulation · port mod.knob.drone)
    - knob.arp (modulation · port mod.knob.arp)
    - knob.arpDiv (modulation · port mod.knob.arpDiv)
    - knob.arpOrder (modulation · port mod.knob.arpOrder)
    - knob.noteDur (modulation · port mod.knob.noteDur)
  outputs:
    - lat.hook.audio_out (audio · port out)
    - lat.hook.note_out (note:trigger)
    - lat.hook.tuning_out (xen:tuning)
  permissions: [audio_out, bus_publish, bus_subscribe, registry_read]
  works_with: [eravos.xen-synth, eravos.recursive-spectra, eravos.pads, eravos.embodiment-lab, eravos.arp, eravos.coven, eravos.organ, eravos.retro-poly]
  notes:
    - Sends exact frequencies — Xen Synth plays them exactly; 12-TET instruments get the nearest key.
