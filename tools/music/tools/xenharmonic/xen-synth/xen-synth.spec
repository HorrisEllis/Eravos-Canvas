# spec_id: eravos.organism.xen-synth · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.xen-synth ; label: Xen Synth ; icon: ∿ ; accent: "#00ffcc" ; category: Xenharmonic
  comp_intent: Play irrational frequencies: any tuning (φ, π, e, Bohlen–Pierce, 31-EDO, Carlos α, your own ratios) with any partial spectrum.
  engine_notes: |
    Additive poly synth for NON-STANDARD harmonic data: any tuning (EDO-N, equal divisions of irrational periods φ/π/e,
    non-octave Carlos α/β/γ, Bohlen–Pierce, irrational-generator MOS, just intonation, typed Scala lists) played by
    keys/notes (key − baseNote = scale step), and any partial spectrum (harmonic, stretched, piano-B, φ-series, bar /
    membrane / bell modes, primes, tuning-matched). Each voice = up to 24 sine partials at f0 · r_k with their own
    amplitudes, so irrational partial ratios are exact — a PeriodicWave could only hold integer harmonics.
    Accepts note:trigger with an exact `freq` (from the Ratio Lattice), xen:tuning and xen:spectrum from the
    Harmonic Analyzer / Recursive Spectra.
config:
  tuning: enum ["12-TET", "EDO (any)", "19-EDO", "22-EDO", "24-EDO (quarter tones)", "31-EDO", "53-EDO", "7-EDO", "5-EDO", "Bohlen–Pierce (13ED3)", "Equal division of φ", "Equal division of π", "Equal division of e", "Wendy Carlos α", "Wendy Carlos β", "Wendy Carlos γ", "Golden generator (φ-MOS)", "Generator (any irrational)", "Harmonic series 8–16", "Subharmonic 16–8", "Ptolemy 5-limit major", "Pythagorean 12", "Partch 11-limit diamond", "Bohlen–Pierce just", "Slendro (approx.)", "Pelog (approx.)", "Custom (text)"] def "Golden generator (φ-MOS)"   # TUNING · Tuning
  n: integer 1..72 def 7   # TUNING · Steps N
  generator: enum ["φ (golden)", "√2", "√3", "√5", "π/2", "e/2", "silver mean 1+√2", "bronze mean", "plastic ρ", "π", "e", "3/2 (just fifth)", "2 (octave)", "3 (tritave)"] def "φ (golden)"   # TUNING · Generator
  period: enum ["2 (octave)", "3 (tritave)", "φ (golden)", "π", "e", "none"] def "2 (octave)"   # TUNING · Period
  scaleText: string def "9/8 5/4 phi 3/2 2^(11/12) 2/1"   # TUNING · Scale (ratios / cents, last = period)
  baseHz: number 16..1000 Hz def 261.63   # TUNING · Base Hz
  baseNote: integer 0..127 def 60   # TUNING · Base key
  spectrum: enum ["harmonic", "odd", "prime", "stretched", "piano", "golden", "golden-harmonic", "root-k", "bar", "membrane", "bell", "fibonacci", "tuning-matched", "received"] def "harmonic"   # SPECTRUM · Spectrum
  partials: integer 1..24 def 10   # SPECTRUM · Partials
  shape: number 0..1 def 0.5   # SPECTRUM · Shape
  tilt: number 0..3 def 1.1   # SPECTRUM · Tilt
  even: number 0..1 def 1   # SPECTRUM · Even
  bright: number 200..16000 Hz def 7000   # SPECTRUM · Bright
  shimmer: number 0..1 def 0.15   # SPECTRUM · Shimmer
  spread: number 0..40 ¢ def 2   # SPECTRUM · Spread
  attack: number 0.001..4 s def 0.01   # ENV · Attack
  decay: number 0.01..8 s def 0.6   # ENV · Decay
  sustain: number 0..1 def 0.6   # ENV · Sustain
  release: number 0.01..10 s def 0.8   # ENV · Release
  partialDecay: number 0..1 def 0   # ENV · Bell decay
  level: number 0..1.5 def 0.6   # OUT · Level
presets: ["Golden Bells", "Bohlen–Pierce Clarinet", "Tuning-matched 10-EDO", "φ Organ (ED φ)", "Carlos α Glass", "Stretched Piano 22", "Prime Ghost (otonal)", "Slendro Metallophone", "π Drone", "Partch Diamond Strings", "Silver-Mean Membrane"]
ui_hooks: [play_step] + standard
tests: standard_tests + see tests/p14.test.js

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music.lab   # Lab
  toolbar_units: [music.engine, music.meter, music.midi]   # ui expansion when added: Audio engine · Master meter · MIDI button
  services:
    - audio: Audio engine — makes sound
    - midi: MIDI input — plays from a controller (arm with the MIDI button)
    - mod: 21 modulation inputs — LFO / XY / Macro can move them
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
  inputs:
    - xen.hook.note_in (note:trigger)
    - xen.hook.midi_in (midi:note) — ambient broadcast
    - xen.hook.tuning_in (xen:tuning)
    - xen.hook.spectrum_in (xen:spectrum)
    - xen.hook.mod_level (modulation · port mod.level)
    - knob.tuning (modulation · port mod.knob.tuning)
    - knob.n (modulation · port mod.knob.n)
    - knob.generator (modulation · port mod.knob.generator)
    - knob.period (modulation · port mod.knob.period)
    - knob.baseHz (modulation · port mod.knob.baseHz)
    - knob.baseNote (modulation · port mod.knob.baseNote)
    - knob.spectrum (modulation · port mod.knob.spectrum)
    - knob.partials (modulation · port mod.knob.partials)
    - knob.shape (modulation · port mod.knob.shape)
    - knob.tilt (modulation · port mod.knob.tilt)
    - knob.even (modulation · port mod.knob.even)
    - knob.bright (modulation · port mod.knob.bright)
    - knob.shimmer (modulation · port mod.knob.shimmer)
    - knob.spread (modulation · port mod.knob.spread)
    - knob.attack (modulation · port mod.knob.attack)
    - knob.decay (modulation · port mod.knob.decay)
    - knob.sustain (modulation · port mod.knob.sustain)
    - knob.release (modulation · port mod.knob.release)
    - knob.partialDecay (modulation · port mod.knob.partialDecay)
    - bend.in (modulation · port mod.bendin)
  outputs:
    - xen.hook.audio_out (audio · port out)
    - curve.out (modulation · port curve)
  permissions: [audio_out, midi_in, bus_publish, bus_subscribe]
  works_with: [eravos.ratio-lattice, eravos.harmonic-analyzer, eravos.recursive-spectra, eravos.timeline, eravos.sequencer, eravos.arp, eravos.bass-gen, eravos.chord-gen]
  notes:
    - Ignores the song key on purpose: the tuning IS the key. Key C4 (60) = step 0 by default.

