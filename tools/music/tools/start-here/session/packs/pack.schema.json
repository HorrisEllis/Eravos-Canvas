{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.session/packs/pack.schema.json",
  "title": "Packs for Session — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.session",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.session": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "songName": {
                        "type": "string"
                      },
                      "bpm": {
                        "type": "number",
                        "minimum": 40,
                        "maximum": 240
                      },
                      "root": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 11
                      },
                      "scale": {
                        "enum": [
                          "major",
                          "minor",
                          "dorian",
                          "phrygian",
                          "lydian",
                          "mixolydian",
                          "harmonic_minor",
                          "pentatonic_major",
                          "pentatonic_minor",
                          "blues",
                          "chromatic"
                        ]
                      },
                      "metronome": {
                        "type": "boolean"
                      },
                      "countIn": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2
                      },
                      "bounceBars": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 512
                      },
                      "bitDepth": {
                        "enum": [
                          16,
                          24
                        ]
                      },
                      "autosave": {
                        "type": "boolean"
                      },
                      "autoLength": {
                        "type": "boolean"
                      },
                      "_react": {}
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
