# ============================================================
# ERAVOS ORGANISM SPEC — SESSION (new)
# spec_id:      eravos.organism.session
# version:      1.0.0
# phase:        P4
# status:       canonical
# ============================================================
#
# Why a new organism: the L4 shell is locked, so song-level controls
# (tempo, key, save/open, export) need a home. Session is that home.
# It is not a fused organism — it owns song state, nothing else.

identity:
  id: eravos.session ; label: Session ; icon: ◎ ; accent: "#ffffff"
  comp_intent: >
    The song's settings and file operations: tempo, tap tempo, key,
    scale, metronome, record, bounce to WAV, save/open/new project,
    autosave status.
  novelty: >
    Only organism that owns song key/scale (theory:key-change source)
    and drives Workspace persistence. Singleton (second instance → MOUNT_006, blocking).

engine:
  key/scale: publishes theory:key-change {root, scale} on change and on mount; re-publishes on kernel:organism-mounted so late organisms sync
  tempo: ui:transport-bpm → MasterTransport ; tap tempo = mean of last 4 intervals, reset after 2 s idle
  metronome: toggles MasterTransport click port ; count-in bars 0..2
  files:
    save:  Workspace.snapshot() → download "<song>.eravos.json" (audio embedded base64)
    open:  file input → Workspace.restore()
    new:   confirm → clear canvas → default key/bpm
    autosave: Workspace autosave status (last saved hh:mm:ss) ; restore-on-boot prompt if autosave newer than 10 s exists
  export:
    bounce: bars (default = timeline song end or 8) → WAV (16/24-bit) → download + optional drop into timeline
    record: arms MasterTransport.record ; recorded WAV routed to armed timeline lane or downloaded

config:
  songName string def 'untitled' ; bpm 40..240 def 128 ; root 0..11 def 9 (A) ; scale def minor
  metronome bool def false ; countIn 0..2 def 1 ; bounceBars 1..512 def 8 ; bitDepth enum [16, 24] def 24 ; autosave bool def true

hooks:
  - session.hook.theory_out:  out ; event_bus ; theory:key-change {root, scale} ; 1.0.0
  - session.hook.transport_out: out ; ui:transport-bpm | ui:transport-record | ui:transport-bounce
  - session.hook.recorded_in: in ; transport:recorded

ui:
  big BPM (drag/type) + TAP ; key wheel (12 roots) + scale select with plain-language hint ("minor = darker, emotional") ; metronome + count-in
  file row: NEW · OPEN · SAVE · autosave status
  export row: bars, bit depth, BOUNCE WAV, ⏺ RECORD ; progress bar during bounce
  ui_hooks: [ui:tap, ui:save, ui:open {text}, ui:new, ui:bounce, ui:record, standard_ui_hooks]

raises_faults: [MOUNT_006, ASSET_001 (bad project file), MOUNT_005 (workspace version unsupported)]

tests:
  - standard_tests (non-audio variant: no out port)
  - tap 4 × 500 ms → 120 BPM
  - key change → every mounted theory_in organism receives exact {root, scale}
  - save → new → open round trip reproduces organism count, params, wires, embedded samples
  - bounce 2 bars @ 120 → WAV duration 4.000 s ± 1 sample, 24-bit header valid
  - second Session → MOUNT_006, window not created

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.tempo, music.key]   # ui expansion when added: Audio engine · Tempo · Song key
  services:
    - audio: Audio engine — shares the audio clock
    - clock: Tempo — sets the song tempo
    - key: Song key & scale — sets the key
    - files: Your files — drop audio / MIDI on it
    - assets: Clip output — renders sounds other tools can load
  inputs:
    - session.hook.recorded_in (transport:recorded) — ambient broadcast
    - session.hook.songlen_in (timeline:song_length|edm:drop-plan)
  outputs:
    - session.hook.theory_out (theory:key-change)
    - session.hook.transport_out (ui:transport-bpm|ui:transport-record|ui:transport-bounce|ui:transport-metronome|ui:transport-stop)
    - session.hook.asset_out (asset:ready)
  permissions: [bus_publish, bus_subscribe, filesystem_read, filesystem_write]
  works_with: [eravos.harmonic-analyzer, eravos.bass-drop-builder, eravos.song-recorder, eravos.timeline, eravos.bass-forge, eravos.granular, eravos.contrast-analyser, eravos.sample-player]
