{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.particle-field/packs/pack.schema.json",
  "title": "Packs for Field — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.particle-field",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.particle-field": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "count": {
                        "type": "integer",
                        "minimum": 500,
                        "maximum": 40000
                      },
                      "speed": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 3
                      },
                      "damping": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.9
                      },
                      "gravity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "burst": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "curl": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "entropy": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "sensitivity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "basins": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "memory": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 3600
                      },
                      "learn": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 4
                      },
                      "trail": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 0.98
                      },
                      "size": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 6
                      },
                      "spin": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "tilt": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.4
                      },
                      "palette": {
                        "enum": [
                          "pitch",
                          "heat",
                          "ice",
                          "mono"
                        ]
                      },
                      "renderer": {
                        "enum": [
                          "auto",
                          "webgl",
                          "2d"
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
