# spec_id: eravos.organism.harmonic-analyzer · version 1.0.0 · phase P14 · status canonical (generated from code, then owned by the spec)
identity:
  id: eravos.harmonic-analyzer ; label: Harmonic Analyzer ; icon: ⌬ ; accent: "#ffe066" ; category: Analysis
  comp_intent: Measures any sound’s partials: ratios, p/q approximations, irrational constants, inharmonicity, its own consonant intervals — layer by layer.
  engine_notes: |
    Reads the harmonic DNA of any sound — live (a TAP: wiring a sound in never reroutes it) or a dropped file:
    f0 (works with a missing fundamental), every partial's ratio to f0, its best rational approximation p/q
    (continued fractions), error in cents, offset from the piano's 12-TET, irrational constants recognised (φ, π, √2…),
    stiff-string inharmonicity B, harmonicity %, and the sound's own dissonance curve whose minima are the intervals
    that sound most consonant WITH THIS TIMBRE.
    Recursive layers: fit a harmonic (or stretched) series, remove the partials it explains, analyse what is left,
    repeat — a chord, a bell's sub-series or a layered growl splits into its sources.
    Sends: xen:tuning (consonant intervals) · xen:spectrum (measured partials) · .scl export from the UI.
config:
  fft: enum [4096, 8192, 16384, 32768] def 16384   # ANALYSIS · FFT
  floor: number -120..-20 dB def -80   # ANALYSIS · Floor
  range: number 20..100 dB def 60   # ANALYSIS · Range
  maxPeaks: integer 4..48 def 24   # ANALYSIS · Partials
  maxDen: integer 4..128 def 32   # ANALYSIS · Max q
  smoothing: number 0..0.95 def 0.6   # ANALYSIS · Smooth
  layers: integer 1..4 def 3   # ANALYSIS · Layers
  f0Mode: enum ["auto", "manual"] def "auto"   # F0 · f0
  f0Manual: number 16..4000 Hz def 110   # F0 · f0 Hz
  hold: boolean def false   # LIVE · Hold
  source: enum ["live", "file"] def "live"   # LIVE · Source
  sendTo: string def ""   # SEND · Send to
presets: ["Tonal (voice, synth)", "Bells & metal", "Bass (growl, 808)", "Chords / layers"]
ui_hooks: [load, send_tuning, send_spectrum, reanalyse] + standard
tests: standard_tests + see tests/p14.test.js

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music.lab   # Lab
  toolbar_units: [music.engine]   # ui expansion when added: Audio engine
  services:
    - audio: Audio engine — listens to sound
    - files: Your files — drop audio / MIDI on it
  inputs:
    - ha.hook.audio_in (audio · port in)
    - ha.hook.asset_in (asset:ready)
  outputs:
    - ha.hook.tuning_out (xen:tuning)
    - ha.hook.spectrum_out (xen:spectrum)
  permissions: [audio_in, bus_publish, bus_subscribe, filesystem_read]
  works_with: [eravos.xen-synth, eravos.recursive-spectra, eravos.sample-player, eravos.song-recorder, eravos.drum-forge, eravos.session, eravos.clip-maker]
  notes:
    - Live input is a tap: the sound you wire in keeps going where it went.
