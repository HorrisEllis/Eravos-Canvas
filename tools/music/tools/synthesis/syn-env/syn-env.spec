# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.midi]   # ui expansion when added: Audio engine · MIDI button
  services:
    - audio: Audio engine — shares the audio clock
    - midi: MIDI input — plays from a controller (arm with the MIDI button)
    - mod: 13 modulation inputs — LFO / XY / Macro can move them
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
  inputs:
    - env.hook.note_in (note:trigger)
    - env.hook.midi_in (midi:note) — ambient broadcast
    - env.hook.mod_depth (modulation · port mod.depth)
    - knob.delay (modulation · port mod.knob.delay)
    - knob.attack (modulation · port mod.knob.attack)
    - knob.curve (modulation · port mod.knob.curve)
    - knob.hold (modulation · port mod.knob.hold)
    - knob.decay (modulation · port mod.knob.decay)
    - knob.sustain (modulation · port mod.knob.sustain)
    - knob.release (modulation · port mod.knob.release)
    - knob.loop (modulation · port mod.knob.loop)
    - knob.polarity (modulation · port mod.knob.polarity)
    - knob.velocity (modulation · port mod.knob.velocity)
    - knob.retrig (modulation · port mod.knob.retrig)
    - knob.follow (modulation · port mod.knob.follow)
  outputs:
    - env.hook.mod_out (modulation · port out)
  permissions: [audio_out, midi_in, bus_publish, bus_subscribe, registry_read]
  works_with: [eravos.timeline, eravos.sequencer, eravos.arp, eravos.bass-gen, eravos.chord-gen, eravos.groove-gen, eravos.midi-mapper, eravos.lyric-rhythm]
