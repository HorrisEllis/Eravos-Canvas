{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.syn-osc/packs/pack.schema.json",
  "title": "Packs for Morph Osc — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.syn-osc",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.syn-osc": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "bank": {
                        "enum": [
                          "analog",
                          "vocal",
                          "digital",
                          "organ"
                        ]
                      },
                      "morph": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "octave": {
                        "type": "integer",
                        "minimum": -3,
                        "maximum": 3
                      },
                      "ratio": {
                        "enum": [
                          "0.5",
                          "1",
                          "1.5",
                          "2",
                          "3",
                          "4",
                          "5",
                          "7"
                        ]
                      },
                      "fine": {
                        "type": "number",
                        "minimum": -100,
                        "maximum": 100
                      },
                      "glide": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "unison": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4
                      },
                      "detune": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 50
                      },
                      "width": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "fmIndex": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 16
                      },
                      "ring": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "follow": {
                        "type": "boolean"
                      },
                      "attack": {
                        "type": "number",
                        "minimum": 0.001,
                        "maximum": 4
                      },
                      "decay": {
                        "type": "number",
                        "minimum": 0.01,
                        "maximum": 6
                      },
                      "sustain": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "release": {
                        "type": "number",
                        "minimum": 0.01,
                        "maximum": 8
                      },
                      "velocity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "level": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1.5
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
