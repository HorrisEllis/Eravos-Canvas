# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.meter, music.midi]   # ui expansion when added: Audio engine · Master meter · MIDI button
  services:
    - audio: Audio engine — makes sound
    - midi: MIDI input — plays from a controller (arm with the MIDI button)
    - mod: 14 modulation inputs — LFO / XY / Macro can move them
    - notes: Notes from a sequencer, timeline or keys — or play its own keyboard
  inputs:
    - part.hook.note_in (note:trigger)
    - part.hook.midi_in (midi:note) — ambient broadcast
    - part.hook.mod_pitch (modulation · port mod.pitch)
    - knob.morph (modulation · port mod.knob.morph)
    - knob.evolve (modulation · port mod.knob.evolve)
    - knob.tilt (modulation · port mod.knob.tilt)
    - knob.oddEven (modulation · port mod.knob.oddEven)
    - knob.stretch (modulation · port mod.knob.stretch)
    - knob.damp (modulation · port mod.knob.damp)
    - knob.octave (modulation · port mod.knob.octave)
    - knob.attack (modulation · port mod.knob.attack)
    - knob.decay (modulation · port mod.knob.decay)
    - knob.sustain (modulation · port mod.knob.sustain)
    - knob.release (modulation · port mod.knob.release)
    - knob.level (modulation · port mod.knob.level)
    - bend.in (modulation · port mod.bendin)
  outputs:
    - part.hook.audio_out (audio · port out)
    - curve.out (modulation · port curve)
  permissions: [audio_out, midi_in, bus_publish, bus_subscribe]
  works_with: [eravos.timeline, eravos.sequencer, eravos.arp, eravos.bass-gen, eravos.chord-gen, eravos.groove-gen, eravos.midi-mapper, eravos.lyric-rhythm]
