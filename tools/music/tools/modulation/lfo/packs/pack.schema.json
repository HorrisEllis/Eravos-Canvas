{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.lfo/packs/pack.schema.json",
  "title": "Packs for LFO — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.lfo",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.lfo": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "shape": {
                        "enum": [
                          "sine",
                          "triangle",
                          "square",
                          "saw",
                          "ramp",
                          "sh",
                          "smooth",
                          "custom"
                        ]
                      },
                      "sync": {
                        "type": "boolean"
                      },
                      "div": {
                        "enum": [
                          "4/1",
                          "2/1",
                          "1/1",
                          "1/2",
                          "1/4",
                          "1/4t",
                          "1/8",
                          "1/8t",
                          "1/16",
                          "1/32"
                        ]
                      },
                      "rate": {
                        "type": "number",
                        "minimum": 0.01,
                        "maximum": 40
                      },
                      "depth": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "offset": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "phase": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 360
                      },
                      "polarity": {
                        "enum": [
                          "bipolar",
                          "unipolar+",
                          "unipolar−"
                        ]
                      },
                      "retrigger": {
                        "enum": [
                          "off",
                          1,
                          2,
                          4,
                          8
                        ]
                      },
                      "fade": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 8
                      },
                      "custom": {},
                      "_react": {},
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
