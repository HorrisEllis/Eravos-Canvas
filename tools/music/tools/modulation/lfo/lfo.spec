# ============================================================
# ERAVOS ORGANISM SPEC — LFO
# spec_id:      eravos.organism.lfo
# version:      2.0.0
# phase:        P5
# resolves:     F-10(lfo)
# status:       canonical
# ============================================================

identity:
  id: eravos.lfo ; label: LFO ; icon: 〰 ; accent: "#aa44ff"
  comp_intent: >
    Audio-rate periodic modulation, tempo-locked, wired by
    modulation wire into any organism's mod port (cutoff, pan,
    DJ filter…). No bus polling — the signal is the modulation.
  novelty: >
    Only organism whose output is a continuous control signal with
    shape morphing and per-bar phase lock to the transport.

engine:
  source: OscillatorNode (sine/triangle/square/saw) or PeriodicWave (custom 16-point drawn shape, Fourier 32 harmonics)
  S&H / smooth random: ConstantSourceNode with setValueAtTime (S&H) or linearRamp (smooth) scheduled on each division from transport:tick
  scaling: osc → depthGain(depth) → offsetSum(+offset via ConstantSource) → polarity → port 'out' (kind mod, −1..1)
  sync: rate = 1 / divisionSec(div, bpm) ; bpm change → frequency.setValueAtTime at next tick
  phase lock: on transport:play and every `retrigger` bars → restart oscillator at bar time with phase offset (start offset via delayed start)
  free mode: rate in Hz 0.01..40
  fade-in: depth ramps over fade bars after retrigger

config:
  shape enum [sine, triangle, square, saw, ramp, sh, smooth, custom] def sine
  sync bool def true ; div enum [4/1,2/1,1/1,1/2,1/4,1/4t,1/8,1/8t,1/16,1/32] def 1/4 ; rate 0.01..40 Hz def 2
  depth 0..1 def 0.5 ; offset −1..1 def 0 ; phase 0..360 def 0 ; polarity enum [bipolar, unipolar+, unipolar−]
  retrigger enum [off, 1, 2, 4, 8] bars def 1 ; fade 0..8 bars def 0 ; custom: float[16]

hooks:
  - lfo.hook.mod_out:     out ; modulation ; port out ; 2.0.0 (fan-out allowed)
  - lfo.hook.transport_in STD.transport_in
  - lfo.hook.mod_depth    STD.mod_in(depth)   # LFO-on-LFO

ui:
  hero: shape display with live phase dot read from an analyser on the out port (the real signal)
  custom shape: 16 draggable bars when shape = custom
  division ladder / Hz knob by sync toggle ; depth, offset, phase, retrigger, fade
  wired-targets list (read from kernel wireRegistry) with per-wire remove
  ui_hooks: [standard_ui_hooks, ui:custom_shape {points}]

tests:
  - standard_tests (non-silent = signal RMS > 0 on out port)
  - div 1/4 at 120 BPM → frequency 2 Hz
  - retrigger 1 bar: value at each bar start equals shape(phase) ± 1e-3
  - modulation wire to channel pan with depth 1 → pan swings full range
  - S&H: value constant between division boundaries

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo]   # ui expansion when added: Audio engine · Transport · Tempo
  services:
    - audio: Audio engine — shares the audio clock
    - clock: Master clock & tempo — locks to the beat
    - mod: 10 modulation inputs — LFO / XY / Macro can move them
  inputs:
    - lfo.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
    - lfo.hook.mod_depth (modulation · port mod.depth)
    - knob.shape (modulation · port mod.knob.shape)
    - knob.sync (modulation · port mod.knob.sync)
    - knob.div (modulation · port mod.knob.div)
    - knob.rate (modulation · port mod.knob.rate)
    - knob.offset (modulation · port mod.knob.offset)
    - knob.phase (modulation · port mod.knob.phase)
    - knob.polarity (modulation · port mod.knob.polarity)
    - knob.retrigger (modulation · port mod.knob.retrigger)
    - knob.fade (modulation · port mod.knob.fade)
  outputs:
    - lfo.hook.mod_out (modulation · port out)
  permissions: [audio_out, bus_publish, bus_subscribe, registry_read]
  works_with: []
