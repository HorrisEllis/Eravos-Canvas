{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos.xy-pad/packs/pack.schema.json",
  "title": "Packs for XY Pad — GENERATED by build/tool-kit.mjs from the tool's params (do not edit)",
  "description": "A pack.json in this folder is an eravos.pack/1 (schemas/pack.schema.json) whose items for this tool match the shape below.",
  "tool": "eravos.xy-pad",
  "properties": {
    "items": {
      "type": "object",
      "properties": {
        "eravos.xy-pad": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "smoothing": {
                        "type": "number",
                        "minimum": 0.001,
                        "maximum": 0.3
                      },
                      "curveX": {
                        "enum": [
                          "lin",
                          "exp",
                          "log"
                        ]
                      },
                      "curveY": {
                        "enum": [
                          "lin",
                          "exp",
                          "log"
                        ]
                      },
                      "minX": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "maxX": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "minY": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "maxY": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "invertX": {
                        "type": "boolean"
                      },
                      "invertY": {
                        "type": "boolean"
                      },
                      "loopBars": {
                        "enum": [
                          1,
                          2,
                          4,
                          8
                        ]
                      },
                      "snapBack": {
                        "type": "boolean"
                      },
                      "homeX": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "homeY": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "returnTime": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2
                      },
                      "inertia": {
                        "type": "boolean"
                      },
                      "friction": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "_react": {},
                      "tempoX": {
                        "enum": [
                          "¼",
                          "½",
                          "¾",
                          "1",
                          "1½",
                          "2",
                          "3",
                          "4",
                          "own"
                        ]
                      },
                      "tempoBpm": {
                        "type": "number",
                        "minimum": 30,
                        "maximum": 300
                      }
                    },
                    "additionalProperties": false
                  },
                  "extra": {
                    "type": "object"
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
