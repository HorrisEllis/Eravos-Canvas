# ============================================================
# ERAVOS ORGANISM SPEC — XY PAD (gesture performer)
# spec_id:      eravos.organism.xy-pad
# version:      2.0.0
# phase:        P5
# resolves:     F-10(xy)
# status:       canonical
# ============================================================

identity:
  id: eravos.xy-pad ; label: XY Pad ; icon: ✛ ; accent: "#00d4ff"
  comp_intent: >
    Perform two parameters at once by hand, then loop the gesture
    in time with the song — Kaoss-pad style.
  novelty: >
    Only organism that records human motion against song position
    and replays it bar-locked; two mod outputs from one surface.

engine:
  outputs: two ConstantSourceNodes → ports 'x' and 'y' (kind mod); value set with setTargetAtTime τ = smoothing
  mapping: per-axis curve (linear, exp, log) and range (min..max within −1..1), invert
  gesture loop:
    arm → record starts at next bar → captures {pos16 fractional, x, y} at 60 Hz for loopBars
    playback: on each transport:tick, schedule setValueAtTime for samples falling in [t, t + stepDur)
    overdub: touching the pad while looping overrides output; release returns to loop
  snap-back: release → glide to home (x0,y0) over returnTime (optional)
  physics: optional inertia (puck keeps moving, friction 0..1, bounces off walls)

config:
  smoothing 0.001..0.3 def 0.02 ; curveX/curveY enum [lin, exp, log] ; minX/maxX/minY/maxY −1..1 ; invertX/invertY
  loopBars enum [1,2,4,8] def 2 ; snapBack bool ; homeX/homeY 0..1 def 0.5 ; returnTime 0..2 s ; inertia bool ; friction 0..1 def 0.85

hooks:
  - xy.hook.mod_x:  out ; modulation ; port x ; 2.0.0
  - xy.hook.mod_y:  out ; modulation ; port y ; 2.0.0
  - xy.hook.transport_in STD.transport_in

ui:
  surface: square pad, puck, trail of last 1 s, recorded loop path drawn faint, playback puck distinct colour
  axis labels show wired target names (from wireRegistry)
  controls: ARM / PLAY / CLEAR loop, loop bars, snap-back, inertia, per-axis curve/range
  ui_hooks: [ui:xy_move {x, y}, ui:xy_release, ui:loop_arm, ui:loop_play, ui:loop_clear, standard_ui_hooks]

tests:
  - move to (1,0) → x port 1.0 (after 5·τ), y port 0
  - loop 2 bars recorded at bar 1 → replay at bar 3 matches ± 1 ms, ± 1e-3 value
  - overdub touch overrides; release returns to loop value
  - inertia: release with velocity → puck continues, stops within friction model bound

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo]   # ui expansion when added: Audio engine · Transport · Tempo
  services:
    - audio: Audio engine — shares the audio clock
    - clock: Master clock & tempo — locks to the beat
    - mod: 16 modulation inputs — LFO / XY / Macro can move them
  inputs:
    - xy.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
    - knob.smoothing (modulation · port mod.knob.smoothing)
    - knob.curveX (modulation · port mod.knob.curveX)
    - knob.curveY (modulation · port mod.knob.curveY)
    - knob.minX (modulation · port mod.knob.minX)
    - knob.maxX (modulation · port mod.knob.maxX)
    - knob.minY (modulation · port mod.knob.minY)
    - knob.maxY (modulation · port mod.knob.maxY)
    - knob.invertX (modulation · port mod.knob.invertX)
    - knob.invertY (modulation · port mod.knob.invertY)
    - knob.loopBars (modulation · port mod.knob.loopBars)
    - knob.snapBack (modulation · port mod.knob.snapBack)
    - knob.homeX (modulation · port mod.knob.homeX)
    - knob.homeY (modulation · port mod.knob.homeY)
    - knob.returnTime (modulation · port mod.knob.returnTime)
    - knob.inertia (modulation · port mod.knob.inertia)
    - knob.friction (modulation · port mod.knob.friction)
  outputs:
    - xy.hook.mod_x (modulation · port x)
    - xy.hook.mod_y (modulation · port y)
  permissions: [audio_out, bus_publish, bus_subscribe, registry_read]
  works_with: []
