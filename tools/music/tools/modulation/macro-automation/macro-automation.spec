# ============================================================
# ERAVOS ORGANISM SPEC — AUTOMATION LANE
# spec_id:      eravos.organism.macro-automation
# version:      2.0.0
# phase:        P5
# status:       canonical
# ============================================================

identity:
  id: eravos.macro-automation ; label: Automation ; icon: ⤴ ; accent: "#ffaa00"
  comp_intent: >
    Draw or record how a parameter changes across the song
    (filter opens over the build, reverb swells into the drop),
    locked to bars, replayed on every play.
  novelty: >
    Only organism with breakpoint curves over song position and a
    parameter browser across all mounted organisms (registry_read).

engine:
  lanes: up to 8 ; each {target instanceId, key, points:[{bar(float), value 0..1, curve −1..1}], enabled}
  output modes:
    audio-rate: if target declares mod port for key → modulation wire owned by kernel; lane drives ConstantSource with setValueCurveAtTime per bar segment
    event-rate: otherwise → ui:config_change:<target> {key, value(denormalized)} at ≤ 60 Hz while playing, only on change > 1e-3
  record: arm lane → captures ui:config_change:<target> for key against song position (transport:tick fractional), thinned by Ramer–Douglas–Peucker ε = 0.005
  read: on transport:tick schedule segment values for [t, t + stepDur)
  range: from target registry descriptor config[key] {min, max, step}; enum/boolean keys use step-hold interpolation
  length: follows timeline songBars if present, else lane length 1..512 bars

config:
  lengthBars 1..512 def 16 ; quantize enum [off, 1/16, 1/8, 1/4, 1 bar] def 1/16 ; mode enum [read, write, latch, off] def read

hooks:
  - auto.hook.drive_out: out ; event_bus ; ui:config_change (per-target topic) ; 1.0.0
  - auto.hook.mod_out:   out ; modulation ; port lane<n> (one per lane)
  - auto.hook.transport_in STD.transport_in
  - auto.hook.target_in: in ; ui:config_change:<target> (record)

ui:
  lane list with target picker: organism → parameter (grouped by config group, human labels)
  editor: bar grid, click add point, drag move, alt-drag curve tension, right-click delete, box select, copy/paste
  lane header: enable, mode, value readout, clear
  ui_hooks: [ui:lane_add {target, key}, ui:lane_remove, ui:point_edit {lane, op, point}, ui:lane_mode, standard_ui_hooks]

raises_faults: [RUNTIME_002 (target key unknown), MUTATION_001 (target unmounted → lane disabled, marked)]

tests:
  - ramp 0→1 over bars 1–5 on channel fader → value at bar 3 = 0.5 ± 0.01
  - event-rate mode emits ≤ 60 msgs/s and none when value static
  - record then read: RDP-thinned curve within ε of recorded values
  - target unmount → lane disabled, MUTATION_001 logged once

# ---- dependencies (generated by build/specs.mjs — do not edit by hand)
dependencies:
  mode: music   # Music Production
  toolbar_units: [music.engine, music.transport, music.tempo]   # ui expansion when added: Audio engine · Transport · Tempo
  services:
    - audio: Audio engine — shares the audio clock
    - clock: Master clock & tempo — locks to the beat
    - mod: 3 modulation inputs — LFO / XY / Macro can move them
  inputs:
    - auto.hook.transport_in (transport:tick|transport:play|transport:stop) — ambient broadcast
    - auto.hook.target_in (ui:config_change)
    - knob.lengthBars (modulation · port mod.knob.lengthBars)
    - knob.quantize (modulation · port mod.knob.quantize)
    - knob.mode (modulation · port mod.knob.mode)
  outputs:
    - auto.hook.drive_out (ui:config_change)
    - auto.hook.mod_lane0 (modulation · port lane0)
    - auto.hook.mod_lane1 (modulation · port lane1)
    - auto.hook.mod_lane2 (modulation · port lane2)
    - auto.hook.mod_lane3 (modulation · port lane3)
    - auto.hook.mod_lane4 (modulation · port lane4)
    - auto.hook.mod_lane5 (modulation · port lane5)
    - auto.hook.mod_lane6 (modulation · port lane6)
    - auto.hook.mod_lane7 (modulation · port lane7)
  permissions: [audio_out, bus_publish, bus_subscribe, registry_read]
  works_with: [eravos.bass-drop-builder, eravos.sequencer, eravos.midi-mapper]
