{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eravos/tool.schema.json",
  "title": "ERAVOS tool manifest (tool.json) — one per tool folder",
  "description": "Packaging + meta for one tool. The engine's define() stays the truth for params and ports; build/validate.mjs checks the two agree.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "label",
    "domain",
    "category",
    "summary",
    "files",
    "needs"
  ],
  "properties": {
    "schema": {
      "const": "eravos.tool/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$",
      "description": "domain-qualified id, e.g. eravos.pads or eravos.image.curves"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$"
    },
    "label": {
      "type": "string",
      "maxLength": 40
    },
    "icon": {
      "type": "string",
      "maxLength": 4
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "domain": {
      "type": "string",
      "description": "folder name under tools/"
    },
    "category": {
      "type": "string",
      "description": "folder name under tools/<domain>/tools/"
    },
    "summary": {
      "type": "string",
      "maxLength": 200,
      "description": "one sentence: what you can do with it"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "object",
      "required": [
        "engine"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "description": "<tool>.engine.js — define() + engine(ctx); runs headless"
        },
        "ui": {
          "type": "string",
          "description": "<tool>.ui.js — the window (optional: services and headless tools have none)"
        },
        "css": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "the tool's stylesheet(s), loaded before the engine"
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "more files loaded between engine and ui"
        },
        "preview": {
          "type": "string",
          "description": "preview.png — generated by build/shots.mjs, shown in the browsers"
        },
        "thumb": {
          "type": "string",
          "description": "thumb.png — the card picture in ＋ Add: the tool's main display, cropped 16:10 (build/tool-kit.mjs)"
        },
        "spec": {
          "type": "string",
          "description": "<tool>.spec — the behaviour contract"
        },
        "tests": {
          "type": "string",
          "description": "tests/<tool>.test.js"
        }
      },
      "additionalProperties": false
    },
    "needs": {
      "type": "object",
      "description": "what the tool cannot be without — the shell expands exactly this, nothing more",
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "toolbar/service units, e.g. music.engine, music.transport, music.dock"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "singleton tools it relies on, e.g. eravos.song-recorder (spawned if missing)"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "packs": {
      "type": "object",
      "description": "what content packs this tool accepts and which ship with it (packs/<id>/pack.json)",
      "properties": {
        "accepts": {
          "type": "array",
          "items": {
            "enum": [
              "presets",
              "kits",
              "patterns",
              "samples",
              "wavetables",
              "luts",
              "templates",
              "flows",
              "lessons"
            ]
          }
        },
        "shipped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "works_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "tools this one can be wired to (either direction) — GENERATED by build/tool-kit.mjs from both sides' ports"
    },
    "status": {
      "enum": [
        "mapped",
        "building",
        "built",
        "deprecated"
      ]
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "tools that must not be on the same canvas with this one (written by hand, with the reason in the spec)"
    },
    "hidden": {
      "type": "boolean",
      "description": "kept for songs and saved canvases that use it, but not offered in ＋ Add (3.64: EDM Lab all-in-one — the EDM Lab suite replaces it)"
    }
  },
  "additionalProperties": false
}
